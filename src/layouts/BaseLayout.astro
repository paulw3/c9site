---
import SEO from '../components/SEO.astro';
import SchemaOrg from '../components/SchemaOrg.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SmoothScroll from '../components/SmoothScroll.astro';
import { t, type Locale } from '../i18n/ui';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  locale?: Locale;
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, locale = 'en', schema } = Astro.props;
const dir = locale === 'ar' ? 'rtl' : 'ltr';

// Sitewide Organization node — every page carries it so crawlers and AI
// engines can resolve "C-9INE" to one stable entity (referenced by @id
// from any page-specific schema, e.g. a Product's provider).
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': 'https://c9ine.com/#organization',
  name: 'C-9INE',
  url: 'https://c9ine.com',
  logo: 'https://c9ine.com/favicon.svg',
  sameAs: ['https://www.linkedin.com/company/c-9ine/'],
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Sahaba Tissa (Cloud 9), 7586 King Fahad Road, Ar Rahmaniyah',
    addressLocality: 'Riyadh',
    postalCode: '12341',
    addressCountry: 'SA',
  },
};
---

<!doctype html>
<html lang={locale} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <SEO title={title} description={description} locale={locale} />
    <SchemaOrg data={schema ? [organizationSchema, ...(Array.isArray(schema) ? schema : [schema])] : organizationSchema} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Barlow Semi Condensed only — the sole house typeface per the
         brand guide's Font Pairing spec (Body: Regular, Headline: Bold) -->
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Barlow+Semi+Condensed:wght@400;500;600;700&display=swap"
    />
    {locale === 'ar' && (
      <!-- Barlow has no Arabic glyphs. IBM Plex Sans Arabic pairs with it as
           the closest match in tone (a clean, technical, geometric grotesque)
           while covering the script properly. Swapped in only for Arabic
           pages via the --font-display override in global.css. -->
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&display=swap"
      />
    )}
  </head>
  <body>
    <SmoothScroll />
    <a class="visually-hidden" href="#main">{t(locale, 'skipToContent')}</a>
    <Header locale={locale} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
    <script type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "ae78d97913374410b844abf8a5a7845e"}'></script>
  </body>
</html>
