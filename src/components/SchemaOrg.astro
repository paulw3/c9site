---
// Renders one or more schema.org JSON-LD blocks. Accepts a single node or
// an array — callers pass whatever page-specific schema applies (Product,
// FAQPage, etc.) on top of the Organization node BaseLayout always injects.
interface Props {
  data: Record<string, unknown> | Record<string, unknown>[];
}

const { data } = Astro.props;
const items = Array.isArray(data) ? data : [data];
---

{items.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
