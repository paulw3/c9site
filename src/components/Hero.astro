---
import { Image } from 'astro:assets';
import heroDesert from '../assets/hero-desert.jpg';

interface Props {
  heading: string;
  subheading: string;
  ctaText: string;
  ctaHref: string;
  trustText: string;
}

const { heading, subheading, ctaText, ctaHref, trustText } = Astro.props;
---

<!--
  The one deliberate motion moment on Home: at rest, the sky is a clean,
  clear blue — no clouds — over the sharp dunes, and the copy hasn't
  arrived yet. Scrolling in lets the real clouds (already in the photo)
  drift into that clear sky; after a brief pause once they've fully
  arrived, the copy follows. A quiet nod to "Cloud 9" in the company
  name. The image itself never moves — this is a normal section in the
  page's flow, not a pinned/sticky one, so scrolling feels completely
  ordinary except for the two things that are deliberately animated.
  Skipped entirely (full hero shown at once) for prefers-reduced-motion
  and for anyone without JS.
-->
<section class="hero">
  <Image
    src={heroDesert}
    alt="Aerial view of rippled sand dunes in the Saudi desert at golden hour, a small camel caravan crossing in the distance"
    class="hero__image"
    widths={[640, 1024, 1600, 2200]}
    sizes="100vw"
    format="avif"
    quality={82}
    priority
  />
  <div class="hero__clear-sky" aria-hidden="true"></div>
  <div class="hero__scrim" aria-hidden="true"></div>

  <div class="container hero__content">
    <h1 class="hero__reveal">{heading}</h1>
    <p class="lede hero__reveal hero__reveal--1">{subheading}</p>
  </div>

  <a href={ctaHref} class="hero__badge hero__reveal hero__reveal--2">
    <span>{ctaText}</span>
  </a>

  <p class="hero__trust mono-tag hero__reveal hero__reveal--3">{trustText}</p>
</section>

<style>
  .hero {
    position: relative;
    min-height: 88vh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Push the horizon down: zoom in a little and shift the frame down
       so more sky shows at top, dunes stay bright and uncropped at the
       bottom edge — no fade needed to hide it. */
    transform: scale(1.22) translateY(8%);
  }

  /* A clean, cloudless sky standing in for the photo's own sky until the
     user scrolls — colors matched to the photo's real sky gradient so
     the crossfade to the actual clouds is seamless, not a jump cut.
     Fully transparent well before the dune horizon, so it never
     softens the sand itself. */
  .hero__clear-sky {
    position: absolute;
    inset: 0;
    height: 62%;
    background: linear-gradient(
      to bottom,
      #2f4a63 0%,
      #4d6c87 30%,
      #8aa3b3 55%,
      transparent 82%
    );
    opacity: 0;
  }

  /* No dark fade at the bottom — dunes stay bright to the edge. Just
     enough of a top/left scrim for the nav and headline to sit on. */
  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(to bottom, color-mix(in srgb, var(--gunmetal) 80%, transparent) 0%, transparent 34%),
      linear-gradient(to right, color-mix(in srgb, var(--gunmetal) 72%, transparent) 0%, color-mix(in srgb, var(--gunmetal) 30%, transparent) 48%, transparent 68%);
  }

  /* Safe defaults: fully visible/settled. JS + motion-ok progressively
     hides these, then reveals them as the user scrolls (see below). */
  .hero__reveal {
    opacity: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .hero__clear-sky {
      opacity: 1;
    }

    :global(html.js) .hero__reveal {
      opacity: 0;
      transform: translateY(14px);
    }
  }

  .hero__content {
    position: relative;
    z-index: 2;
    padding-block: 6rem 8rem;
    max-width: 42rem;
  }

  .hero__content h1 {
    font-size: clamp(2.5rem, 1.6rem + 3.4vw, 4.25rem);
    max-width: 15ch;
  }

  .hero__content .lede {
    margin-block: 1.5rem 2.25rem;
    color: var(--white-smoke);
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.4);
  }

  .hero__badge {
    position: absolute;
    z-index: 2;
    right: clamp(1.5rem, 12vw, 14rem);
    bottom: clamp(6rem, 18vh, 10rem);
    width: 7.5rem;
    height: 7.5rem;
    border-radius: 50%;
    background: var(--aquamarine);
    color: var(--gunmetal);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    text-decoration: none;
    padding: 0.5rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step--1);
    line-height: 1.15;
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--aquamarine) 40%, transparent),
      0 0 50px 6px color-mix(in srgb, var(--aquamarine) 45%, transparent);
    transition: transform 200ms ease, box-shadow 200ms ease;
  }

  .hero__badge:hover {
    transform: scale(1.04);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--aquamarine) 55%, transparent),
      0 0 64px 10px color-mix(in srgb, var(--aquamarine) 60%, transparent);
  }

  .hero__trust {
    position: absolute;
    z-index: 2;
    left: 0;
    right: 0;
    bottom: 1.75rem;
    max-width: none;
    padding-inline: var(--gutter);
    text-align: center;
    color: var(--white-smoke);
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.55), 0 1px 12px rgba(0, 0, 0, 0.35);
  }

  @media (max-width: 860px) {
    .hero-pin-wrap {
      height: 160vh;
    }

    .hero {
      min-height: 100vh;
      align-items: flex-start;
    }

    .hero__content {
      padding-block: 7rem 4rem;
    }

    .hero__badge {
      width: 6rem;
      height: 6rem;
      right: 1.5rem;
      bottom: 5rem;
      font-size: var(--step--1);
    }
  }

</style>

<script>
  const prefersReduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const hero = document.querySelector<HTMLElement>('.hero');

  if (hero && !prefersReduced) {
    const clearSky = hero.querySelector<HTMLElement>('.hero__clear-sky');
    const revealEls = Array.from(hero.querySelectorAll<HTMLElement>('.hero__reveal'));

    // A normal section, not pinned — progress is just how far the hero
    // has scrolled past the top of the viewport, as a fraction of its
    // own height. Clouds drift in first (0 -> CLOUD_END), then a brief
    // pause with nothing changing, then the copy follows. The image
    // itself is never touched here — it doesn't move.
    const CLOUD_END = 0.42;
    const TEXT_START = 0.58;

    let ticking = false;

    const update = () => {
      const rect = hero.getBoundingClientRect();
      const progress = Math.min(Math.max(-rect.top / (rect.height * 0.65), 0), 1);

      const cloudT = Math.min(progress / CLOUD_END, 1);
      if (clearSky) clearSky.style.opacity = String(1 - cloudT);

      const textProgress = Math.min(Math.max((progress - TEXT_START) / (1 - TEXT_START), 0), 1);
      revealEls.forEach((el, i) => {
        const start = i * 0.12;
        const t = Math.min(Math.max((textProgress - start) / (1 - start), 0), 1);
        el.style.opacity = String(t);
        el.style.transform = `translateY(${(1 - t) * 14}px)`;
      });

      ticking = false;
    };

    update();
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          requestAnimationFrame(update);
          ticking = true;
        }
      },
      { passive: true }
    );
    window.addEventListener('resize', update);
  }
</script>
