---
import { Image } from 'astro:assets';
import heroDesert from '../assets/hero-desert.jpg';

interface Props {
  heading: string;
  subheading: string;
  ctaText: string;
  ctaHref: string;
  trustText: string;
}

const { heading, subheading, ctaText, ctaHref, trustText } = Astro.props;
---

<!--
  The one deliberate motion moment on Home: the image itself never
  moves. It's pinned in place (directly below the sticky nav — same
  top offset, so there's no collision/snap between the two) while the
  user scrolls through it. At rest, the sky is clean and clear — no
  clouds — and the copy hasn't arrived. Scrolling drifts the real
  clouds (already in the photo) into that sky; after a brief pause
  once they've fully arrived, the copy fades in. A quiet nod to
  "Cloud 9" in the company name. Skipped entirely (full hero shown at
  once, unpinned) for prefers-reduced-motion and for anyone without JS.
-->
<section class="hero-pin-wrap">
  <div class="hero">
    <Image
      src={heroDesert}
      alt="Aerial view of rippled sand dunes in the Saudi desert at golden hour, a small camel caravan crossing in the distance"
      class="hero__image"
      widths={[640, 1024, 1600, 2200]}
      sizes="100vw"
      format="avif"
      quality={82}
      priority
    />
    <div class="hero__clear-sky" aria-hidden="true"></div>
    <div class="hero__scrim" aria-hidden="true"></div>

    <div class="container hero__content">
      <h1 class="hero__reveal">{heading}</h1>
      <p class="lede hero__reveal hero__reveal--1">{subheading}</p>
    </div>

    <a href={ctaHref} class="hero__badge hero__reveal hero__reveal--2">
      <span>{ctaText}</span>
    </a>

    <p class="hero__trust mono-tag hero__reveal hero__reveal--3">{trustText}</p>
  </div>
</section>

<style>
  .hero-pin-wrap {
    position: relative;
    height: calc(170vh + var(--header-height));
  }

  /* Pinned at the same offset the header itself sticks at — top: 0 here
     would collide with the header (also sticky at top: 0) and snap the
     hero underneath it the instant scrolling starts. Sitting right
     below the header instead means the pinned position matches the
     hero's natural resting position, so there's nothing to snap to. */
  .hero {
    position: sticky;
    top: var(--header-height);
    min-height: calc(100vh - var(--header-height));
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Push the horizon down: zoom in a little and shift the frame down
       so more sky shows at top, dunes stay bright and uncropped at the
       bottom edge — no fade needed to hide it. Static — never animated. */
    transform: scale(1.22) translateY(8%);
  }

  /* A clean, cloudless sky standing in for the photo's own sky until the
     user scrolls — colors matched to the photo's real sky gradient so
     the crossfade to the actual clouds is seamless, not a jump cut.
     Fully transparent well before the dune horizon, so it never
     softens the sand itself. */
  .hero__clear-sky {
    position: absolute;
    inset: 0;
    height: 62%;
    background: linear-gradient(
      to bottom,
      #2f4a63 0%,
      #4d6c87 30%,
      #8aa3b3 55%,
      transparent 82%
    );
    opacity: 0;
  }

  /* No dark fade at the bottom — dunes stay bright to the edge. Just
     enough of a top/left scrim for the nav and headline to sit on. */
  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(to bottom, color-mix(in srgb, var(--gunmetal) 80%, transparent) 0%, transparent 34%),
      linear-gradient(to right, color-mix(in srgb, var(--gunmetal) 72%, transparent) 0%, color-mix(in srgb, var(--gunmetal) 30%, transparent) 48%, transparent 68%);
  }

  /* Safe defaults: fully visible/settled. JS + motion-ok progressively
     hides these, then reveals them as the user scrolls (see below). */
  .hero__reveal {
    opacity: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .hero__clear-sky {
      opacity: 1;
    }

    :global(html.js) .hero__reveal {
      opacity: 0;
      transform: translateY(14px);
    }
  }

  .hero__content {
    position: relative;
    z-index: 2;
    padding-block: 6rem 8rem;
    max-width: 42rem;
  }

  .hero__content h1 {
    font-size: clamp(2.5rem, 1.6rem + 3.4vw, 4.25rem);
    max-width: 15ch;
  }

  .hero__content .lede {
    margin-block: 1.5rem 2.25rem;
    color: var(--white-smoke);
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.4);
  }

  .hero__badge {
    position: absolute;
    z-index: 2;
    right: clamp(1.5rem, 12vw, 14rem);
    bottom: clamp(6rem, 18vh, 10rem);
    width: 7.5rem;
    height: 7.5rem;
    border-radius: 50%;
    background: var(--aquamarine);
    color: var(--gunmetal);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    text-decoration: none;
    padding: 0.5rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step--1);
    line-height: 1.15;
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--aquamarine) 40%, transparent),
      0 0 50px 6px color-mix(in srgb, var(--aquamarine) 45%, transparent);
    transition: transform 200ms ease, box-shadow 200ms ease;
  }

  .hero__badge:hover {
    transform: scale(1.04);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--aquamarine) 55%, transparent),
      0 0 64px 10px color-mix(in srgb, var(--aquamarine) 60%, transparent);
  }

  .hero__trust {
    position: absolute;
    z-index: 2;
    left: 0;
    right: 0;
    bottom: 1.75rem;
    max-width: none;
    padding-inline: var(--gutter);
    text-align: center;
    color: var(--white-smoke);
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.55), 0 1px 12px rgba(0, 0, 0, 0.35);
  }

  @media (max-width: 860px) {
    .hero-pin-wrap {
      height: calc(150vh + var(--header-height));
    }

    .hero__content {
      padding-block: 7rem 4rem;
    }

    .hero__badge {
      width: 6rem;
      height: 6rem;
      right: 1.5rem;
      bottom: 5rem;
      font-size: var(--step--1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-pin-wrap {
      height: auto;
    }

    .hero {
      position: relative;
    }
  }
</style>

<script>
  const prefersReduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const wrap = document.querySelector<HTMLElement>('.hero-pin-wrap');

  if (wrap && !prefersReduced) {
    const clearSky = wrap.querySelector<HTMLElement>('.hero__clear-sky');
    const revealEls = Array.from(wrap.querySelectorAll<HTMLElement>('.hero__reveal'));
    const header = document.querySelector<HTMLElement>('.site-header');

    // Clouds drift in first (0 -> CLOUD_END), then a brief pause with
    // nothing changing, then the copy follows (TEXT_START -> 1). The
    // image is static CSS only — nothing here ever touches it.
    const CLOUD_END = 0.42;
    const TEXT_START = 0.58;

    let ticking = false;

    const update = () => {
      const rect = wrap.getBoundingClientRect();
      const scrollable = wrap.offsetHeight - window.innerHeight;
      const progress = scrollable > 0 ? Math.min(Math.max(-rect.top / scrollable, 0), 1) : 1;

      // The header stays transparent for exactly as long as the hero
      // photo is still pinned directly behind it — i.e. the whole
      // scroll range up until the hero releases and normal content
      // takes its place underneath the nav.
      if (header) header.classList.toggle('is-transparent', progress < 1);

      const cloudT = Math.min(progress / CLOUD_END, 1);
      if (clearSky) clearSky.style.opacity = String(1 - cloudT);

      const textProgress = Math.min(Math.max((progress - TEXT_START) / (1 - TEXT_START), 0), 1);
      revealEls.forEach((el, i) => {
        const start = i * 0.12;
        const t = Math.min(Math.max((textProgress - start) / (1 - start), 0), 1);
        el.style.opacity = String(t);
        el.style.transform = `translateY(${(1 - t) * 14}px)`;
      });

      ticking = false;
    };

    update();
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          requestAnimationFrame(update);
          ticking = true;
        }
      },
      { passive: true }
    );
    window.addEventListener('resize', update);
  }
</script>
