---
interface Props {
  heading: string;
  subheading: string;
  trustText: string;
}

const { heading, subheading, trustText } = Astro.props;

// trustText arrives as one sentence ("Google Cloud Premier Partner, based
// in Riyadh, Saudi Arabia") but the design needs it in two places: the
// short first clause as the eyebrow above the headline, and the whole
// thing as a two-line strip in the corner — so it's split once here
// rather than asking every caller to pass both forms separately.
const [eyebrow, ...rest] = trustText.split(', ');
const trustRest = rest.join(', ');
---

<!--
  No photo, no scroll mechanic — the previous dune-photo hero (with its
  scroll-pinned cloud reveal) is replaced by a pure typography-and-
  whitespace treatment, approved by the client after comparing it
  directly against photo and brand-mark-watermark alternatives. The
  headline's own scale does the work a hero image used to do.
-->
<section class="hero">
  <div class="container">
    <p class="hero__eyebrow hero__reveal">{eyebrow}</p>
    <h1 class="hero__reveal hero__reveal--1">{heading}</h1>
    <p class="hero__sub hero__reveal hero__reveal--2">{subheading}</p>
    <div class="hero__row hero__reveal hero__reveal--3">
      <a class="btn btn-primary" href="/contact">Talk to us</a>
      <p class="hero__trust">{eyebrow}<br />{trustRest}</p>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(4rem, 11vw, 8rem) clamp(3rem, 8vw, 6rem);
  }

  .hero__eyebrow {
    display: inline-block;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step--1);
    color: var(--vivid-sky-blue);
    letter-spacing: 0.02em;
    padding-bottom: 0.85rem;
    border-bottom: 2px solid var(--aquamarine);
    max-width: none;
  }

  .hero h1 {
    margin: 2rem 0 0;
    /* Capped below the type scale's own --step-5 ceiling: at full
       scale even short phrases can't fit one line within the page's
       own width, forcing an ungainly four-line wrap. This keeps the
       headline dramatically large while still breaking into three
       confident lines instead of four disjointed ones. */
    font-size: clamp(3.2rem, 2rem + 6vw, 6.5rem);
    line-height: 0.98;
    letter-spacing: -0.01em;
    max-width: 24ch;
  }

  .hero__sub {
    margin-top: 2.5rem;
    font-size: clamp(1.15rem, 1rem + 0.6vw, 1.4rem);
    line-height: 1.5;
    color: var(--silver);
    max-width: 38ch;
  }

  .hero__row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
    margin-top: 3.5rem;
  }

  .hero__trust {
    font-family: var(--font-display);
    font-size: var(--step--1);
    color: var(--silver);
    text-align: right;
    max-width: none;
  }

  /* One quiet load-in, not scroll-jacking — the whole block settles
     into place a beat after the page appears. Respects reduced-motion
     by simply staying at its resting state (no JS needed either way,
     since this is a CSS-only entrance, unlike the old scroll-driven
     hero). */
  .hero__reveal {
    opacity: 0;
    transform: translateY(14px);
    animation: hero-reveal 700ms ease forwards;
  }
  .hero__reveal--1 { animation-delay: 90ms; }
  .hero__reveal--2 { animation-delay: 180ms; }
  .hero__reveal--3 { animation-delay: 270ms; }

  @keyframes hero-reveal {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__reveal {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }

  @media (max-width: 700px) {
    .hero__row {
      flex-direction: column;
      align-items: flex-start;
    }

    .hero__trust {
      text-align: left;
    }
  }
</style>
