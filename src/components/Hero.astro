---
import { Image } from 'astro:assets';
import heroDesert from '../assets/hero-desert.jpg';

interface Props {
  heading: string;
  subheading: string;
  ctaText: string;
  ctaHref: string;
  trustText: string;
}

const { heading, subheading, ctaText, ctaHref, trustText } = Astro.props;
---

<!--
  The one deliberate motion moment on Home: at rest, the sky is a clean,
  clear blue — no clouds — over the sharp dunes, and the copy hasn't
  arrived yet. Scrolling in lets the real clouds (already in the photo)
  drift into that clear sky, then brings the copy in after them. A
  quiet nod to "Cloud 9" in the company name. Skipped entirely (full
  hero shown at once) for prefers-reduced-motion and for anyone
  without JS.
-->
<section class="hero-pin-wrap">
  <div class="hero">
    <div class="hero__image-stack">
      <Image
        src={heroDesert}
        alt="Aerial view of rippled sand dunes in the Saudi desert at golden hour, a small camel caravan crossing in the distance"
        class="hero__image"
        widths={[640, 1024, 1600, 2200]}
        sizes="100vw"
        format="avif"
        quality={82}
        priority
      />
      <div class="hero__clear-sky" aria-hidden="true"></div>
    </div>
    <div class="hero__scrim" aria-hidden="true"></div>

    <div class="container hero__content">
      <h1 class="hero__reveal">{heading}</h1>
      <p class="lede hero__reveal hero__reveal--1">{subheading}</p>
    </div>

    <a href={ctaHref} class="hero__badge hero__reveal hero__reveal--2">
      <span>{ctaText}</span>
    </a>

    <p class="hero__trust mono-tag hero__reveal hero__reveal--3">{trustText}</p>
  </div>
</section>

<style>
  .hero-pin-wrap {
    position: relative;
    height: 180vh;
  }

  .hero {
    position: sticky;
    top: 0;
    min-height: 88vh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero__image-stack {
    position: absolute;
    inset: 0;
    z-index: 0;
    will-change: transform;
  }

  .hero__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.1);
  }

  /* A clean, cloudless sky standing in for the photo's own sky until the
     user scrolls — colors matched to the photo's real sky gradient so
     the crossfade to the actual clouds is seamless, not a jump cut. */
  .hero__clear-sky {
    position: absolute;
    inset: 0;
    height: 60%;
    background: linear-gradient(
      to bottom,
      #2f4a63 0%,
      #4d6c87 30%,
      #8aa3b3 58%,
      #c7cdc6 82%,
      transparent 100%
    );
    opacity: 0;
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(to bottom, color-mix(in srgb, var(--gunmetal) 80%, transparent) 0%, transparent 34%, transparent 60%, var(--gunmetal) 100%),
      linear-gradient(to right, color-mix(in srgb, var(--gunmetal) 72%, transparent) 0%, color-mix(in srgb, var(--gunmetal) 30%, transparent) 48%, transparent 68%);
  }

  /* Safe defaults: fully visible/settled. JS + motion-ok progressively
     hides these, then reveals them as the user scrolls (see below). */
  .hero__reveal {
    opacity: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .hero__clear-sky {
      opacity: 1;
    }

    :global(html.js) .hero__reveal {
      opacity: 0;
      transform: translateY(14px);
    }
  }

  .hero__content {
    position: relative;
    z-index: 2;
    padding-block: 6rem 8rem;
    max-width: 42rem;
  }

  .hero__content h1 {
    font-size: clamp(2.5rem, 1.6rem + 3.4vw, 4.25rem);
    max-width: 15ch;
  }

  .hero__content .lede {
    margin-block: 1.5rem 2.25rem;
    color: var(--white-smoke);
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.4);
  }

  .hero__badge {
    position: absolute;
    z-index: 2;
    right: clamp(1.5rem, 12vw, 14rem);
    bottom: clamp(6rem, 18vh, 10rem);
    width: 7.5rem;
    height: 7.5rem;
    border-radius: 50%;
    background: var(--aquamarine);
    color: var(--gunmetal);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    text-decoration: none;
    padding: 0.5rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step--1);
    line-height: 1.15;
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--aquamarine) 40%, transparent),
      0 0 50px 6px color-mix(in srgb, var(--aquamarine) 45%, transparent);
    transition: transform 200ms ease, box-shadow 200ms ease;
  }

  .hero__badge:hover {
    transform: scale(1.04);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--aquamarine) 55%, transparent),
      0 0 64px 10px color-mix(in srgb, var(--aquamarine) 60%, transparent);
  }

  .hero__trust {
    position: absolute;
    z-index: 2;
    left: 0;
    right: 0;
    bottom: 1.75rem;
    max-width: none;
    padding-inline: var(--gutter);
    text-align: center;
    color: var(--white-smoke);
  }

  @media (max-width: 860px) {
    .hero-pin-wrap {
      height: 160vh;
    }

    .hero {
      min-height: 100vh;
      align-items: flex-start;
    }

    .hero__content {
      padding-block: 7rem 4rem;
    }

    .hero__badge {
      width: 6rem;
      height: 6rem;
      right: 1.5rem;
      bottom: 5rem;
      font-size: var(--step--1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-pin-wrap {
      height: auto;
    }

    .hero {
      position: relative;
    }
  }
</style>

<script>
  const prefersReduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const wrap = document.querySelector<HTMLElement>('.hero-pin-wrap');

  if (wrap && !prefersReduced) {
    const clearSky = wrap.querySelector<HTMLElement>('.hero__clear-sky');
    const imageStack = wrap.querySelector<HTMLElement>('.hero__image-stack');
    const revealEls = Array.from(wrap.querySelectorAll<HTMLElement>('.hero__reveal'));

    let ticking = false;

    const update = () => {
      const rect = wrap.getBoundingClientRect();
      const scrollable = wrap.offsetHeight - window.innerHeight;
      const progress = scrollable > 0 ? Math.min(Math.max(-rect.top / scrollable, 0), 1) : 1;

      // Clouds drift into the clear sky across the first half of the scroll.
      const cloudT = Math.min(progress / 0.5, 1);
      if (clearSky) clearSky.style.opacity = String(1 - cloudT);
      if (imageStack) imageStack.style.transform = `translateY(${progress * 24}px)`;

      // Copy rises in afterward, each element staggered slightly.
      revealEls.forEach((el, i) => {
        const start = 0.32 + i * 0.06;
        const t = Math.min(Math.max((progress - start) / (1 - start), 0), 1);
        el.style.opacity = String(t);
        el.style.transform = `translateY(${(1 - t) * 14}px)`;
      });

      ticking = false;
    };

    update();
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          requestAnimationFrame(update);
          ticking = true;
        }
      },
      { passive: true }
    );
    window.addEventListener('resize', update);
  }
</script>
