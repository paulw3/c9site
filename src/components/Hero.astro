---
import { t, type Locale } from '../i18n/ui';

interface Props {
  heading: string;
  subheading: string;
  trustText: string;
  locale?: Locale;
}

const { heading, subheading, trustText, locale = 'en' } = Astro.props;

// trustText arrives as one sentence ("Google Cloud Preferred Partner, based
// in Riyadh, Saudi Arabia") but the design needs it in two places: the
// short first clause as the eyebrow above the headline, and the whole
// thing as a two-line strip in the corner — so it's split once here
// rather than asking every caller to pass both forms separately.
const [eyebrow] = trustText.split(', ');
---

<!--
  No photo, no scroll mechanic — the previous dune-photo hero (with its
  scroll-pinned cloud reveal) is replaced by a pure typography-and-
  whitespace treatment, approved by the client after comparing it
  directly against photo and brand-mark-watermark alternatives. The
  headline's own scale does the work a hero image used to do.
-->
<section class="hero">
  <div class="container">
    <p class="hero__eyebrow hero__reveal">{eyebrow}</p>
    <h1 class="hero__reveal hero__reveal--1">{heading}</h1>
    <p class="hero__sub hero__reveal hero__reveal--2">{subheading}</p>
    <div class="hero__row hero__reveal hero__reveal--3">
      <a class="btn btn-primary" href={locale === 'ar' ? '/ar/contact' : '/contact'}>{t(locale, 'talkToUs')}</a>
      <p class="hero__trust">{t(locale, 'heroTrustLine')}</p>
    </div>
  </div>
</section>

<style>
  /* Previously scaled almost purely off viewport WIDTH (vw), which
     grows unbounded on wide monitors regardless of viewport HEIGHT —
     on a wide-but-not-tall screen the whole block (down through the
     button) no longer fit above the fold on first load. Same 4-line
     headline (max-width:17ch produces the same wrap at any font-size,
     since ch scales with it), just a smaller, less width-hungry scale
     with tighter spacing throughout so the button stays in view. */
  .hero {
    padding-block: clamp(2.5rem, 5vw, 4rem) clamp(1.5rem, 3vw, 2.5rem);
  }

  .hero__eyebrow {
    display: inline-block;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step--1);
    color: var(--vivid-sky-blue);
    letter-spacing: 0.02em;
    max-width: none;
  }

  .hero h1 {
    margin: 1.25rem 0 0;
    font-size: clamp(2.6rem, 1.6rem + 3.5vw, 5.6rem);
    line-height: 0.98;
    letter-spacing: -0.01em;
    max-width: 17ch;
  }

  .hero__sub {
    margin-top: 1.5rem;
    font-size: clamp(1.1rem, 1rem + 0.4vw, 1.3rem);
    line-height: 1.5;
    color: var(--silver);
    max-width: 38ch;
  }

  .hero__row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
    margin-top: 2rem;
  }

  .hero__trust {
    font-family: var(--font-display);
    font-size: var(--step--1);
    color: var(--silver);
    text-align: end;
    max-width: none;
  }

  /* One quiet load-in, not scroll-jacking — the whole block settles
     into place a beat after the page appears. Respects reduced-motion
     by simply staying at its resting state (no JS needed either way,
     since this is a CSS-only entrance, unlike the old scroll-driven
     hero). */
  .hero__reveal {
    opacity: 0;
    transform: translateY(14px);
    animation: hero-reveal 700ms ease forwards;
  }
  .hero__reveal--1 { animation-delay: 90ms; }
  .hero__reveal--2 { animation-delay: 180ms; }
  .hero__reveal--3 { animation-delay: 270ms; }

  @keyframes hero-reveal {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__reveal {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }

  @media (max-width: 700px) {
    .hero__row {
      flex-direction: column;
      align-items: flex-start;
    }

    .hero__trust {
      text-align: start;
    }
  }

  /* Scoped styles here would otherwise out-specificity the global RTL
     letter-spacing reset in global.css. */
  :global([dir='rtl']) .hero__eyebrow,
  :global([dir='rtl']) .hero h1 {
    letter-spacing: normal;
  }
</style>
