---
import { Image } from 'astro:assets';
import heroDesert from '../assets/hero-desert.jpg';

interface Props {
  heading: string;
  subheading: string;
  trustText: string;
}

const { heading, subheading, trustText } = Astro.props;
---

<!--
  The one deliberate motion moment on Home: the image itself never
  moves. It's pinned in place (directly below the sticky nav — same
  top offset, so there's no collision/snap between the two) while the
  user scrolls through it. At rest, the sky is clean and clear — no
  clouds — and the copy hasn't arrived. Scrolling drifts the real
  clouds (already in the photo) into that sky; after a brief pause
  once they've fully arrived, the copy fades in. A quiet nod to
  "Cloud 9" in the company name. Skipped entirely (full hero shown at
  once, unpinned) for prefers-reduced-motion and for anyone without JS.
-->
<section class="hero-pin-wrap">
  <div class="hero">
    <Image
      src={heroDesert}
      alt="Aerial view of rippled sand dunes in the Saudi desert at golden hour, a small camel caravan crossing in the distance"
      class="hero__image"
      widths={[640, 1024, 1600, 2200]}
      sizes="100vw"
      format="avif"
      quality={82}
      priority
    />
    <div class="hero__clear-sky" aria-hidden="true"></div>
    <div class="hero__scrim" aria-hidden="true"></div>

    <div class="container hero__content">
      <h1 class="hero__reveal">{heading}</h1>
      <p class="lede hero__reveal hero__reveal--1">{subheading}</p>
    </div>

    <p class="hero__trust mono-tag hero__reveal hero__reveal--3">{trustText}</p>

    <button type="button" class="hero__scroll-cue" aria-label="Scroll down">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M12 5v13M6 12l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>
  </div>
</section>

<style>
  /* Pulled up by the header's own height so the wrap (and the hero
     inside it) starts at the very top of the page, extending full-bleed
     underneath the transparent header — not pushed down below it. The
     header still reserves its normal layout space elsewhere; this just
     lets the photo visually underlap it here on Home.

     Height sets the total scroll-scrubbed distance behind the pin: the
     script's CLOUD_END/TEXT_START fractions carve that distance up, so
     a taller wrap means more scrolling — i.e. a longer duration — for
     every phase, clouds and text alike, without touching the script. */
  .hero-pin-wrap {
    position: relative;
    height: 240vh;
    margin-top: calc(-1 * var(--header-height));
  }

  /* Pinned at top: 0 — and since the wrap above already starts at
     document y: 0 (via the negative margin), the hero's natural resting
     position IS the pinned position from the very first frame. Nothing
     to transition between, so there's nothing to snap. */
  .hero {
    position: sticky;
    top: 0;
    /* 100vh is taller than what's actually visible on mobile before the
       browser's own address-bar chrome collapses — anything positioned
       from the hero's bottom edge (the scroll cue, the trust strip) sits
       below that chrome and off-screen at rest. 100svh accounts for it;
       plain vh stays as the fallback for browsers that don't support svh. */
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Push the horizon down: zoom in a little and shift the frame down
       so more sky shows at top, dunes stay bright and uncropped at the
       bottom edge — no fade needed to hide it. Static — never animated. */
    transform: scale(1.22) translateY(8%);
  }

  /* A clean, cloudless sky standing in for the photo's own sky until the
     user scrolls — colors matched to the photo's real sky gradient so
     the crossfade to the actual clouds is seamless, not a jump cut.
     Fully transparent well before the dune horizon, so it never
     softens the sand itself. */
  .hero__clear-sky {
    position: absolute;
    inset: 0;
    height: 62%;
    background: linear-gradient(
      to bottom,
      #2f4a63 0%,
      #4d6c87 30%,
      #8aa3b3 55%,
      transparent 82%
    );
    opacity: 0;
  }

  /* No dark fade at the top or bottom — the sky and dunes stay their
     true color, so the transparent nav actually reads as transparent
     instead of sitting on a hidden dark bar. Just a soft left-side
     wash behind the headline column for contrast; text itself also
     carries its own shadow (see below) as the real legibility guard. */
  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(to right, color-mix(in srgb, var(--gunmetal) 42%, transparent) 0%, color-mix(in srgb, var(--gunmetal) 18%, transparent) 40%, transparent 62%);
  }

  /* Safe defaults: fully visible/settled. JS + motion-ok progressively
     hides these, then reveals them as the user scrolls (see below). */
  .hero__reveal {
    opacity: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .hero__clear-sky {
      opacity: 1;
    }

    :global(html.js) .hero__reveal {
      opacity: 0;
      transform: translateY(14px);
    }
  }

  .hero__content {
    position: relative;
    z-index: 2;
    padding-block: 6rem 8rem;
    max-width: 42rem;
  }

  .hero__content h1 {
    font-size: clamp(2.5rem, 1.6rem + 3.4vw, 4.25rem);
    max-width: 15ch;
  }

  .hero__content .lede {
    margin-block: 1.5rem 2.25rem;
    color: var(--white-smoke);
  }

  .hero__trust {
    position: absolute;
    z-index: 2;
    left: 0;
    right: 0;
    bottom: 1.75rem;
    max-width: none;
    padding-inline: var(--gutter);
    text-align: center;
    color: var(--white-smoke);
  }

  /* A down-pointing cue, not up: it signals the direction to scroll,
     not "return to top" (that's a different, unrelated affordance for
     later in a page). Sits above the trust strip so the two never
     collide; fades out once the user actually starts scrolling, via
     the script below. */
  .hero__scroll-cue {
    position: absolute;
    z-index: 2;
    left: 50%;
    bottom: 4.75rem;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: none;
    background: none;
    color: var(--white-smoke);
    cursor: pointer;
    opacity: 0.85;
    transition: opacity 200ms ease;
  }

  .hero__scroll-cue:hover {
    opacity: 1;
    color: var(--aquamarine);
  }

  .hero__scroll-cue svg {
    width: 1.5rem;
    height: 1.5rem;
    filter: drop-shadow(0 1px 3px rgba(0, 0, 0, 0.4));
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__scroll-cue svg {
      animation: hero-scroll-cue-bounce 2.2s ease-in-out infinite;
    }
  }

  @keyframes hero-scroll-cue-bounce {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(6px);
    }
  }

  @media (max-width: 860px) {
    .hero-pin-wrap {
      height: 200vh;
    }

    .hero__content {
      padding-block: 7rem 4rem;
    }

    /* The photo is a wide 1.79:1 landscape with its two big cloud
       formations sitting in the left and right-center thirds, and a
       nearly cloud-free gap dead in the middle. object-fit: cover on
       a narrow tall screen only shows a thin vertical strip centered
       on the image — which lands right in that gap, so the clouds
       never appear. Shift the crop right to frame the right-hand
       cluster (which also happens to be where the camel caravan
       sits) instead, and ease off the desktop zoom, which was tuned
       for a much wider crop and needlessly trims the cluster here. */
    .hero__image {
      object-position: 62% center;
      transform: scale(1.05) translateY(2%);
    }

    .hero__scroll-cue {
      bottom: calc(7.5rem + env(safe-area-inset-bottom, 0px));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    /* No pinning, no underlap trick — the header stays solid (the
       transparency script never runs), so the wrap needs its normal
       document space back, not pulled up under a now-opaque header. */
    .hero-pin-wrap {
      height: auto;
      margin-top: 0;
    }

    .hero {
      position: relative;
      min-height: calc(100vh - var(--header-height));
    }
  }
</style>

<script>
  const prefersReduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const wrap = document.querySelector<HTMLElement>('.hero-pin-wrap');

  const scrollCue = wrap?.querySelector<HTMLButtonElement>('.hero__scroll-cue');
  scrollCue?.addEventListener('click', () => {
    window.scrollBy({
      top: window.innerHeight * 0.9,
      behavior: prefersReduced ? 'auto' : 'smooth',
    });
  });

  if (wrap && !prefersReduced) {
    const clearSky = wrap.querySelector<HTMLElement>('.hero__clear-sky');
    const revealEls = Array.from(wrap.querySelectorAll<HTMLElement>('.hero__reveal'));
    const header = document.querySelector<HTMLElement>('.site-header');

    // Clouds drift in first (0 -> CLOUD_END), then a brief pause with
    // nothing changing, then the copy follows (TEXT_START -> 1). The
    // image is static CSS only — nothing here ever touches it.
    const CLOUD_END = 0.42;
    const TEXT_START = 0.58;

    let ticking = false;

    const update = () => {
      const rect = wrap.getBoundingClientRect();
      const scrollable = wrap.offsetHeight - window.innerHeight;
      const progress = scrollable > 0 ? Math.min(Math.max(-rect.top / scrollable, 0), 1) : 1;

      // The header stays transparent for as long as the photo itself is
      // still visible behind it — not just while the hero is pinned.
      // Once the pin releases, the (now-unpinned) hero keeps scrolling
      // normally for another full viewport height before it's fully
      // gone, and the photo should keep showing through the header for
      // all of that too. So track the wrap's actual bottom edge rather
      // than the pin progress: transparent until the photo's bottom
      // edge has scrolled up past the header's own height.
      if (header) {
        const wrapBottom = rect.top + wrap.offsetHeight;
        header.classList.toggle('is-transparent', wrapBottom > header.offsetHeight);
      }

      const cloudT = Math.min(progress / CLOUD_END, 1);
      if (clearSky) clearSky.style.opacity = String(1 - cloudT);

      const textProgress = Math.min(Math.max((progress - TEXT_START) / (1 - TEXT_START), 0), 1);

      // The copy fades back out quickly once the hero releases and
      // starts scrolling normally — it would otherwise keep travelling
      // upward with the image and collide with the (still-transparent)
      // header's own nav text. The image itself has nothing to fade:
      // it keeps showing cleanly through the header for the rest of its
      // scroll-away, per the wrapBottom check above.
      const pastRelease = Math.max(-rect.top - scrollable, 0);
      const releaseFadeRange = window.innerHeight * 0.25;
      const releaseFade = 1 - Math.min(pastRelease / releaseFadeRange, 1);

      revealEls.forEach((el, i) => {
        const start = i * 0.12;
        const t = Math.min(Math.max((textProgress - start) / (1 - start), 0), 1) * releaseFade;
        el.style.opacity = String(t);
        el.style.transform = `translateY(${(1 - t) * 14}px)`;
      });

      // The cue's job is done as soon as the visitor proves they know
      // how to scroll — fade it out over a short distance rather than
      // leaving it competing with the rest of the hero for the whole
      // (much longer) pin duration.
      if (scrollCue) {
        const cueFade = 1 - Math.min(window.scrollY / (window.innerHeight * 0.2), 1);
        scrollCue.style.opacity = String(cueFade * 0.85);
        scrollCue.style.pointerEvents = cueFade > 0.05 ? 'auto' : 'none';
      }

      ticking = false;
    };

    update();
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          requestAnimationFrame(update);
          ticking = true;
        }
      },
      { passive: true }
    );
    window.addEventListener('resize', update);
  }
</script>
