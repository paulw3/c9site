---
import { t, type Locale } from '../i18n/ui';

interface Props {
  defaultIntent?: 'gdc-pilot';
  locale?: Locale;
}

const { defaultIntent, locale = 'en' } = Astro.props;
---

<!-- TODO: wire a submission endpoint (e.g. a Cloudflare Worker or Formspree) —
     the brief doesn't specify one, so this posts nowhere yet. The two submit
     buttons share the form but carry different `intent` values so a future
     backend/analytics setup can tell general enquiries from GDC pilot
     requests apart, per the brief's "tracked separately" requirement. -->
<form class="contact-form" method="POST" action="#">
  <div class="contact-form__row">
    <label for="name">{t(locale, 'formName')}</label>
    <input type="text" id="name" name="name" required autocomplete="name" />
  </div>

  <div class="contact-form__row">
    <label for="email">{t(locale, 'formEmail')}</label>
    <input type="email" id="email" name="email" required autocomplete="email" />
  </div>

  <div class="contact-form__row">
    <label for="company">{t(locale, 'formCompany')}</label>
    <input type="text" id="company" name="company" autocomplete="organization" />
  </div>

  <div class="contact-form__row">
    <label for="looking-for">{t(locale, 'formLookingFor')}</label>
    <select id="looking-for" name="looking-for">
      <option value="cloud-migration" selected={defaultIntent !== 'gdc-pilot'}>
        {t(locale, 'formLookingForMigration')}
      </option>
      <option value="gdc-pilot" selected={defaultIntent === 'gdc-pilot'}>
        {t(locale, 'formLookingForGdc')}
      </option>
      <option value="not-sure">{t(locale, 'formLookingForUnsure')}</option>
    </select>
  </div>

  <div class="contact-form__row">
    <label for="message">{t(locale, 'formMessage')}</label>
    <textarea id="message" name="message" rows="5"></textarea>
  </div>

  <div class="contact-form__actions">
    <button type="submit" name="intent" value="general" class="btn btn-primary">{t(locale, 'formSend')}</button>
    <button type="submit" name="intent" value="gdc-pilot" class="btn btn-outline">
      {t(locale, 'formBookPilot')}
    </button>
  </div>
</form>

<style>
  .contact-form {
    display: grid;
    gap: 1.5rem;
    max-width: 34rem;
  }

  .contact-form__row {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  label {
    font-size: var(--step--1);
    color: var(--silver);
  }

  input,
  select,
  textarea {
    font: inherit;
    font-size: var(--step-0);
    color: var(--white-smoke);
    background: var(--gunmetal-raised);
    border: 1px solid var(--gunmetal-line);
    border-radius: var(--border-radius);
    padding: 0.75em 0.9em;
  }

  input:focus-visible,
  select:focus-visible,
  textarea:focus-visible {
    border-color: var(--aquamarine);
  }

  textarea {
    resize: vertical;
  }

  .contact-form__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 0.5rem;
  }
</style>
