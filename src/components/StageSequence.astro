---
// The one deliberate motion set-piece on the two pillar pages (see
// docs/content-brief.md's Design → Engineer → Run narrative). A
// horizontal scroll-snap carousel rather than page-scroll-driven
// scrollytelling: tabs and prev/next controls move between stages,
// and dragging/swiping the panel strip does the same — the page's own
// vertical scroll is left alone.
import StageIcon from './StageIcon.astro';

interface Props {
  stages: string[];
}

const { stages } = Astro.props;
const iconFor = (label: string) => label.toLowerCase() as 'design' | 'engineer' | 'run';
---

<section class="stage-sequence" data-stage-sequence>
  <div class="stage-tabs">
    {stages.map((label, i) => (
      <button
        type="button"
        class="stage-tabs__tab"
        data-index={i}
        aria-current={i === 0 ? 'true' : undefined}
        aria-label={`Jump to ${label}`}
      >
        <StageIcon stage={iconFor(label)} />
        <span>{label}</span>
      </button>
    ))}
  </div>

  <div class="stage-panels" tabindex="0" aria-label="Stage details, scroll horizontally">
    <slot />
  </div>

  <div class="stage-nav">
    <button type="button" class="stage-nav__btn" data-dir="-1" aria-label="Previous stage">
      <svg viewBox="0 0 24 24" focusable="false"><path d="M15,5 L8,12 L15,19" /></svg>
    </button>
    <p class="stage-nav__progress mono-tag"><span data-progress>033</span>%</p>
    <button type="button" class="stage-nav__btn" data-dir="1" aria-label="Next stage">
      <svg viewBox="0 0 24 24" focusable="false"><path d="M9,5 L16,12 L9,19" /></svg>
    </button>
  </div>
</section>

<style>
  .stage-sequence {
    display: flex;
    flex-direction: column;
    gap: clamp(1.5rem, 4vw, 2.5rem);
  }

  .stage-tabs {
    display: flex;
    gap: clamp(1.25rem, 4vw, 3rem);
    border-bottom: 1px solid var(--gunmetal-line);
  }

  .stage-tabs__tab {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding-block: 0.85rem;
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    font-family: var(--font-display);
    font-size: var(--step-0);
    font-weight: 600;
    color: var(--gunmetal-line);
    cursor: pointer;
    transition: color 200ms ease, border-color 200ms ease;
  }

  .stage-tabs__tab :global(.stage-icon) {
    width: 1.35rem;
    height: 1.35rem;
    stroke: var(--gunmetal-line);
    transition: stroke 200ms ease;
  }

  .stage-tabs__tab[aria-current='true'] {
    color: var(--aquamarine);
    border-bottom-color: var(--aquamarine);
  }

  .stage-tabs__tab[aria-current='true'] :global(.stage-icon) {
    stroke: var(--aquamarine);
  }

  /* align-items: flex-start (not the flex default, stretch) so each
     panel's height is its own content, not forced to match whichever
     sibling panel is tallest — that stretch is what left a slab of
     empty space under the shorter panels. The container's own height
     is then pinned to the active panel's height by the script below,
     since a flex row still auto-sizes to its tallest child otherwise. */
  .stage-panels {
    display: flex;
    align-items: flex-start;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    transition: height 300ms ease;
  }

  .stage-panels::-webkit-scrollbar {
    display: none;
  }

  .stage-panels :global(.stage-panel) {
    flex: 0 0 100%;
    scroll-snap-align: start;
    padding-block: clamp(1rem, 3vw, 1.5rem) clamp(1rem, 3vw, 2rem);
  }

  .stage-panels :global(.stage-number) {
    display: block;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(3rem, 9vw, 6rem);
    color: var(--gunmetal-raised);
    line-height: 1;
    margin-bottom: 0.5rem;
  }

  .stage-panels :global(.stage-panel h3) {
    font-size: var(--step-2);
  }

  /* Child combinator, not descendant: this must only reach the
     panel's own intro/closing prose, not paragraphs nested inside
     .stage-panel__domains (the label/desc pairs) further down — a
     plain ".stage-panel p" descendant selector matched those too and,
     because it carries an extra element selector, out-specified the
     domain list's own margin reset regardless of class count. */
  .stage-panels :global(.stage-panel > p) {
    margin-top: 1.25rem;
    color: var(--silver);
    max-width: 58ch;
  }

  .stage-panels :global(.stage-panel > p:first-of-type) {
    margin-top: 1.5rem;
  }

  /* Where a panel's content is genuinely a list of domains (not
     restated prose dressed up as bullets), present it as one: a dense
     comma-and-parenthesis sentence is slower to scan than short
     label + detail pairs, especially now that the panel is a compact
     card rather than a full-height page section. Icon-led rows, not
     a bordered card of bullet dots — that reads as a slide. */
  .stage-panels :global(.stage-panel__domains) {
    margin-top: 1.5rem;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem 2rem;
    max-width: 46rem;
  }

  .stage-panels :global(.stage-panel__domains li) {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
  }

  .stage-panels :global(.stage-panel__domain-icon) {
    flex-shrink: 0;
    width: 1.35rem;
    height: 1.35rem;
    margin-top: 0.1rem;
    fill: none;
    stroke: var(--aquamarine);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* The generic .stage-panel p rule (margin-top: 1.25rem, meant for
     the panel's own intro/closing prose) otherwise wins on
     specificity here too, since these are plain <p> tags — the extra
     .stage-panel__domains ancestor class is what beats it. */
  .stage-panels :global(.stage-panel__domains .stage-panel__domain-label) {
    margin-top: 0;
    line-height: 1.3;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step--1);
    color: var(--white-smoke);
  }

  .stage-panels :global(.stage-panel__domains .stage-panel__domain-desc) {
    margin-top: 0.15rem;
    line-height: 1.3;
    color: var(--silver);
    font-size: var(--step--1);
  }

  @media (max-width: 700px) {
    .stage-panels :global(.stage-panel__domains) {
      grid-template-columns: 1fr;
    }
  }

  .stage-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
  }

  .stage-nav__btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    flex-shrink: 0;
    border-radius: 50%;
    border: 1px solid var(--gunmetal-line);
    background: none;
    color: var(--white-smoke);
    cursor: pointer;
    transition: border-color 160ms ease, color 160ms ease;
  }

  .stage-nav__btn svg {
    width: 1.1rem;
    height: 1.1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .stage-nav__btn:hover:not(:disabled) {
    border-color: var(--aquamarine);
    color: var(--aquamarine);
  }

  .stage-nav__btn:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .stage-nav__progress {
    min-width: 4rem;
    text-align: center;
  }

  @media (max-width: 700px) {
    .stage-tabs {
      gap: 1rem;
    }

    .stage-tabs__tab {
      font-size: var(--step--1);
    }
  }
</style>

<script>
  const sequences = document.querySelectorAll<HTMLElement>('[data-stage-sequence]');
  const prefersReduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  sequences.forEach((seq) => {
    const panelsEl = seq.querySelector<HTMLElement>('.stage-panels');
    const panels = Array.from(seq.querySelectorAll<HTMLElement>('.stage-panel'));
    const tabs = Array.from(seq.querySelectorAll<HTMLButtonElement>('.stage-tabs__tab'));
    const progressEl = seq.querySelector<HTMLElement>('[data-progress]');
    const prevBtn = seq.querySelector<HTMLButtonElement>('[data-dir="-1"]');
    const nextBtn = seq.querySelector<HTMLButtonElement>('[data-dir="1"]');

    if (!panelsEl || !panels.length || !tabs.length) return;

    let current = 0;

    const setActive = (index: number, scroll = false) => {
      current = index;
      tabs.forEach((tab, i) => {
        if (i === index) tab.setAttribute('aria-current', 'true');
        else tab.removeAttribute('aria-current');
      });
      if (progressEl) {
        const pct = Math.round(((index + 1) / panels.length) * 100);
        progressEl.textContent = String(pct).padStart(3, '0');
      }
      if (prevBtn) prevBtn.disabled = index === 0;
      if (nextBtn) nextBtn.disabled = index === panels.length - 1;
      panelsEl.style.height = `${panels[index].offsetHeight}px`;
      if (scroll) {
        panelsEl.scrollTo({
          left: index * panelsEl.clientWidth,
          behavior: prefersReduced ? 'auto' : 'smooth',
        });
      }
    };

    tabs.forEach((tab, i) => tab.addEventListener('click', () => setActive(i, true)));
    prevBtn?.addEventListener('click', () => setActive(Math.max(current - 1, 0), true));
    nextBtn?.addEventListener('click', () => setActive(Math.min(current + 1, panels.length - 1), true));

    let ticking = false;
    panelsEl.addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          const index = Math.round(panelsEl.scrollLeft / panelsEl.clientWidth);
          if (index !== current) setActive(index);
          ticking = false;
        });
      },
      { passive: true }
    );

    // Browsers remap a vertical wheel/trackpad gesture into horizontal
    // scroll for an element that can *only* scroll horizontally — handy
    // for a standalone carousel, but here it traps the page's own
    // vertical scroll the moment the cursor is over the panel strip. A
    // mostly-vertical gesture should just scroll the page as normal; only
    // a genuinely horizontal one (trackpad swipe, shift+wheel) should
    // move the carousel, so it's forwarded to the page manually instead.
    panelsEl.addEventListener(
      'wheel',
      (event) => {
        if (Math.abs(event.deltaY) > Math.abs(event.deltaX)) {
          event.preventDefault();
          window.scrollBy(0, event.deltaY);
        }
      },
      { passive: false }
    );

    setActive(0);
    window.addEventListener('resize', () => setActive(current));
  });
</script>
