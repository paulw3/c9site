---
const stages = [
  { label: 'Design', copy: 'Target-state architecture, mapped before a single workload moves.' },
  { label: 'Engineer', copy: 'Governed execution: migration factory or GDC deployment, whichever the destination needs.' },
  { label: 'Run', copy: 'Documentation, knowledge transfer and support to keep it running, or we hand you the keys entirely.' },
];
---

<div class="numbered-rows">
  {stages.map((stage, i) => (
    <div class="numbered-row">
      <div class="numbered-row__top">
        <span class="numbered-row__index mono-tag">{String(i + 1).padStart(2, '0')}</span>
        <h4 class="numbered-row__label">{stage.label}</h4>
      </div>
      <p class="numbered-row__body">{stage.copy}</p>
    </div>
  ))}
</div>
