---
import StageIcon from './StageIcon.astro';
import { t, type Locale } from '../i18n/ui';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;

const stages = [
  { label: t(locale, 'methodologyDesignLabel'), icon: 'design' as const, copy: t(locale, 'methodologyDesignCopy') },
  { label: t(locale, 'methodologyEngineerLabel'), icon: 'engineer' as const, copy: t(locale, 'methodologyEngineerCopy') },
  { label: t(locale, 'methodologyRunLabel'), icon: 'run' as const, copy: t(locale, 'methodologyRunCopy') },
];
---

<ul class="methodology">
  {stages.map((stage, i) => (
    <li>
      <div class="methodology__top">
        <StageIcon stage={stage.icon} />
        <span class="methodology__index mono-tag">{String(i + 1).padStart(2, '0')}</span>
      </div>
      <h4>{stage.label}</h4>
      <p>{stage.copy}</p>
    </li>
  ))}
</ul>

<style>
  .methodology {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.5rem, 4vw, 3rem);
  }

  .methodology li {
    padding-top: 1.25rem;
    border-top: 1px solid var(--gunmetal-line);
  }

  .methodology__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .methodology__index {
    color: var(--aquamarine);
  }

  .methodology h4 {
    margin-top: 0.75rem;
  }

  .methodology p {
    margin-top: 0.75rem;
    color: var(--silver);
  }

  @media (max-width: 700px) {
    .methodology {
      grid-template-columns: 1fr;
    }
  }
</style>
