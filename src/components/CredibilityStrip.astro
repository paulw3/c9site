---
import { t, type Locale } from '../i18n/ui';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;

// Only what's real today (Google Cloud partnership, Money20/20 Middle
// East) — deliberately not padded out with aspirational entries. Add
// more here as they happen; the component itself doesn't need to change.
const items = ['Google Cloud', 'Money20/20 Middle East'];
---

<div class="credibility-strip">
  <p class="credibility-strip__label mono-tag">{t(locale, 'credibilityLabel')}</p>
  <ul class="credibility-strip__list">
    {items.map((item, i) => (
      <>
        {i > 0 && <li class="credibility-strip__dot mono-tag" aria-hidden="true">·</li>}
        <li class="mono-tag">{item}</li>
      </>
    ))}
  </ul>
</div>

<style>
  .credibility-strip {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    padding-block: clamp(1.25rem, 3vw, 1.75rem);
    border-block: 1px solid var(--gunmetal-line);
  }

  .credibility-strip__label {
    color: var(--silver);
    white-space: nowrap;
  }

  .credibility-strip__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
  }

  .credibility-strip__list li {
    color: var(--silver);
  }

  .credibility-strip__dot {
    color: var(--gunmetal-line);
  }

  @media (max-width: 700px) {
    .credibility-strip {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
