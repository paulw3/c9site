---
import { t, type Locale } from '../i18n/ui';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;

// Only what's real today — deliberately not padded out with aspirational
// entries. Add more tiles here as they happen.
const items = [
  { src: '/logos/google-cloud-summit.png', alt: 'Google Cloud Summit — Saudi Arabia, 13 October 2026' },
  { src: '/logos/money2020.png', alt: 'Money20/20 KSA' },
  { src: '/logos/leap.png', alt: 'LEAP' },
  { src: '/logos/step.png', alt: 'STEP Dubai' },
];
---

<section class="credibility-strip">
  <div class="container credibility-strip__inner">
    <p class="credibility-strip__label mono-tag">{t(locale, 'credibilityLabel')}</p>
    <div class="credibility-strip__row">
      {items.map((item) => (
        <img src={item.src} alt={item.alt} loading="lazy" class="credibility-strip__logo" />
      ))}
    </div>
  </div>
</section>

<style>
  .credibility-strip {
    padding-block: clamp(2rem, 4vw, 2.75rem);
    border-block: 1px solid var(--gunmetal-line);
    background: var(--gunmetal-raised);
  }

  .credibility-strip__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(1.25rem, 3vw, 1.75rem);
    text-align: center;
  }

  .credibility-strip__label {
    color: var(--silver);
  }

  .credibility-strip__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: clamp(2rem, 5vw, 3.5rem);
  }

  .credibility-strip__logo {
    height: clamp(2.25rem, 4vw, 2.75rem);
    width: auto;
    max-width: 10rem;
    object-fit: contain;
  }

  @media (max-width: 560px) {
    .credibility-strip__row {
      gap: 1.75rem;
    }
  }
</style>
