---
import { t, type Locale } from '../i18n/ui';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;

// Only what's real today — deliberately not padded out with aspirational
// entries. Add more tiles here as they happen; the ticker itself doesn't
// need to change.
const items = [
  { src: '/logos/google-cloud-summit.jpg', alt: 'Google Cloud Summit — Saudi Arabia, 13 October 2026' },
  { src: '/logos/money2020.jpg', alt: 'Money20/20 Middle East' },
  { src: '/logos/leap.jpg', alt: 'LEAP' },
  { src: '/logos/step.jpg', alt: 'STEP Dubai' },
];

// Repeated several times so the loop reads as a dense, continuously-moving
// ticker even with only a handful of logos on file — the CSS
// animation still loops seamlessly from 0 to -50%.
const looped = [...items, ...items, ...items];
---

<section class="credibility-strip">
  <div class="container">
    <p class="credibility-strip__label mono-tag">{t(locale, 'credibilityLabel')}</p>

    <!-- The moving track is decorative/duplicated for the loop — screen
         readers get the real list once, here, instead. -->
    <p class="visually-hidden">{items.map((item) => item.alt).join(', ')}</p>
  </div>

  <div class="credibility-strip__viewport" aria-hidden="true">
    <div class="credibility-strip__track">
      {looped.map((item) => (
        <span class="credibility-strip__tile">
          <img src={item.src} alt={item.alt} loading="lazy" />
        </span>
      ))}
    </div>
  </div>
</section>

<style>
  .credibility-strip {
    padding-block: clamp(2rem, 4vw, 2.75rem);
    border-block: 1px solid var(--gunmetal-line);
    background: var(--gunmetal-raised);
  }

  .credibility-strip__label {
    color: var(--silver);
    margin-bottom: clamp(1.25rem, 3vw, 1.75rem);
  }

  .credibility-strip__viewport {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
  }

  .credibility-strip__track {
    display: flex;
    align-items: center;
    gap: clamp(2.5rem, 6vw, 4rem);
    width: max-content;
    animation: credibility-scroll 18s linear infinite;
  }

  .credibility-strip__viewport:hover .credibility-strip__track {
    animation-play-state: paused;
  }

  .credibility-strip__tile {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    height: clamp(3rem, 5.5vw, 4rem);
  }

  .credibility-strip__tile img {
    height: 100%;
    width: auto;
    max-width: 12rem;
    border-radius: var(--border-radius);
    object-fit: contain;
  }

  @keyframes credibility-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .credibility-strip__track {
      animation: none;
    }
  }
</style>
