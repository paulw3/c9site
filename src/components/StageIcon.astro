---
interface Props {
  stage: 'design' | 'engineer' | 'run' | 'problem' | 'belief' | 'how-it-works' | 'standardise' | 'outcomes';
}

const { stage } = Astro.props;
---

{stage === 'design' && (
  <svg viewBox="0 0 24 24" class="stage-icon" aria-hidden="true" focusable="false">
    <circle cx="12" cy="5.3" r="1.35" />
    <path d="M12,6.65 L7.2,20.2" />
    <path d="M12,6.65 L16.8,20.2" />
    <path d="M5.8,20.2 L8.2,20.2" />
    <path d="M15.8,20.2 L18.2,20.2" />
  </svg>
)}

{stage === 'engineer' && (
  <svg viewBox="0 0 24 24" class="stage-icon" aria-hidden="true" focusable="false">
    <path
      class="stage-icon--filled"
      d="M 18.79,10.31 L 21.22,10.76 L 21.22,13.24 L 18.79,13.69 L 18.00,15.61 L 19.40,17.64 L 17.64,19.40 L 15.61,18.00 L 13.69,18.79 L 13.24,21.22 L 10.76,21.22 L 10.31,18.79 L 8.39,18.00 L 6.36,19.40 L 4.60,17.64 L 6.00,15.61 L 5.21,13.69 L 2.78,13.24 L 2.78,10.76 L 5.21,10.31 L 6.00,8.39 L 4.60,6.36 L 6.36,4.60 L 8.39,6.00 L 10.31,5.21 L 10.76,2.78 L 13.24,2.78 L 13.69,5.21 L 15.61,6.00 L 17.64,4.60 L 19.40,6.36 L 18.00,8.39 Z"
    />
    <circle cx="12" cy="12" r="2.6" />
  </svg>
)}

{stage === 'run' && (
  <svg viewBox="0 0 24 24" class="stage-icon" aria-hidden="true" focusable="false">
    <path d="M 5.14,14.50 A 7.30,7.30 0 0 1 18.86,9.50" />
    <path d="M 21.44,11.76 L 18.86,9.50 L 18.34,12.89" />
    <path d="M 18.86,9.50 A 7.30,7.30 0 0 1 5.14,14.50" />
    <path d="M 2.56,12.24 L 5.14,14.50 L 5.66,11.11" />
  </svg>
)}

{stage === 'problem' && (
  <svg viewBox="0 0 24 24" class="stage-icon" aria-hidden="true" focusable="false">
    <path d="M12,3 L22,20 L2,20 Z" />
    <path d="M12,9 L12,14" />
    <path d="M12,17.2 L12,17.4" />
  </svg>
)}

{stage === 'belief' && (
  <svg viewBox="0 0 24 24" class="stage-icon" aria-hidden="true" focusable="false">
    <path d="M12,3 A6,6 0 0 0 8.5,14 C9.3,14.6 9.8,15.5 9.9,16.5 L14.1,16.5 C14.2,15.5 14.7,14.6 15.5,14 A6,6 0 0 0 12,3 Z" />
    <path d="M9.5,18.5 L14.5,18.5" />
    <path d="M10.2,21 L13.8,21" />
  </svg>
)}

{stage === 'how-it-works' && (
  <svg viewBox="0 0 24 24" class="stage-icon" aria-hidden="true" focusable="false">
    <path d="M4,6.5 L20,6.5" />
    <path d="M4,12 L20,12" />
    <path d="M4,17.5 L13.5,17.5" />
    <path d="M16.5,16 L18.3,18 L21,14.5" />
  </svg>
)}

{stage === 'standardise' && (
  <svg viewBox="0 0 24 24" class="stage-icon" aria-hidden="true" focusable="false">
    <path d="M12,3 L21,8 L12,13 L3,8 Z" />
    <path d="M3,13 L12,18 L21,13" />
    <path d="M3,17.5 L12,22 L21,17.5" />
  </svg>
)}

{stage === 'outcomes' && (
  <svg viewBox="0 0 24 24" class="stage-icon" aria-hidden="true" focusable="false">
    <circle cx="12" cy="12" r="8.2" />
    <circle cx="12" cy="12" r="4.6" />
    <circle cx="12" cy="12" r="1" />
  </svg>
)}

<style>
  .stage-icon {
    width: 1.75rem;
    height: 1.75rem;
    fill: none;
    stroke: var(--aquamarine);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .stage-icon--filled {
    stroke-linejoin: round;
  }
</style>
