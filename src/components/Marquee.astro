---
interface Props {
  items: string[];
}

const { items } = Astro.props;
---

<div class="marquee" aria-hidden="true">
  <div class="marquee__track">
    <div class="marquee__set">
      {items.map((item, i) => (
        <span class="marquee__item">
          {i > 0 && <span class="marquee__dot">&bull;</span>} {item}
        </span>
      ))}
    </div>
    <div class="marquee__set">
      {items.map((item, i) => (
        <span class="marquee__item">
          {i > 0 && <span class="marquee__dot">&bull;</span>} {item}
        </span>
      ))}
    </div>
  </div>
</div>
