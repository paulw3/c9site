---
const navItems = [
  { href: '/cloud-migration', label: 'Cloud Migration & Transformation' },
  { href: '/google-distributed-cloud', label: 'Google Distributed Cloud' },
  { href: '/resources', label: 'Resources' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];

const { pathname } = Astro.url;

// TODO: replace with C-9INE's real WhatsApp Business number (digits only, country code first, no leading +)
const WHATSAPP_NUMBER = '15551234567';
---

<header class="site-header">
  <div class="container site-header__inner">
