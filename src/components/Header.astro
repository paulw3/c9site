      </svg>
      </span>
    </a>

    <div class="site-header__actions">
      <nav class="nav-desktop" aria-label="Primary">
        <ul>
          {navItems.map((item) => (
            <li>
              <a href={item.href} aria-current={pathname.startsWith(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <a
        href={`https://wa.me/${WHATSAPP_NUMBER}`}
        class="header-whatsapp"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Message us on WhatsApp"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path
            d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.472-.148-.67.15-.198.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.148-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.095 3.2 5.077 4.487.71.306 1.263.489 1.694.626.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"
          ></path>
          <path
            d="M12.001 2c-5.523 0-10 4.477-10 10 0 1.769.462 3.484 1.34 4.995L2 22l5.146-1.35A9.955 9.955 0 0 0 12 22c5.523 0 10-4.477 10-10S17.523 2 12 2Zm0 18a7.94 7.94 0 0 1-4.062-1.115l-.29-.172-3.055.801.815-2.978-.188-.306A7.94 7.94 0 0 1 4 12c0-4.411 3.589-8 8-8s8 3.589 8 8-3.589 8-8 8Z"
          ></path>
        </svg>
        <span>Message us</span>
      </a>

      <details class="nav-mobile">
        <summary aria-label="Open menu">
          <span class="nav-mobile__icon" aria-hidden="true"></span>
        </summary>
        <nav class="nav-mobile__panel" aria-label="Primary">
          <ul>
            {navItems.map((item) => (
              <li>
                <a href={item.href} aria-current={pathname.startsWith(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  /* No backdrop-filter here: blur on a position: sticky element forces
     a per-frame repaint of everything behind it while scrolling, which
     is a known source of dark rendering artifacts on external/secondary
     monitors (GPU-compositing differences the built-in display doesn't
     show). The background alone is opaque enough for legibility. */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: color-mix(in srgb, var(--gunmetal) 92%, transparent);
    border-bottom: 1px solid var(--gunmetal-line);
    transition: background-color 240ms ease, border-color 240ms ease;
  }

  /* While the hero photo is still visible directly behind it (Home only —
     toggled by Hero.astro's scroll script, for as long as any of the
     photo remains behind the header, pinned or not), the header goes
     fully transparent and lets the hero's own scrim carry legibility
     instead. */
  .site-header.is-transparent {
    background: transparent;
    border-bottom-color: transparent;
  }


  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-height);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2.5vw, 2rem);
  }

  .header-whatsapp {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border-radius: 999px;
    border: 1px solid var(--silver);
    padding: 0.5rem 1rem;
    text-decoration: none;
    color: var(--silver);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step--1);
    white-space: nowrap;
    transition: border-color 160ms ease, background-color 160ms ease;
  }

  .header-whatsapp svg {
    width: 1.1rem;
    height: 1.1rem;
    fill: #25d366;
    flex-shrink: 0;
  }

  .header-whatsapp:hover {
    border-color: var(--aquamarine);
    background: color-mix(in srgb, var(--aquamarine) 10%, transparent);
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
  }

  /* Sized to the wordmark's own viewBox ratio, so the box never jumps
     as the two marks crossfade inside it — only their opacity moves. */
  .wordmark__stage {
    position: relative;
    display: inline-block;
    width: 6.5rem;
    aspect-ratio: 1366.96875 / 316.12890625;
  }

  .wordmark__full,
  .wordmark__icon {
    position: absolute;
    inset: 0;
    margin: auto;
    transition: fill 160ms ease;
  }

  .wordmark__full {
    width: 100%;
    height: 100%;
    fill: var(--white-smoke);
    animation: wordmark-crossfade-full 10s ease-in-out infinite;
  }

  .wordmark__icon {
    height: 100%;
    width: auto;
    fill: var(--aquamarine);
    opacity: 0;
    animation: wordmark-crossfade-icon 10s ease-in-out infinite;
  }

  .wordmark:hover .wordmark__full {
    fill: var(--aquamarine);
  }

  /* Full wordmark shown → dissolves into the icon-only mark (the same
     one used alone in the footer) → holds → dissolves back — a loop
     that switches every ~5s, with a real crossfade rather than a hard
     cut, so it reads as one mark settling into the other. */
  @keyframes wordmark-crossfade-full {
    0%, 35% { opacity: 1; }
    45%, 85% { opacity: 0; }
    95%, 100% { opacity: 1; }
  }

  @keyframes wordmark-crossfade-icon {
    0%, 35% { opacity: 0; }
    45%, 85% { opacity: 1; }
    95%, 100% { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .wordmark__full,
    .wordmark__icon {
      animation: none;
    }

    .wordmark__full {
      opacity: 1;
    }

    .wordmark__icon {
      opacity: 0;
    }
  }

  .nav-desktop ul {
    display: flex;
    gap: clamp(1.25rem, 2.2vw, 2.25rem);
  }

  .nav-desktop a {
    font-size: var(--step--1);
    text-decoration: none;
    color: var(--silver);
    border-bottom: 1px solid transparent;
    padding-block: 0.3rem;
    transition: color 160ms ease, border-color 160ms ease;
  }

  .nav-desktop a:hover,
  .nav-desktop a[aria-current='page'] {
    color: var(--white-smoke);
    border-color: var(--aquamarine);
  }

  .nav-mobile {
    display: none;
  }

  @media (max-width: 860px) {
    .nav-desktop {
      display: none;
    }

    .nav-mobile {
      display: block;
      position: relative;
    }

    .site-header__actions {
      gap: 0.75rem;
    }
  }

  @media (max-width: 480px) {
    .header-whatsapp span {
      display: none;
    }

    .header-whatsapp {
      padding: 0.5rem;
    }

    .nav-mobile summary {
      list-style: none;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 2.5rem;
      height: 2.5rem;
      cursor: pointer;
    }

    .nav-mobile summary::-webkit-details-marker {
      display: none;
    }

    .nav-mobile__icon,
    .nav-mobile__icon::before,
    .nav-mobile__icon::after {
      display: block;
      width: 1.4rem;
      height: 2px;
      background: var(--white-smoke);
    }

    .nav-mobile__icon {
      position: relative;
    }

    .nav-mobile__icon::before,
    .nav-mobile__icon::after {
      content: '';
      position: absolute;
      left: 0;
    }

    .nav-mobile__icon::before {
      top: -6px;
    }

    .nav-mobile__icon::after {
      top: 6px;
    }

    .nav-mobile[open] .nav-mobile__icon {
      background: transparent;
    }

    .nav-mobile[open] .nav-mobile__icon::before {
      top: 0;
      transform: rotate(45deg);
    }

    .nav-mobile[open] .nav-mobile__icon::after {
      top: 0;
      transform: rotate(-45deg);
    }

    .nav-mobile__panel {
      position: absolute;
      right: 0;
      top: calc(100% + 0.75rem);
      background: var(--gunmetal-raised);
      border: 1px solid var(--gunmetal-line);
      border-radius: var(--border-radius);
      padding: 0.5rem;
      min-width: 15rem;
    }

    .nav-mobile__panel a {
      display: block;
      padding: 0.75rem 1rem;
      text-decoration: none;
      color: var(--white-smoke);
      font-size: var(--step--1);
    }

    .nav-mobile__panel a[aria-current='page'] {
      color: var(--aquamarine);
    }
  }
</style>
