---
interface Props {
  eyebrow: string;
}

const { eyebrow } = Astro.props;
---

<div class="proof-point">
  <p class="eyebrow">{eyebrow}</p>
  <p class="proof-point__statement"><slot /></p>
</div>

<style>
  .proof-point {
    padding: clamp(1.75rem, 4vw, 2.75rem);
    border-inline-start: 2px solid var(--aquamarine);
    background: var(--gunmetal-raised);
  }

  .proof-point__statement {
    margin-top: 1rem;
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 500;
    line-height: 1.3;
    color: var(--white-smoke);
    max-width: 42ch;
  }
</style>
