---
interface Props {
  title: string;
  description: string;
  href: string;
  linkText: string;
}

const { title, description, href, linkText } = Astro.props;
---

<a href={href} class="pillar-card">
  <h3>{title}</h3>
  <p>{description}</p>
  <span class="pillar-card__link mono-tag">{linkText}</span>
</a>

<style>
  /* No card kit — a split spec-sheet instead: two adjoining halves
     separated by one hairline, not two boxes with their own borders
     and a gap between them. */
  .pillar-card {
    display: block;
    padding: clamp(2.5rem, 5vw, 4rem) 0;
    text-decoration: none;
    color: inherit;
  }

  .pillar-card:not(:first-child) {
    border-left: 1px solid var(--gunmetal-line);
    padding-left: clamp(1.5rem, 4vw, 3rem);
  }

  .pillar-card:first-child {
    padding-right: clamp(1.5rem, 4vw, 3rem);
  }

  .pillar-card h3 {
    font-size: var(--step-2);
    max-width: 16ch;
  }

  .pillar-card p {
    margin-top: 1rem;
    color: var(--silver);
    max-width: 34ch;
  }

  .pillar-card__link {
    display: inline-block;
    margin-top: 1.75rem;
    color: var(--aquamarine);
    border-bottom: 1px solid transparent;
    transition: border-color 160ms ease;
  }

  .pillar-card:hover .pillar-card__link {
    border-color: var(--aquamarine);
  }

  @media (max-width: 700px) {
    .pillar-card:not(:first-child) {
      border-left: none;
      border-top: 1px solid var(--gunmetal-line);
      padding-left: 0;
    }

    .pillar-card:first-child {
      padding-right: 0;
    }
  }
</style>
