---
interface Props {
  title: string;
  description: string;
  href: string;
  linkText: string;
}

const { title, description, href, linkText } = Astro.props;
---

<div class="pillar-card">
  <h3>{title}</h3>
  <p>{description}</p>
  <a href={href} class="btn btn-outline pillar-card__link">{linkText}</a>
</div>

<style>
  /* No card kit — a split spec-sheet instead: two adjoining halves
     separated by one hairline, not two boxes with their own borders
     and a gap between them. */
  .pillar-card {
    padding: clamp(2.5rem, 5vw, 4rem) 0;
  }

  .pillar-card:not(:first-child) {
    border-left: 1px solid var(--gunmetal-line);
    padding-left: clamp(1.5rem, 4vw, 3rem);
  }

  .pillar-card:first-child {
    padding-right: clamp(1.5rem, 4vw, 3rem);
  }

  .pillar-card h3 {
    font-size: var(--step-2);
    max-width: 16ch;
  }

  .pillar-card p {
    margin-top: 1rem;
    color: var(--silver);
    max-width: 34ch;
  }

  .pillar-card__link {
    margin-top: 1.75rem;
  }

  @media (max-width: 700px) {
    .pillar-card:not(:first-child) {
      border-left: none;
      border-top: 1px solid var(--gunmetal-line);
      padding-left: 0;
    }

    .pillar-card:first-child {
      padding-right: 0;
    }
  }
</style>
