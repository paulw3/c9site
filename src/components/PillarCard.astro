---
interface Props {
  title: string;
  description: string;
  href: string;
  linkText: string;
}

const { title, description, href, linkText } = Astro.props;
---

<a href={href} class="pillar-card">
  <h3>{title}</h3>
  <p>{description}</p>
  <span class="pillar-card__link">{linkText}</span>
</a>

<style>
  /* The whole card is the button — bordered panel, full-area hover,
     not just a small button tucked at the bottom of a plain block. */
  .pillar-card {
    display: block;
    padding: clamp(1.75rem, 3vw, 2.5rem);
    border: 1px solid var(--gunmetal-line);
    border-radius: var(--border-radius);
    text-decoration: none;
    color: inherit;
    transition: border-color 160ms ease, transform 160ms ease;
  }

  .pillar-card:hover {
    border-color: var(--aquamarine);
    transform: translateY(-2px);
  }

  .pillar-card h3 {
    font-size: var(--step-2);
    max-width: 16ch;
  }

  .pillar-card p {
    margin-top: 1rem;
    color: var(--silver);
    max-width: 34ch;
  }

  .pillar-card__link {
    display: inline-block;
    margin-top: 1.75rem;
    color: var(--aquamarine);
    font-weight: 600;
    font-size: var(--step--1);
  }
</style>
