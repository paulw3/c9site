---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import StageSequence from '../components/StageSequence.astro';
import ProofPoint from '../components/ProofPoint.astro';
import CTAButton from '../components/CTAButton.astro';
---

<BaseLayout
  title="Cloud Migration & Transformation"
  description="We design the target state, engineer it in governed waves, and run it with you after go-live, across every domain the workload touches, not just the landing zone."
>
  <PageIntro eyebrow="Cloud Migration & Transformation">
    <h1>We design. We engineer. We run.</h1>
    <p class="lede">
      Whether you're moving from on-premise or another hyperscaler, we design the target state,
      engineer it in governed waves, and run it with you after go-live. Across every domain the
      workload touches, not just the landing zone.
    </p>
    <div class="page-intro__cta">
      <CTAButton href="/contact">Talk to us about your migration</CTAButton>
    </div>
  </PageIntro>

  <section class="section-tight stage-section">
    <div class="container">
      <StageSequence stages={['Design', 'Engineer', 'Run']} eyebrow="How we work">
        <article class="stage-panel">
          <span class="stage-number">01</span>
          <h3>Design</h3>
          <p>
            We map the target landing zone across every domain before a single workload moves,
            using Google's Migration Center to assess and plan the estate. Security is designed
            in from day one, not bolted on once the architecture is already built.
          </p>
          <ul class="stage-panel__domains">
            <li>
              <svg class="stage-panel__domain-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <rect x="9" y="2" width="6" height="5" rx="1" />
                <path d="M12,7 L12,11" />
                <path d="M12,11 L6,11 L6,14" />
                <path d="M12,11 L18,11 L18,14" />
                <rect x="3" y="14" width="6" height="5" rx="1" />
                <rect x="15" y="14" width="6" height="5" rx="1" />
              </svg>
              <div>
                <p class="stage-panel__domain-label">Foundation</p>
                <p class="stage-panel__domain-desc">Org hierarchy, Org Policy, Cloud Billing</p>
              </div>
            </li>
            <li>
              <svg class="stage-panel__domain-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <circle cx="12" cy="5" r="2" />
                <circle cx="5" cy="18" r="2" />
                <circle cx="19" cy="18" r="2" />
                <path d="M12,7 L6.5,16.3" />
                <path d="M12,7 L17.5,16.3" />
              </svg>
              <div>
                <p class="stage-panel__domain-label">Network</p>
                <p class="stage-panel__domain-desc">VPC design, hub-and-spoke or shared-VPC, Cloud Interconnect</p>
              </div>
            </li>
            <li>
              <svg class="stage-panel__domain-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <circle cx="8" cy="12" r="4" />
                <path d="M12,12 L21,12" />
                <path d="M17,12 L17,16" />
                <path d="M20,12 L20,15" />
              </svg>
              <div>
                <p class="stage-panel__domain-label">Identity</p>
                <p class="stage-panel__domain-desc">IAM, Zero Trust, privileged access management</p>
              </div>
            </li>
            <li>
              <svg class="stage-panel__domain-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M12,3 L20,6 L20,12 C20,17 16.5,20.5 12,22 C7.5,20.5 4,17 4,12 L4,6 Z" />
              </svg>
              <div>
                <p class="stage-panel__domain-label">Security</p>
                <p class="stage-panel__domain-desc">Encryption &amp; key management, mapped to SAMA, NCA ECC, PDPL</p>
              </div>
            </li>
            <li>
              <svg class="stage-panel__domain-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <ellipse cx="12" cy="5" rx="7" ry="2.5" />
                <path d="M5,5 L5,19 C5,20.4 8.1,21.5 12,21.5 C15.9,21.5 19,20.4 19,19 L19,5" />
                <path d="M5,12 C5,13.4 8.1,14.5 12,14.5 C15.9,14.5 19,13.4 19,12" />
              </svg>
              <div>
                <p class="stage-panel__domain-label">Data platform</p>
                <p class="stage-panel__domain-desc">Cloud SQL, AlloyDB, Cloud Storage</p>
              </div>
            </li>
            <li>
              <svg class="stage-panel__domain-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M12,3 L20,7.5 L20,16.5 L12,21 L4,16.5 L4,7.5 Z" />
                <path d="M12,3 L12,12 M4,7.5 L12,12 L20,7.5 M12,12 L12,21" />
              </svg>
              <div>
                <p class="stage-panel__domain-label">Compute</p>
                <p class="stage-panel__domain-desc">GKE topology</p>
              </div>
            </li>
          </ul>
        </article>

        <article class="stage-panel">
          <span class="stage-number">02</span>
          <h3>Engineer</h3>
          <p>
            The migration factory runs across domains, not one generic lift-and-shift. It moves
            in governed waves, with security validated before every cutover, not audited after.
          </p>
          <ul class="stage-panel__domains">
            <li>
              <svg class="stage-panel__domain-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <rect x="4" y="4" width="12" height="12" rx="2" />
                <rect x="8" y="8" width="12" height="12" rx="2" />
              </svg>
              <div>
                <p class="stage-panel__domain-label">Containers</p>
                <p class="stage-panel__domain-desc">Orchestration on GKE, Artifact Registry</p>
              </div>
            </li>
            <li>
              <svg class="stage-panel__domain-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <ellipse cx="12" cy="5" rx="7" ry="2.5" />
                <path d="M5,5 L5,19 C5,20.4 8.1,21.5 12,21.5 C15.9,21.5 19,20.4 19,19 L19,5" />
                <path d="M5,12 C5,13.4 8.1,14.5 12,14.5 C15.9,14.5 19,13.4 19,12" />
              </svg>
              <div>
                <p class="stage-panel__domain-label">Database</p>
                <p class="stage-panel__domain-desc">Database Migration Service, HA (Cloud SQL, AlloyDB)</p>
              </div>
            </li>
            <li>
              <svg class="stage-panel__domain-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <circle cx="12" cy="5" r="2" />
                <circle cx="5" cy="18" r="2" />
                <circle cx="19" cy="18" r="2" />
                <path d="M12,7 L6.5,16.3" />
                <path d="M12,7 L17.5,16.3" />
              </svg>
              <div>
                <p class="stage-panel__domain-label">Networking &amp; API</p>
                <p class="stage-panel__domain-desc">Apigee, VPC Service Controls</p>
              </div>
            </li>
            <li>
              <svg class="stage-panel__domain-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <circle cx="4" cy="12" r="2" />
                <circle cx="12" cy="12" r="2" />
                <circle cx="20" cy="12" r="2" />
                <path d="M6,12 L10,12" />
                <path d="M14,12 L18,12" />
              </svg>
              <div>
                <p class="stage-panel__domain-label">Data</p>
                <p class="stage-panel__domain-desc">Storage Transfer Service, Pub/Sub, Cloud Data Fusion, Dataflow</p>
              </div>
            </li>
            <li>
              <svg class="stage-panel__domain-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M12,3 L20,7.5 L20,16.5 L12,21 L4,16.5 L4,7.5 Z" />
                <path d="M12,3 L12,12 M4,7.5 L12,12 L20,7.5 M12,12 L12,21" />
              </svg>
              <div>
                <p class="stage-panel__domain-label">Compute</p>
                <p class="stage-panel__domain-desc">Migrate to Virtual Machines, Cloud Run, Cloud Functions</p>
              </div>
            </li>
            <li>
              <svg class="stage-panel__domain-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M2,12 C5,6 19,6 22,12 C19,18 5,18 2,12 Z" />
                <circle cx="12" cy="12" r="2.5" />
              </svg>
              <div>
                <p class="stage-panel__domain-label">Observability</p>
                <p class="stage-panel__domain-desc">Cloud Logging &amp; Monitoring, SecOps</p>
              </div>
            </li>
            <li>
              <svg class="stage-panel__domain-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M12,3 L20,6 L20,12 C20,17 16.5,20.5 12,22 C7.5,20.5 4,17 4,12 L4,6 Z" />
              </svg>
              <div>
                <p class="stage-panel__domain-label">Security</p>
                <p class="stage-panel__domain-desc">Cloud KMS, Secret Manager, IAM enforcement, threat detection</p>
              </div>
            </li>
            <li>
              <svg class="stage-panel__domain-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M4,10 A8,8 0 1 1 6.2,16.2" />
                <path d="M4,10 L1.7,6.8 M4,10 L7.3,11.3" />
                <path d="M12,7 L12,12 L15.5,14" />
              </svg>
              <div>
                <p class="stage-panel__domain-label">Backup and DR</p>
                <p class="stage-panel__domain-desc">Backup and DR Service</p>
              </div>
            </li>
          </ul>
          <p>
            Pilot first, then entry and exit criteria at every gate. Infrastructure-as-Code from
            day one, using Cloud Build and Cloud Deploy for CI/CD, and accelerated by aSaaS
            (أساس), our Marketplace-listed automation.
          </p>
        </article>

        <article class="stage-panel">
          <span class="stage-number">03</span>
          <h3>Run</h3>
          <p>
            We operationalise and hand over across the same domains: documentation, knowledge
            transfer, hypercare, a managed transition to steady state, and ongoing monitoring.
          </p>
          <p>
            No in-house security leadership? We continue as CISO-as-a-Service, built on two
            decades of security leadership across global banks.
          </p>
        </article>
      </StageSequence>
    </div>
  </section>

  <!--
    ANFAA and aSaaS are both real, Marketplace-listed products (see
    their own booklets: C9INE_ANFAA_Booklet_v1.0, C9INE_aSaaS_Booklet_v1.0)
    rather than service line items, so they get named cards here instead
    of staying a one-line mention inside the Engineer stage above.
    TODO: swap the "Available on Google Cloud Marketplace" badges for
    real links once each listing's URL is confirmed.
  -->
  <section class="section-tight section-raised">
    <div class="container">
      <div class="products-intro">
        <p class="eyebrow">Our Products</p>
        <h2>Two products, born out of delivery, now available on their own.</h2>
        <p class="lede">
          Both grew out of real migration and GDC engagements, then became repeatable enough
          to package. aSaaS already accelerates the Engineer phase above; ANFAA runs
          independently of any C-9INE engagement.
        </p>
      </div>

      <div class="products-grid">
        <article class="product-card product-card--anfaa">
          <div class="product-card__head">
            <span class="product-card__mark">ANFAA</span>
            <span class="product-card__tag mono-tag">Multi-cloud FinOps</span>
          </div>
          <p class="product-card__statement">Cloud should create value, not just cost.</p>
          <p class="product-card__desc">
            Turns cloud spend into a continuous FinOps operating discipline — visibility,
            ownership, optimisation and control, across every provider you run.
          </p>
          <ul class="product-card__outcomes">
            <li>Better spend visibility across every provider</li>
            <li>Clearer accountability from finance to engineering</li>
            <li>Budgets and guardrails built into everyday decisions</li>
          </ul>
          <div class="product-card__footer">
            <span class="product-card__badge mono-tag">Available on Google Cloud Marketplace</span>
            <a class="product-card__link" href="/resources/anfaa">Learn more</a>
          </div>
        </article>

        <article class="product-card product-card--asaas">
          <div class="product-card__head">
            <span class="product-card__mark">aSaaS</span>
            <span class="product-card__tag mono-tag">Intelligent Cloud Operator</span>
          </div>
          <p class="product-card__statement">Cloud foundations shouldn't slow innovation down.</p>
          <p class="product-card__desc">
            Captures approved cloud standards once, then turns them into a guided, repeatable
            delivery experience — the same automation behind our own Engineer phase above.
          </p>
          <ul class="product-card__outcomes">
            <li>Faster time to value on every new environment</li>
            <li>Consistent, approved patterns reused across teams</li>
            <li>Less dependence on scarce cloud specialists</li>
          </ul>
          <div class="product-card__footer">
            <span class="product-card__badge mono-tag">Available on Google Cloud Marketplace</span>
            <a class="product-card__link" href="/resources/asaas">Learn more</a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <ProofPoint eyebrow="No lock-in">
        Code, diagrams, evidence and documentation are delivered into your own repositories.
        When we're done, your team can operate what we built without depending on us to keep it
        running.
      </ProofPoint>
      <div class="page-cta">
        <CTAButton href="/contact">Talk to us about your migration</CTAButton>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* PageIntro's own bottom padding (up to 5rem) plus this section's
     usual top padding (up to 4rem) compounded into a much bigger gap
     here than anywhere else on the page — cut the top side back since
     the intro already provides the separation. */
  .stage-section {
    padding-top: clamp(1rem, 2vw, 1.5rem);
  }

  .page-cta {
    margin-top: 2.5rem;
  }

  .products-intro {
    max-width: 40rem;
  }

  .products-intro h2 {
    margin-top: 0.75rem;
  }

  .products-intro .lede {
    margin-top: 1rem;
  }

  .products-grid {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 2rem);
  }

  .product-card {
    display: flex;
    flex-direction: column;
    padding: clamp(1.5rem, 3vw, 2rem);
    border-top: 2px solid var(--accent, var(--aquamarine));
    background: var(--gunmetal-raised);
  }

  .product-card--anfaa {
    --accent: var(--aquamarine);
  }

  .product-card--asaas {
    --accent: var(--vivid-sky-blue);
  }

  .product-card__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.75rem;
  }

  .product-card__mark {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-2);
    color: var(--white-smoke);
  }

  .product-card__tag {
    color: var(--accent, var(--aquamarine));
  }

  .product-card__statement {
    margin-top: 1.25rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-0);
    color: var(--white-smoke);
    line-height: 1.3;
  }

  .product-card__desc {
    margin-top: 0.75rem;
    color: var(--silver);
    font-size: var(--step--1);
    line-height: 1.5;
  }

  .product-card__outcomes {
    margin-top: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .product-card__outcomes li {
    padding-left: 1.25rem;
    position: relative;
    color: var(--silver);
    font-size: var(--step--1);
    line-height: 1.4;
  }

  .product-card__outcomes li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent, var(--aquamarine));
  }

  /* Pushes to the bottom of the card regardless of how much copy is
     above it (the card itself is a flex column), so both cards'
     footers line up even when one card's description or outcome list
     runs a line longer than the other's. */
  .product-card__footer {
    margin-top: auto;
    padding-top: 1.25rem;
    border-top: 1px solid var(--gunmetal-line);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .product-card__badge {
    color: var(--silver);
  }

  .product-card__link {
    color: var(--accent, var(--aquamarine));
    font-family: var(--font-display);
    font-weight: 600;
    text-decoration: none;
  }

  .product-card__link:hover {
    text-decoration: underline;
  }

  @media (max-width: 700px) {
    .products-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
