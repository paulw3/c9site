---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import ProofPoint from '../components/ProofPoint.astro';
import CTAButton from '../components/CTAButton.astro';
---

<BaseLayout
  title="Cloud Migration & Transformation"
  description="We design the target state, engineer it in governed waves, and run it with you after go-live, across every domain the workload touches, not just the landing zone."
>
  <PageIntro eyebrow="Cloud Migration & Transformation">
    <h1>We design. We engineer. We run.</h1>
    <p class="lede">
      Whether you're moving from on-premise or another hyperscaler, we design the target state,
      engineer it in governed waves, and run it with you after go-live. Across every domain the
      workload touches, not just the landing zone.
    </p>
    <div class="page-intro__cta">
      <CTAButton href="/contact">Talk to us about your migration</CTAButton>
    </div>
  </PageIntro>

  <!--
    Redesigned per the same approach used on the GDC page: no pinned
    scroll mechanic, one distinct layout per stage instead of one
    repeated dense icon-grid template, and the domain lists trimmed
    from 6-8 GCP-product-name items down to the handful that actually
    matter to the reader — outcome-labelled, not a spec sheet.
  -->
  <section class="section-tight section-raised intro-gap-fix">
    <div class="container">
      <div class="design-layout">
        <div class="design-layout__intro">
          <p class="eyebrow">Design</p>
          <h2>One target state. Every domain, planned together.</h2>
          <p class="lede">
            We map the target landing zone before a single workload moves, using Google's
            Migration Center to assess and plan the estate.
          </p>
          <p class="pull-statement">
            Security is designed in from day one, not bolted on once the architecture is
            already built.
          </p>
        </div>

        <ul class="editorial-list">
          <li>
            <div>
              <h4>Foundation</h4>
              <p>Org structure, policy and billing, decided once, not reworked per project.</p>
            </div>
          </li>
          <li>
            <div>
              <h4>Network &amp; identity</h4>
              <p>Connectivity and access designed together, so Zero Trust isn't retrofitted.</p>
            </div>
          </li>
          <li>
            <div>
              <h4>Security &amp; compliance</h4>
              <p>Encryption and controls mapped to SAMA, NCA ECC and PDPL from day one.</p>
            </div>
          </li>
          <li>
            <div>
              <h4>Data &amp; compute</h4>
              <p>The platform your workloads will actually run on, sized for the estate.</p>
            </div>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <div class="standardise-intro">
        <p class="eyebrow">Engineer</p>
        <h2>Governed waves, not lift-and-shift.</h2>
        <p class="lede">
          The migration factory runs across every domain at once. Security is validated before
          each wave moves, not audited after.
        </p>
      </div>

      <ul class="foundations-grid">
        <li>
          <span class="foundations-grid__icon">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <rect x="4" y="4" width="12" height="12" rx="2" />
              <rect x="8" y="8" width="12" height="12" rx="2" />
            </svg>
          </span>
          <h4>Containers &amp; compute</h4>
          <p>Orchestrated on GKE, with a clear path for VMs, Cloud Run and Functions</p>
        </li>
        <li>
          <span class="foundations-grid__icon">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <ellipse cx="12" cy="5" rx="7" ry="2.5" />
              <path d="M5,5 L5,19 C5,20.4 8.1,21.5 12,21.5 C15.9,21.5 19,20.4 19,19 L19,5" />
              <path d="M5,12 C5,13.4 8.1,14.5 12,14.5 C15.9,14.5 19,13.4 19,12" />
            </svg>
          </span>
          <h4>Database</h4>
          <p>Migrated with high availability built in, not bolted on after cutover</p>
        </li>
        <li>
          <span class="foundations-grid__icon">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <circle cx="4" cy="12" r="2" />
              <circle cx="12" cy="12" r="2" />
              <circle cx="20" cy="12" r="2" />
              <path d="M6,12 L10,12" />
              <path d="M14,12 L18,12" />
            </svg>
          </span>
          <h4>Data &amp; integration</h4>
          <p>Pipelines that move with the workload, not stitched on around it</p>
        </li>
        <li>
          <span class="foundations-grid__icon">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M2,12 C5,6 19,6 22,12 C19,18 5,18 2,12 Z" />
              <circle cx="12" cy="12" r="2.5" />
            </svg>
          </span>
          <h4>Observability &amp; security</h4>
          <p>Logging, monitoring and threat detection live before go-live, not audited after</p>
        </li>
        <li>
          <span class="foundations-grid__icon">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M4,10 A8,8 0 1 1 6.2,16.2" />
              <path d="M4,10 L1.7,6.8 M4,10 L7.3,11.3" />
              <path d="M12,7 L12,12 L15.5,14" />
            </svg>
          </span>
          <h4>Backup &amp; DR</h4>
          <p>Recovery tested before you need it, not the first time in production</p>
        </li>
        <li>
          <span class="foundations-grid__icon">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <circle cx="12" cy="5" r="2" />
              <circle cx="5" cy="18" r="2" />
              <circle cx="19" cy="18" r="2" />
              <path d="M12,7 L6.5,16.3" />
              <path d="M12,7 L17.5,16.3" />
            </svg>
          </span>
          <h4>Networking &amp; API</h4>
          <p>Governed connectivity between services, inside the wave, not after it</p>
        </li>
      </ul>

      <p class="pull-statement foundations-grid__statement">
        Pilot first. Entry and exit criteria at every gate. Infrastructure-as-Code from day
        one, accelerated by aSaaS (أساس), our Marketplace-listed automation.
      </p>
    </div>
  </section>

  <section class="section-tight section-raised">
    <div class="container">
      <div class="belief-layout">
        <p class="eyebrow">Run</p>
        <h2 class="belief-layout__heading">We hand you the keys.</h2>
        <p class="lede">
          Documentation, knowledge transfer, hypercare, and a managed transition to steady
          state — until your team can run what we built without us.
        </p>
        <p class="lede belief-layout__closing">
          No in-house security leadership? We continue as CISO-as-a-Service, built on two
          decades of security leadership across global banks.
        </p>
      </div>
    </div>
  </section>

  <!--
    ANFAA and aSaaS are both real, Marketplace-listed products (see
    their own booklets: C9INE_ANFAA_Booklet_v1.0, C9INE_aSaaS_Booklet_v1.0)
    rather than service line items, so they get named cards here instead
    of staying a one-line mention inside the Engineer stage above.
    TODO: swap the "Available on Google Cloud Marketplace" badges for
    real links once each listing's URL is confirmed.
  -->
  <section class="section-tight section-raised">
    <div class="container">
      <div class="products-intro">
        <p class="eyebrow">Our Products</p>
        <h2>Two products, born out of delivery, now available on their own.</h2>
        <p class="lede">
          Both grew out of real migration and GDC engagements, then became repeatable enough
          to package. aSaaS already accelerates the Engineer phase above; ANFAA runs
          independently of any C-9INE engagement.
        </p>
      </div>

      <div class="products-grid">
        <article class="product-card product-card--anfaa">
          <div class="product-card__head">
            <span class="product-card__mark">ANFAA</span>
            <span class="product-card__tag mono-tag">Multi-cloud FinOps</span>
          </div>
          <p class="product-card__statement">Cloud should create value, not just cost.</p>
          <p class="product-card__desc">
            Turns cloud spend into a continuous FinOps operating discipline — visibility,
            ownership, optimisation and control, across every provider you run.
          </p>
          <ul class="product-card__outcomes">
            <li>Better spend visibility across every provider</li>
            <li>Clearer accountability from finance to engineering</li>
            <li>Budgets and guardrails built into everyday decisions</li>
          </ul>
          <div class="product-card__footer">
            <span class="product-card__badge mono-tag">Available on Google Cloud Marketplace</span>
            <a class="product-card__link" href="/resources/anfaa">Learn more</a>
          </div>
        </article>

        <article class="product-card product-card--asaas">
          <div class="product-card__head">
            <span class="product-card__mark">aSaaS</span>
            <span class="product-card__tag mono-tag">Intelligent Cloud Operator</span>
          </div>
          <p class="product-card__statement">Cloud foundations shouldn't slow innovation down.</p>
          <p class="product-card__desc">
            Captures approved cloud standards once, then turns them into a guided, repeatable
            delivery experience — the same automation behind our own Engineer phase above.
          </p>
          <ul class="product-card__outcomes">
            <li>Faster time to value on every new environment</li>
            <li>Consistent, approved patterns reused across teams</li>
            <li>Less dependence on scarce cloud specialists</li>
          </ul>
          <div class="product-card__footer">
            <span class="product-card__badge mono-tag">Available on Google Cloud Marketplace</span>
            <a class="product-card__link" href="/resources/asaas">Learn more</a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <ProofPoint eyebrow="No lock-in">
        Code, diagrams, evidence and documentation are delivered into your own repositories.
        When we're done, your team can operate what we built without depending on us to keep it
        running.
      </ProofPoint>
      <div class="page-cta">
        <CTAButton href="/contact">Talk to us about your migration</CTAButton>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* PageIntro's own bottom padding (up to 5rem) plus this section's
     usual top padding (up to 4rem) compounded into a much bigger gap
     here than anywhere else on the page — cut the top side back since
     the intro already provides the separation. */
  .intro-gap-fix {
    padding-top: clamp(1rem, 2vw, 1.5rem);
  }

  .page-cta {
    margin-top: 2.5rem;
  }

  /* ---- How we work: Design / Engineer / Run --------------------
     Three distinct shapes instead of one repeated dense icon-grid
     template — an editorial two-column list, a seamless icon grid,
     and a calm centred statement — the same approach used on the
     Google Distributed Cloud page. */

  .design-layout {
    display: grid;
    grid-template-columns: minmax(0, 21rem) 1fr;
    gap: clamp(2.5rem, 6vw, 5.5rem);
    align-items: start;
  }

  .design-layout__intro h2 {
    margin-top: 0.75rem;
    font-size: var(--step-2);
  }

  .design-layout__intro .lede {
    margin-top: 1rem;
  }

  .design-layout__intro .pull-statement {
    margin-top: 2.25rem;
  }

  .editorial-list {
    display: flex;
    flex-direction: column;
  }

  .editorial-list li {
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--gunmetal-line);
  }

  .editorial-list li:first-child {
    padding-top: 0;
  }

  .editorial-list li:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .editorial-list h4 {
    font-size: var(--step-0);
    color: var(--white-smoke);
  }

  .editorial-list p {
    margin-top: 0.4rem;
    color: var(--silver);
    font-size: var(--step--1);
    line-height: 1.5;
  }

  @media (max-width: 850px) {
    .design-layout {
      grid-template-columns: 1fr;
    }
  }

  /* Shared "quoted highlight" line — a left rule and larger type
     rather than a boxed callout, so it reads as emphasis, not a
     repeated card component. */
  .pull-statement {
    padding-left: 1.15rem;
    border-left: 2px solid var(--aquamarine);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-1);
    line-height: 1.35;
    color: var(--white-smoke);
  }

  .standardise-intro {
    max-width: 36rem;
  }

  .standardise-intro h2 {
    margin-top: 0.75rem;
    font-size: var(--step-2);
  }

  .standardise-intro .lede {
    margin-top: 1rem;
  }

  .foundations-grid {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    background: var(--gunmetal-line);
    border: 1px solid var(--gunmetal-line);
    border-radius: var(--border-radius);
    overflow: hidden;
  }

  .foundations-grid li {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: clamp(1.5rem, 3vw, 1.85rem);
    background: var(--gunmetal);
  }

  .foundations-grid__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 8px;
    background: color-mix(in srgb, var(--aquamarine) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--aquamarine) 28%, transparent);
  }

  .foundations-grid__icon svg {
    width: 1.35rem;
    height: 1.35rem;
    fill: none;
    stroke: var(--aquamarine);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .foundations-grid h4 {
    font-size: var(--step-0);
    color: var(--white-smoke);
  }

  .foundations-grid p {
    color: var(--silver);
    font-size: var(--step--1);
    line-height: 1.5;
  }

  .foundations-grid__statement {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    max-width: 46rem;
  }

  @media (max-width: 900px) {
    .foundations-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .foundations-grid {
      grid-template-columns: 1fr;
    }
  }

  .belief-layout {
    max-width: 40rem;
    margin-inline: auto;
    text-align: center;
  }

  .belief-layout > .eyebrow {
    margin-inline: auto;
  }

  .belief-layout__heading {
    margin-top: 0.85rem;
    font-size: var(--step-4);
  }

  .belief-layout .lede {
    margin-top: 1.25rem;
    margin-inline: auto;
  }

  .belief-layout__closing {
    margin-top: 1.75rem;
    margin-inline: auto;
    color: var(--silver);
  }

  .products-intro {
    max-width: 40rem;
  }

  .products-intro h2 {
    margin-top: 0.75rem;
  }

  .products-intro .lede {
    margin-top: 1rem;
  }

  .products-grid {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 2rem);
  }

  .product-card {
    display: flex;
    flex-direction: column;
    padding: clamp(1.5rem, 3vw, 2rem);
    border-top: 2px solid var(--accent, var(--aquamarine));
    background: var(--gunmetal-raised);
  }

  .product-card--anfaa {
    --accent: var(--aquamarine);
  }

  .product-card--asaas {
    --accent: var(--vivid-sky-blue);
  }

  .product-card__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.75rem;
  }

  .product-card__mark {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-2);
    color: var(--white-smoke);
  }

  .product-card__tag {
    color: var(--accent, var(--aquamarine));
  }

  .product-card__statement {
    margin-top: 1.25rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-0);
    color: var(--white-smoke);
    line-height: 1.3;
  }

  .product-card__desc {
    margin-top: 0.75rem;
    color: var(--silver);
    font-size: var(--step--1);
    line-height: 1.5;
  }

  .product-card__outcomes {
    margin-top: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .product-card__outcomes li {
    padding-left: 1.25rem;
    position: relative;
    color: var(--silver);
    font-size: var(--step--1);
    line-height: 1.4;
  }

  .product-card__outcomes li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent, var(--aquamarine));
  }

  /* Pushes to the bottom of the card regardless of how much copy is
     above it (the card itself is a flex column), so both cards'
     footers line up even when one card's description or outcome list
     runs a line longer than the other's. */
  .product-card__footer {
    margin-top: auto;
    padding-top: 1.25rem;
    border-top: 1px solid var(--gunmetal-line);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .product-card__badge {
    color: var(--silver);
  }

  .product-card__link {
    color: var(--accent, var(--aquamarine));
    font-family: var(--font-display);
    font-weight: 600;
    text-decoration: none;
  }

  .product-card__link:hover {
    text-decoration: underline;
  }

  @media (max-width: 700px) {
    .products-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
