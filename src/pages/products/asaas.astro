---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import ProductBrief from '../../components/ProductBrief.astro';

const asaasSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'aSaaS',
  alternateName: 'Intelligent Cloud Operator',
  description:
    "aSaaS captures approved cloud standards once, then turns them into a guided, repeatable delivery experience for teams who need cloud, not cloud expertise.",
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Cloud',
  url: 'https://c9ine.com/products/asaas',
  provider: { '@id': 'https://c9ine.com/#organization' },
  offers: {
    '@type': 'Offer',
    url: 'https://console.cloud.google.com/marketplace/product/c9ine-public-479908/asaas',
  },
};
---

<BaseLayout
  title="aSaaS (أساس): Intelligent Cloud Operator"
  description="aSaaS (أساس) captures approved cloud standards once, then turns them into a guided, repeatable delivery experience for teams who need cloud, not cloud expertise."
  schema={asaasSchema}
>
  <PageIntro eyebrow="Product Brief">
    <h1>Cloud foundations shouldn't slow innovation down.</h1>
    <p class="gdc-subhead">Build faster. Standardise once. Scale with confidence.</p>
    <p class="lede">
      aSaaS (أساس) captures approved cloud standards once, then turns them into a guided,
      repeatable delivery experience for teams who need cloud without becoming cloud
      specialists (the same automation that accelerates C-9INE's own migration engagements).
      It's available directly through Google Cloud Marketplace: an AI assistant deploys your
      landing zone stage by stage, pausing for your approval before every infrastructure change,
      and hands it over with a GitOps pipeline already wired up.
    </p>
    <div class="page-intro__cta">
      <a class="intro-link" href="/products/asaas-booklet.pdf">
        <span class="intro-link__icon">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <rect x="6" y="3" width="12" height="18" rx="1.5"></rect>
            <path d="M9,9 L15,9 M9,12.5 L15,12.5 M9,16 L13,16"></path>
          </svg>
        </span>
        <span class="intro-link__text">
          <span class="intro-link__label">Download the PDF</span>
          <span class="intro-link__desc">The complete aSaaS (أساس) product brief, in one document.</span>
        </span>
      </a>

      <a class="intro-link" href="/products/asaas-getting-started">
        <span class="intro-link__icon">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <circle cx="12" cy="12" r="9"></circle>
            <path d="M15,9 L13,13 L9,15 L11,11 Z"></path>
          </svg>
        </span>
        <span class="intro-link__text">
          <span class="intro-link__label">Getting started guide</span>
          <span class="intro-link__desc">A step-by-step walkthrough for your first deployment.</span>
        </span>
      </a>

      <a
        class="intro-link"
        href="https://console.cloud.google.com/marketplace/product/c9ine-public-479908/asaas"
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="intro-link__icon intro-link__icon--image intro-link__icon--google">
          <img src="/logos/gcp-marketplace-cart.png" alt="" />
        </span>
        <span class="intro-link__text">
          <span class="intro-link__label">Get it on Google Marketplace</span>
          <span class="intro-link__desc">Deploy aSaaS (أساس) directly from Google Cloud.</span>
        </span>
      </a>

      <a class="intro-link" href="/contact?intent=asaas">
        <span class="intro-link__icon">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M4,5 L20,5 L20,16 L9,16 L4,20 Z"></path>
          </svg>
        </span>
        <span class="intro-link__text">
          <span class="intro-link__label">Talk to us about aSaaS (أساس)</span>
          <span class="intro-link__desc">Get in touch with our team.</span>
        </span>
      </a>
    </div>
  </PageIntro>

  <ProductBrief
    accent="sky"
    productTag="Intelligent Cloud Operator"
    beliefHeading="Infrastructure should be easy to consume."
    beliefLede="aSaaS (أساس) captures approved cloud standards once, then turns them into a guided and repeatable delivery experience for teams who need cloud without becoming cloud specialists."
    plusItems={[
      { label: 'Standards', icon: ['M6,3 L14,3 L18,7 L18,21 L6,21 Z', 'M14,3 L14,7 L18,7', 'M9,12 L15,12 M9,15 L15,15 M9,18 L13,18'] },
      { label: 'Guidance', icon: ['M12,3 L12,21', 'M12,7 L18,7 L16,10 L18,13 L12,13'] },
      { label: 'Automation', icon: ['M12,9 A3,3 0 1 1 12,15 A3,3 0 1 1 12,9 Z', 'M12,3 L12,6 M12,18 L12,21 M3,12 L6,12 M18,12 L21,12 M5.6,5.6 L7.8,7.8 M16.2,16.2 L18.4,18.4 M5.6,18.4 L7.8,16.2 M16.2,7.8 L18.4,5.6'] },
      { label: 'Control', icon: ['M4,7 L20,7 M4,12 L15,12 M4,17 L18,17'] },
    ]}
    beliefStatement="Technology should make speed and control easier to achieve, not harder to balance."
    beliefClosing="The product experience matters because customers do not want another complex cloud build. They want a controlled path from intent to working foundation."
    loopHeading="From business input to governed cloud foundation."
    loopLede="A guided path that translates requirements into repeatable cloud infrastructure delivery."
    loopStages={[
      { label: 'Capture', desc: 'Collect cloud, security, environment and governance requirements.', icon: ['M12,3 L12,14', 'M7,10 L12,15 L17,10', 'M4,18 L20,18 L20,21 L4,21 Z'] },
      { label: 'Configure', desc: 'Generate structured definitions and deployment-ready patterns.', icon: ['M12,9 A3,3 0 1 1 12,15 A3,3 0 1 1 12,9 Z', 'M12,3 L12,6 M12,18 L12,21 M3,12 L6,12 M18,12 L21,12 M5.6,5.6 L7.8,7.8 M16.2,16.2 L18.4,18.4 M5.6,18.4 L7.8,16.2 M16.2,7.8 L18.4,5.6'] },
      { label: 'Build', desc: 'Automate cloud foundation provisioning through reusable IaC.', icon: ['M3,3 L10,3 L10,10 L3,10 Z', 'M13,3 L20,3 L20,10 L13,10 Z', 'M3,13 L10,13 L10,20 L3,20 Z', 'M13,13 L20,13 L20,20 L13,20 Z'] },
      { label: 'Validate', desc: 'Confirm standards, controls and readiness before handover.', icon: ['M12,3 L19,6 L19,12 C19,16.5 16,19.5 12,21 C8,19.5 5,16.5 5,12 L5,6 Z', 'M9,12 L11,14 L15.5,9'] },
    ]}
    loopStatement="Guided input. Repeatable configuration. Automated delivery. Governed handover."
    outcomesHeading="From cloud project to cloud factory."
    outcomesLede="The goal is not one successful environment. The goal is a repeatable way to build many of them with control."
    outcomes={[
      { label: 'Faster time to value', desc: 'Less time spent assembling foundations.', icon: ['M13,2 L4,14 L11,14 L10,22 L20,9 L13,9 Z'] },
      { label: 'More consistency', desc: 'Approved patterns reused across teams.', icon: ['M4,10 A8,8 0 1 1 6.2,16.2', 'M4,10 L1.7,6.8 M4,10 L7.3,11.3'] },
      { label: 'Lower configuration risk', desc: 'Less manual drift and fewer setup errors.', icon: ['M12,3 L19,6 L19,12 C19,16.5 16,19.5 12,21 C8,19.5 5,16.5 5,12 L5,6 Z', 'M9,12 L11,14 L15.5,9'] },
      { label: 'Better scalability', desc: 'The next environment is easier than the last.', icon: ['M9,3 L3,3 L3,9', 'M15,21 L21,21 L21,15', 'M21,3 L15,9', 'M3,21 L9,15'] },
      { label: 'Less dependence on scarce skills', desc: 'Broader teams can consume cloud confidently.', icon: ['M12,4.5 A3.5,3.5 0 1 1 12,11.5 A3.5,3.5 0 1 1 12,4.5 Z', 'M5,20 C5,15.5 8,13 12,13 C16,13 19,15.5 19,20'] },
    ]}
    outcomesClose="Build once. Reuse everywhere."
    pdfHref="/products/asaas-booklet.pdf"
    pdfLabel="aSaaS (أساس) product brief"
    contactIntent="asaas"
  />
</BaseLayout>

<style>
  .gdc-subhead {
    margin-top: 1rem;
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 500;
    color: var(--white-smoke);
  }

  .page-intro__cta {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem 2rem;
  }

  .intro-link {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    text-decoration: none;
    color: inherit;
  }

  .intro-link__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    flex: none;
    border-radius: 9px;
    background: color-mix(in srgb, var(--vivid-sky-blue) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--vivid-sky-blue) 30%, transparent);
    transition: border-color 160ms ease, background-color 160ms ease;
  }

  .intro-link__icon svg {
    width: 1.3rem;
    height: 1.3rem;
    fill: none;
    stroke: var(--vivid-sky-blue);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .intro-link__icon--image img {
    width: 1.4rem;
    height: 1.4rem;
    object-fit: contain;
  }

  /* A nod to Google's own identity for the one link that's literally
     about a Google product — each border side takes one of Google's
     four brand colours, matching the same treatment already used for
     the GDC pillar card icon, rather than this page's sky-blue accent. */
  .intro-link__icon--google {
    background: var(--gunmetal-raised);
    border-style: solid;
    border-width: 2px;
    border-top-color: #ea4335;
    border-right-color: #fbbc04;
    border-bottom-color: #34a853;
    border-left-color: #4285f4;
  }

  .intro-link__text {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .intro-link__label {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-0);
    color: var(--white-smoke);
    transition: color 160ms ease;
  }

  .intro-link__desc {
    color: var(--silver);
    font-size: var(--step--1);
    line-height: 1.4;
  }

  .intro-link:hover .intro-link__icon {
    background: color-mix(in srgb, var(--vivid-sky-blue) 18%, transparent);
    border-color: var(--vivid-sky-blue);
  }

  .intro-link:hover .intro-link__label {
    color: var(--vivid-sky-blue);
  }

  @media (max-width: 560px) {
    .page-intro__cta {
      grid-template-columns: 1fr;
    }
  }
</style>
