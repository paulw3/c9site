---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageIntro from '../../../components/PageIntro.astro';
import CTAButton from '../../../components/CTAButton.astro';

// Draft machine translation, for visual/design review only — pending a
// native-speaker pass. Mirrors src/pages/products/asaas-support.astro
// structure and styles exactly; only the copy and internal hrefs differ.

const resources = [
  { label: 'دليل البدء', href: '/ar/products/asaas-getting-started', desc: 'شرح تفصيلي من الاشتراك وحتى نشر أول منطقة هبوط.' },
  { label: 'طلبات Marketplace', href: 'https://console.cloud.google.com/marketplace/orders', desc: 'عرض وإدارة اشتراكك في أساس، والفوترة، وتفاصيل الخطة.' },
  { label: 'بوابة أساس', href: 'https://asaas.c9ine.com', desc: 'تحقق من حالة حسابك، والاستحقاقات النشطة، وتفاصيل الاشتراك.' },
  { label: 'دعم Google Cloud', href: 'https://cloud.google.com/support', desc: 'للمشكلات المتعلقة ببنية Google Cloud التحتية، أو الفوترة، أو منصة Marketplace.' },
];

const commonIssues = [
  { issue: 'ظهور "لا يوجد اشتراك نشط" في البوابة', solution: 'تأكد من أنك اشتركت عبر Google Cloud Marketplace وأنك مسجل الدخول بنفس حساب Google المستخدم في الشراء.' },
  { issue: 'فشل الاتصال بالمؤسسة', solution: 'تأكد من امتلاكك صلاحيات مسؤول المؤسسة (Organization Administrator) وأن الفوترة مفعّلة على المؤسسة.' },
  { issue: 'فشل إحدى مراحل النشر', solution: 'يوفر المساعد الذكي تفاصيل الخطأ وخطوات الإصلاح. يمكنك إعادة محاولة أي مرحلة فاشلة دون فقدان التقدم.' },
  { issue: 'الحاجة لإعادة تعيين حسابك', solution: 'راسلنا على contact@c9ine.com — يمكننا إعادة تعيين حساب Marketplace الخاص بك لإعادة تشغيل عملية الاشتراك.' },
  { issue: 'أسئلة حول الفوترة أو الفواتير', solution: 'تتم الفوترة عبر Google Cloud. تفقد طلبات Marketplace أو تواصل مع دعم Google Cloud.' },
];

const requestChecklist = [
  'معرّف مؤسسة Google Cloud الخاصة بك',
  'مرحلة النشر التي حدثت فيها المشكلة (إن وجدت)',
  'أي رسائل خطأ ظهرت من المساعد الذكي أو في Google Cloud Console',
  'وصف موجز لما كنت تحاول القيام به وما حدث بدلاً من ذلك',
];
---

<BaseLayout
  title="دعم أساس"
  description="الدعم الخاص بأساس: الدعم عبر البريد الإلكتروني، المشكلات الشائعة وحلولها، ما يجب تضمينه في طلب الدعم، وقنوات الدعم الأخرى."
  locale="ar"
>
  <PageIntro eyebrow="أساس · الدعم">
    <h1>دعم أساس</h1>
    <p class="lede">نحن هنا لمساعدتك في نشر وإدارة مناطق هبوط آمنة على Google Cloud.</p>
    <div class="page-intro__cta">
      <CTAButton href="/ar/contact?intent=asaas" terminalHover>تواصل معنا حول أساس</CTAButton>
    </div>
  </PageIntro>

  <section class="section-tight">
    <div class="container narrow">
      <div class="support-cards">
        <div class="support-card">
          <p class="eyebrow">الدعم عبر البريد الإلكتروني</p>
          <p>للمشكلات التقنية، أو الأسئلة المتعلقة بالحساب، أو الاستفسارات العامة.</p>
          <a class="support-card__link" href="mailto:contact@c9ine.com">contact@c9ine.com</a>
        </div>
        <div class="support-card">
          <p class="eyebrow">وقت الاستجابة</p>
          <p>نسعى للرد على جميع طلبات الدعم خلال <strong>يوم عمل واحد</strong>. تُعطى الأولوية للمشكلات الحرجة.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section-tight section-raised">
    <div class="container narrow">
      <p class="eyebrow">قبل التواصل معنا</p>
      <h2>يمكن حل العديد من الأسئلة الشائعة باستخدام الموارد أدناه</h2>
      <div class="table-wrap">
        <table class="data-table">
          <thead>
            <tr>
              <th>المورد</th>
              <th>الوصف</th>
            </tr>
          </thead>
          <tbody>
            {resources.map((r) => (
              <tr>
                <td><a href={r.href}>{r.label}</a></td>
                <td>{r.desc}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container narrow">
      <p class="eyebrow">المشكلات الشائعة</p>
      <div class="table-wrap">
        <table class="data-table">
          <thead>
            <tr>
              <th>المشكلة</th>
              <th>ماذا تفعل</th>
            </tr>
          </thead>
          <tbody>
            {commonIssues.map((item) => (
              <tr>
                <td><strong>{item.issue}</strong></td>
                <td>{item.solution}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section-tight section-raised">
    <div class="container narrow">
      <p class="eyebrow">ما يجب تضمينه في طلب الدعم</p>
      <h2>لمساعدتنا في حل مشكلتك بسرعة، يرجى تضمين:</h2>
      <ul class="check-list">
        {requestChecklist.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section-tight">
    <div class="container narrow">
      <p class="eyebrow">قنوات دعم إضافية</p>
      <div class="support-cards">
        <div class="support-card">
          <h3>Google Cloud Marketplace</h3>
          <p>استخدم رابط "الدعم" في صفحة قائمة أساس للأسئلة الخاصة بـ Marketplace.</p>
        </div>
        <div class="support-card">
          <h3>استفسارات عامة</h3>
          <p>للمبيعات، أو الشراكات، أو الأسئلة غير التقنية، تفضل بزيارة <a href="/ar/contact">صفحة التواصل</a>.</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-intro__cta {
    margin-top: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .container.narrow {
    max-width: 46rem;
  }

  h2 {
    margin-top: 0.75rem;
  }

  .support-cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .support-card {
    padding: 1.5rem;
    border: 1px solid var(--gunmetal-line);
    border-radius: var(--border-radius);
  }

  .support-card h3 {
    font-size: var(--step-0);
  }

  .support-card p {
    margin-top: 0.6rem;
    color: var(--silver);
    line-height: 1.5;
  }

  .support-card__link {
    display: inline-block;
    margin-top: 0.75rem;
    color: var(--aquamarine);
    font-weight: 600;
  }

  .check-list {
    margin-top: 1.5rem;
    display: grid;
    gap: 0.75rem;
  }

  .check-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.85rem 1rem;
    border: 1px solid var(--gunmetal-line);
    border-radius: var(--border-radius);
    color: var(--silver);
    line-height: 1.5;
    max-width: none;
  }

  .check-list li::before {
    content: '';
    flex: none;
    width: 6px;
    height: 6px;
    margin-top: 0.6rem;
    background: var(--aquamarine);
  }

  .table-wrap {
    margin-top: 2rem;
    overflow-x: auto;
    border: 1px solid var(--gunmetal-line);
    border-radius: var(--border-radius);
  }

  .data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--step--1);
  }

  .data-table th,
  .data-table td {
    padding: 0.85rem 1.1rem;
    text-align: right;
    vertical-align: top;
    max-width: none;
  }

  .data-table thead th {
    background: var(--gunmetal-raised);
    color: var(--aquamarine);
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .data-table tbody tr {
    border-top: 1px solid var(--gunmetal-line);
  }

  .data-table tbody td {
    color: var(--silver);
  }

  .data-table tbody td strong {
    color: var(--white-smoke);
  }

  .data-table a {
    color: var(--aquamarine);
  }

  @media (max-width: 560px) {
    .support-cards {
      grid-template-columns: 1fr;
    }
  }
</style>
