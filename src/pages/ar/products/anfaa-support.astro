---
// Draft machine translation, for visual/design review only — pending a
// native-speaker pass. Mirrors src/pages/products/anfaa-support.astro
// structure and styles exactly; only the copy and internal hrefs differ.
// See that file's comment re: no archived content exists for this page.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageIntro from '../../../components/PageIntro.astro';
import CTAButton from '../../../components/CTAButton.astro';

const requestChecklist = [
  'مزود (مزودو) السحابة والحسابات المعنية',
  'أي رسائل خطأ شاهدتها، أو لقطة شاشة',
  'وصف موجز لما كنت تحاول القيام به وما حدث بدلاً من ذلك',
];
---

<BaseLayout
  title="دعم أنفع"
  description="الدعم الخاص بأنفع: الدعم عبر البريد الإلكتروني، ما يجب تضمينه في طلب الدعم، وقنوات الدعم الأخرى."
  locale="ar"
>
  <PageIntro eyebrow="أنفع · الدعم">
    <h1>دعم أنفع</h1>
    <p class="lede">نحن هنا لمساعدتك على الاستفادة القصوى من منصة أنفع لإدارة التكاليف السحابية متعددة المزودين.</p>
    <div class="page-intro__cta">
      <CTAButton href="/ar/contact?intent=anfaa" terminalHover>تواصل معنا حول أنفع</CTAButton>
    </div>
  </PageIntro>

  <section class="section-tight">
    <div class="container narrow">
      <div class="support-cards">
        <div class="support-card">
          <p class="eyebrow">الدعم عبر البريد الإلكتروني</p>
          <p>للمشكلات التقنية، أو الأسئلة المتعلقة بالحساب، أو الاستفسارات العامة.</p>
          <a class="support-card__link" href="mailto:contact@c9ine.com">contact@c9ine.com</a>
        </div>
        <div class="support-card">
          <p class="eyebrow">وقت الاستجابة</p>
          <p>نسعى للرد على جميع طلبات الدعم خلال <strong>يوم عمل واحد</strong>. تُعطى الأولوية للمشكلات الحرجة.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section-tight section-raised">
    <div class="container narrow">
      <p class="eyebrow">ما يجب تضمينه في طلب الدعم</p>
      <h2>لمساعدتنا في حل مشكلتك بسرعة، يرجى تضمين:</h2>
      <ul class="check-list">
        {requestChecklist.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section-tight">
    <div class="container narrow">
      <p class="eyebrow">قنوات دعم إضافية</p>
      <div class="support-cards">
        <div class="support-card">
          <h3>موجز المنتج</h3>
          <p>اطّلع على <a href="/ar/products/anfaa">صفحة منتج أنفع</a> أو حمّل <a href="/products/anfaa-booklet.pdf">الموجز الكامل للمنتج</a>.</p>
        </div>
        <div class="support-card">
          <h3>استفسارات عامة</h3>
          <p>للمبيعات، أو الشراكات، أو الأسئلة غير التقنية، تفضل بزيارة <a href="/ar/contact">صفحة التواصل</a>.</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-intro__cta {
    margin-top: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .container.narrow {
    max-width: 46rem;
  }

  h2 {
    margin-top: 0.75rem;
  }

  .support-cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .support-card {
    padding: 1.5rem;
    border: 1px solid var(--gunmetal-line);
    border-radius: var(--border-radius);
  }

  .support-card h3 {
    font-size: var(--step-0);
  }

  .support-card p {
    margin-top: 0.6rem;
    color: var(--silver);
    line-height: 1.5;
  }

  .support-card p a {
    color: var(--aquamarine);
  }

  .support-card__link {
    display: inline-block;
    margin-top: 0.75rem;
    color: var(--aquamarine);
    font-weight: 600;
  }

  .check-list {
    margin-top: 1.5rem;
    display: grid;
    gap: 0.75rem;
  }

  .check-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.85rem 1rem;
    border: 1px solid var(--gunmetal-line);
    border-radius: var(--border-radius);
    color: var(--silver);
    line-height: 1.5;
    max-width: none;
  }

  .check-list li::before {
    content: '';
    flex: none;
    width: 6px;
    height: 6px;
    margin-top: 0.6rem;
    background: var(--aquamarine);
  }

  @media (max-width: 560px) {
    .support-cards {
      grid-template-columns: 1fr;
    }
  }
</style>
