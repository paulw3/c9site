---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import ContactForm from '../../components/ContactForm.astro';
import { t } from '../../i18n/ui';

// Draft machine translation, for visual/design review only — pending a
// native-speaker pass. Mirrors src/pages/contact.astro structure and
// styles exactly; only the copy and internal hrefs differ.

const params = Astro.url.searchParams;
const defaultIntent = params.get('intent') === 'gdc-pilot' ? 'gdc-pilot' : undefined;
---

<BaseLayout
  title="تواصل معنا"
  description="سواء كنت تخطط لترحيل أو تبدأ رحلتك مع السحابة الموزعة من جوجل، أخبرنا بموقعك الحالي وسنكمل الطريق معك."
  locale="ar"
>
  <PageIntro eyebrow="تواصل معنا">
    <h1>تواصل معنا.</h1>
    <p class="lede">
      سواء كنت تخطط لترحيل أو تبدأ رحلتك مع السحابة الموزعة من جوجل، أخبرنا بموقعك الحالي وسنكمل
      الطريق معك.
    </p>
  </PageIntro>

  <section class="section section-ge4">
    <div class="container contact-grid">
      <ContactForm defaultIntent={defaultIntent} locale="ar" />

      <div class="contact-details">
        <h2>زرنا</h2>
        <address>
          {t('ar', 'footerAddress1')}<br />
          {t('ar', 'footerAddress2')}<br />
          {t('ar', 'footerAddress3')}
        </address>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 20rem;
    gap: clamp(2.5rem, 6vw, 5rem);
  }

  .contact-details h2 {
    font-size: var(--step-1);
  }

  .contact-details address {
    margin-top: 1rem;
    font-style: normal;
    color: var(--silver);
    line-height: 1.7;
  }

  @media (max-width: 860px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
