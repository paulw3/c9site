---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import CTAButton from '../../components/CTAButton.astro';

// Draft machine translation, for visual/design review only — pending a
// native-speaker pass. Mirrors src/pages/production-readiness.astro
// structure and styles exactly; only the copy and internal hrefs differ.
---

<BaseLayout
  title="جاهزية الإنتاج والتدقيق المستقل لـ GCP"
  description="مراجعة وتدقيق مستقلان لبيئات Google Cloud للبنوك وشركات التقنية المالية والجهات التنظيمية والمؤسسات الخاضعة للتنظيم، مع نتائج واضحة وإجراءات معالجة قبل تفعيل بيئة الإنتاج."
  locale="ar"
>
  <PageIntro eyebrow="جاهزية الإنتاج والتدقيق المستقل لـ GCP">
    <h1>رأي ثانٍ مستقل قبل الإطلاق.</h1>
    <p class="lede">
      نراجع وندقق بشكل مستقل بيئات Google Cloud للبنوك وشركات التقنية المالية والجهات التنظيمية
      والمؤسسات الخاضعة للتنظيم: نقيّم البنية والأمان والامتثال والمرونة والتشغيل، مع نتائج واضحة
      وإجراءات معالجة قبل تفعيل بيئة الإنتاج.
    </p>
    <div class="page-intro__cta">
      <CTAButton href="/ar/contact?intent=assurance" terminalHover>تواصل معنا بخصوص تقييم</CTAButton>
    </div>
  </PageIntro>

  <!-- 01 · لماذا مستقل -->
  <section class="section-tight section-raised intro-gap-fix">
    <div class="container">
      <div class="problem-layout">
        <div class="problem-layout__intro">
          <p class="eyebrow">لماذا مستقل</p>
          <h2>الفريق الذي بنى الحل ليس الفريق المناسب لاعتماده.</h2>
          <p class="lede">
            ليس لأن العمل سيئ، بل لأن لا أحد يستطيع تصحيح امتحان نفسه. المراجعة المستقلة تكتشف ما
            يصعب على فريق قريب من البناء ملاحظته.
          </p>
          <p class="pull-statement">
            رأي ثانٍ قبل الإطلاق أقل تكلفة بكثير من اكتشاف المشكلة في بيئة الإنتاج.
          </p>
        </div>

        <ol class="editorial-list">
          <li>
            <span class="editorial-list__num">01</span>
            <div>
              <h4>بنيناه نحن أو غيرنا</h4>
              <p>نراجع البيئات التي سلّمناها، والبيئات التي بناها أي طرف آخر.</p>
            </div>
          </li>
          <li>
            <span class="editorial-list__num">02</span>
            <div>
              <h4>توقّع تنظيمي</h4>
              <p>مجالس الإدارة والجهات التنظيمية تتوقع بشكل متزايد اعتمادا مستقلا قبل الإطلاق.</p>
            </div>
          </li>
          <li>
            <span class="editorial-list__num">03</span>
            <div>
              <h4>نظرة جديدة، لا افتراضات قديمة</h4>
              <p>مشكلات تبقى غير مرئية لفريق أمضى شهورا داخل عملية البناء.</p>
            </div>
          </li>
          <li>
            <span class="editorial-list__num">04</span>
            <div>
              <h4>دليل، لا مجرد طمأنة</h4>
              <p>سجل موثّق وقابل للدفاع عنه للتدقيق والحوكمة، لا مجرد تأكيد شفهي.</p>
            </div>
          </li>
        </ol>
      </div>
    </div>
  </section>

  <!-- 02 · ما الذي نقيّمه -->
  <section class="section-tight">
    <div class="container">
      <div class="standardise-intro">
        <p class="eyebrow">ما الذي نقيّمه</p>
        <h2>ستة مجالات، برؤية مستقلة واحدة.</h2>
        <p class="lede">يغطي كل تقييم نفس النطاق بعمق، أيا كان المجال الأكثر أهمية لبيئتك.</p>
      </div>

      <ul class="foundations-grid">
        <li>
          <span class="foundations-grid__icon">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <rect x="9" y="4" width="6" height="3" rx="1" />
              <rect x="6" y="10" width="12" height="3" rx="1" />
              <rect x="3" y="16" width="18" height="3" rx="1" />
            </svg>
          </span>
          <h4>البنية</h4>
          <p>هل التصميم سليم ومناسب لما يُفترض أن يحمله فعليا</p>
        </li>
        <li>
          <span class="foundations-grid__icon">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M12,3 L19,6 L19,12 C19,16.5 16,19.5 12,21 C8,19.5 5,16.5 5,12 L5,6 Z" />
              <path d="M9,12 L11,14 L15.5,9" />
            </svg>
          </span>
          <h4>الأمان</h4>
          <p>ضوابط مُفعّلة فعليا، لا موثّقة فقط</p>
        </li>
        <li>
          <span class="foundations-grid__icon">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M6,3 L15,3 L19,7 L19,21 L6,21 Z" />
              <path d="M15,3 L15,7 L19,7" />
              <path d="M9,12 L16,12 M9,15.5 L16,15.5 M9,9 L12,9" />
            </svg>
          </span>
          <h4>الامتثال</h4>
          <p>مطابَق مع SAMA وNCA ECC والضوابط التي تنطبق عليك</p>
        </li>
        <li>
          <span class="foundations-grid__icon">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M4,10 A8,8 0 1 1 6.2,16.2" />
              <path d="M4,10 L1.7,6.8 M4,10 L7.3,11.3" />
              <path d="M12,7 L12,12 L15.5,14" />
            </svg>
          </span>
          <h4>المرونة</h4>
          <p>نسخ احتياطي وتحويل تلقائي مُختبران، لا مُفترضان</p>
        </li>
        <li>
          <span class="foundations-grid__icon">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <circle cx="12" cy="12" r="3" />
              <path d="M12,3 L12,6 M12,18 L12,21 M3,12 L6,12 M18,12 L21,12 M5.6,5.6 L7.8,7.8 M16.2,16.2 L18.4,18.4 M5.6,18.4 L7.8,16.2 M16.2,7.8 L18.4,5.6" />
            </svg>
          </span>
          <h4>التشغيل</h4>
          <p>مراقبة، وأدلة تشغيل، وجاهزية دعم لليوم الثاني</p>
        </li>
        <li>
          <span class="foundations-grid__icon">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M5,21 L5,3" />
              <path d="M5,4 L18,4 L15,8 L18,12 L5,12" />
            </svg>
          </span>
          <h4>جاهزية الإطلاق</h4>
          <p>قرار واضح بالإطلاق أو التأجيل، لا انطباع غامض بأن كل شيء على ما يرام</p>
        </li>
      </ul>

      <p class="pull-statement foundations-grid__statement">
        نفس الصرامة سواء بنينا البيئة نحن أو غيرنا.
      </p>
    </div>
  </section>

  <!-- 03 · كيف نعمل -->
  <section class="section-tight section-raised">
    <div class="container">
      <div class="works-intro">
        <p class="eyebrow">كيف نعمل</p>
        <h2>ثلاث خطوات من المراجعة إلى الحل.</h2>
        <p class="lede">تعاون مستقل بداية ونهاية واضحتين، لا تدقيق مفتوح بلا سقف زمني.</p>
      </div>

      <div class="works-timeline">
        <div class="works-timeline__line" aria-hidden="true"></div>
        <ol class="works-timeline__steps works-timeline__steps--three">
          <li>
            <span class="works-timeline__node">01</span>
            <h4>تقييم</h4>
            <p>مراجعة مستقلة وفق معايير البنية والأمان والامتثال والمرونة والتشغيل.</p>
          </li>
          <li>
            <span class="works-timeline__node">02</span>
            <h4>تقرير</h4>
            <p>نتائج واضحة ومصنّفة حسب الخطورة، مكتوبة لتناسب الفرق الهندسية والقيادة معا.</p>
          </li>
          <li>
            <span class="works-timeline__node">03</span>
            <h4>معالجة</h4>
            <p>إجراءات معالجة محددة، يتم التحقق منها قبل تفعيل بيئة الإنتاج.</p>
          </li>
        </ol>
      </div>
    </div>
  </section>

  <!-- 04 · لمن هذه الخدمة -->
  <section class="section-tight">
    <div class="container">
      <div class="belief-layout">
        <p class="eyebrow">لمن هذه الخدمة</p>
        <h2 class="belief-layout__heading">رأي ثانٍ، لا علاقة تعاقدية ثانية.</h2>
        <p class="lede belief-layout__primary">
          بنوك، وشركات تقنية مالية، وجهات تنظيمية، ومؤسسات أخرى خاضعة للتنظيم تشغّل Google Cloud،
          أيا كان الفريق الذي بناها. تعاون مستقل قائم بذاته، لا عرضا إضافيا على عمل قيد التنفيذ
          بالفعل.
        </p>
        <p class="belief-layout__closing">
          نفس النتائج وإجراءات المعالجة في الحالتين: سجل مستقل وقابل للدفاع عنه لمجلس إدارتك
          وجهتك التنظيمية قبل الإطلاق.
        </p>
      </div>
    </div>
  </section>

  <!-- دعوة ختامية -->
  <section class="cta-band">
    <div class="container cta-band__inner">
      <h2>هل أنت مستعد لرأي ثانٍ مستقل قبل الإطلاق؟</h2>
      <div class="cta-band__action">
        <CTAButton href="/ar/contact?intent=assurance" variant="outline" terminalHover>تواصل معنا بخصوص تقييم</CTAButton>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .intro-gap-fix {
    padding-top: clamp(1rem, 2vw, 1.5rem);
  }

  .pull-statement {
    padding-inline-start: 1.15rem;
    border-inline-start: 2px solid var(--aquamarine);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-1);
    line-height: 1.35;
    color: var(--white-smoke);
  }

  /* ---- 01 · لماذا مستقل --------------------------------------- */

  .problem-layout {
    display: grid;
    grid-template-columns: minmax(0, 21rem) 1fr;
    gap: clamp(2.5rem, 6vw, 5.5rem);
    align-items: start;
  }

  .problem-layout__intro h2 {
    margin-top: 0.75rem;
  }

  .problem-layout__intro .lede {
    margin-top: 1rem;
  }

  .problem-layout__intro .pull-statement {
    margin-top: 2.25rem;
  }

  .editorial-list {
    display: flex;
    flex-direction: column;
  }

  .editorial-list li {
    display: flex;
    gap: clamp(1.25rem, 3vw, 2rem);
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--gunmetal-line);
  }

  .editorial-list li:first-child {
    padding-top: 0;
  }

  .editorial-list li:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .editorial-list__num {
    flex-shrink: 0;
    width: 2.75rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-2);
    line-height: 1.15;
    color: color-mix(in srgb, var(--aquamarine) 55%, var(--gunmetal-line));
  }

  .editorial-list h4 {
    font-size: var(--step-0);
    color: var(--white-smoke);
  }

  .editorial-list p {
    margin-top: 0.4rem;
    color: var(--silver);
    font-size: var(--step--1);
    line-height: 1.5;
  }

  @media (max-width: 850px) {
    .problem-layout {
      grid-template-columns: 1fr;
    }
  }

  /* ---- 02 · ما الذي نقيّمه ------------------------------------------ */

  .standardise-intro {
    max-width: 36rem;
  }

  .standardise-intro h2 {
    margin-top: 0.75rem;
  }

  .standardise-intro .lede {
    margin-top: 1rem;
  }

  .foundations-grid {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    background: var(--gunmetal-line);
    border: 1px solid var(--gunmetal-line);
    border-radius: var(--border-radius);
    overflow: hidden;
  }

  .foundations-grid li {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: clamp(1.5rem, 3vw, 1.85rem);
    background: var(--gunmetal);
  }

  .foundations-grid__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 8px;
    background: color-mix(in srgb, var(--aquamarine) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--aquamarine) 28%, transparent);
  }

  .foundations-grid__icon svg {
    width: 1.35rem;
    height: 1.35rem;
    fill: none;
    stroke: var(--aquamarine);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .foundations-grid h4 {
    font-size: var(--step-0);
    color: var(--white-smoke);
  }

  .foundations-grid p {
    color: var(--silver);
    font-size: var(--step--1);
    line-height: 1.5;
  }

  .foundations-grid__statement {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    max-width: 46rem;
  }

  @media (max-width: 900px) {
    .foundations-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .foundations-grid {
      grid-template-columns: 1fr;
    }
  }

  /* ---- 03 · كيف نعمل ------------------------------------------------- */

  .works-intro {
    max-width: 36rem;
  }

  .works-intro h2 {
    margin-top: 0.75rem;
  }

  .works-intro .lede {
    margin-top: 1rem;
  }

  .works-timeline {
    position: relative;
    margin-top: clamp(3rem, 6vw, 4.5rem);
  }

  .works-timeline__line {
    position: absolute;
    top: 1.1rem;
    inset-inline-start: 1.1rem;
    inset-inline-end: 1.1rem;
    height: 1px;
    background: var(--gunmetal-line);
  }

  .works-timeline__steps {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  .works-timeline__steps--three {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .works-timeline__steps li {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .works-timeline__node {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--gunmetal-raised);
    border: 1px solid var(--aquamarine);
    color: var(--aquamarine);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step--1);
  }

  .works-timeline__steps h4 {
    color: var(--white-smoke);
    font-size: var(--step-0);
  }

  .works-timeline__steps p {
    color: var(--silver);
    font-size: var(--step--1);
    line-height: 1.45;
  }

  @media (max-width: 800px) {
    .works-timeline__line {
      display: none;
    }

    .works-timeline__steps,
    .works-timeline__steps--three {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  /* ---- 04 · لمن هذه الخدمة -------------------------------------------- */

  .belief-layout {
    max-width: 40rem;
    margin-inline: auto;
    text-align: center;
  }

  .belief-layout > .eyebrow {
    margin-inline: auto;
  }

  .belief-layout__heading {
    margin-top: 0.85rem;
    font-size: var(--step-4);
  }

  .belief-layout__primary {
    margin-top: 1.25rem;
    margin-inline: auto;
    max-width: 32rem;
  }

  .belief-layout__closing {
    margin-top: 2rem;
    margin-inline: auto;
    max-width: 28rem;
    padding-top: 2rem;
    border-top: 1px solid var(--gunmetal-line);
    color: var(--silver);
    font-size: var(--step--1);
    line-height: 1.6;
  }

  /* ---- دعوة ختامية ----------------------------------------------------- */

  .cta-band {
    background: var(--aquamarine);
    padding-block: clamp(1.5rem, 3.5vw, 2.5rem);
  }

  .cta-band__inner {
    text-align: center;
  }

  .cta-band h2 {
    max-width: 42rem;
    margin-inline: auto;
    font-size: var(--step-2);
    color: var(--gunmetal);
  }

  .cta-band__action {
    margin-top: clamp(1.1rem, 2.5vw, 1.5rem);
    display: flex;
    justify-content: center;
  }

  .cta-band__action :global(.btn) {
    border-color: var(--gunmetal);
    color: var(--gunmetal);
  }

  .cta-band__action :global(.btn:hover) {
    background: var(--gunmetal);
    color: var(--aquamarine);
    border-color: var(--gunmetal);
  }
</style>
