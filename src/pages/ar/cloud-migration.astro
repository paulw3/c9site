---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import ProofPoint from '../../components/ProofPoint.astro';
import CTAButton from '../../components/CTAButton.astro';

// Draft machine translation, for visual/design review only — pending a
// native-speaker pass. Mirrors src/pages/cloud-migration.astro structure
// and styles exactly; only the copy and internal hrefs differ.
---

<BaseLayout
  title="الترحيل والتحول السحابي"
  description="نصمم الحالة المستهدفة، وننفذها عبر مراحل محكومة، ونشغّلها معك بعد الإطلاق، عبر كل جانب يتأثر بحمل العمل، وليس فقط منطقة الهبوط."
  locale="ar"
>
  <PageIntro eyebrow="الترحيل والتحول السحابي">
    <h1>نصمم. نهندس. نشغّل.</h1>
    <p class="lede">
      سواء كنت تنتقل من بيئتك المحلية أو من مزوّد سحابي آخر، نصمم الحالة المستهدفة، وننفذها عبر
      مراحل محكومة، ونشغّلها معك بعد الإطلاق. عبر كل جانب يتأثر بحمل العمل، وليس فقط منطقة الهبوط.
    </p>
    <div class="page-intro__cta">
      <CTAButton href="/ar/contact">تواصل معنا بخصوص ترحيلك</CTAButton>
    </div>
  </PageIntro>

  <section class="section-tight section-raised intro-gap-fix">
    <div class="container">
      <div class="design-layout">
        <div class="design-layout__intro">
          <p class="eyebrow">التصميم</p>
          <h2>حالة مستهدفة واحدة. كل نطاق، مخطط له معا.</h2>
          <p class="lede">
            نرسم منطقة الهبوط المستهدفة قبل نقل أي حمل عمل، باستخدام Migration Center من جوجل
            لتقييم البيئة والتخطيط لها.
          </p>
          <p class="pull-statement">
            يصمّم الأمان منذ اليوم الأول، لا أن يضاف لاحقا بعد اكتمال البنية.
          </p>
        </div>

        <ul class="editorial-list">
          <li>
            <span class="editorial-list__icon">
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <rect x="9" y="4" width="6" height="3" rx="1" />
                <rect x="6" y="10" width="12" height="3" rx="1" />
                <rect x="3" y="16" width="18" height="3" rx="1" />
              </svg>
            </span>
            <div>
              <h4>الأساس</h4>
              <p>بنية المؤسسة والسياسات والفوترة، تحسم مرة واحدة، لا تعاد صياغتها مع كل مشروع.</p>
            </div>
          </li>
          <li>
            <span class="editorial-list__icon">
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <circle cx="4" cy="12" r="1.8" />
                <circle cx="20" cy="12" r="1.8" />
                <path d="M6,12 L9,12" />
                <path d="M15,12 L18,12" />
                <rect x="9" y="9" width="6" height="6" rx="1.5" />
                <path d="M10.5,9 L10.5,7.2 A1.5,1.5 0 0 1 13.5,7.2 L13.5,9" />
              </svg>
            </span>
            <div>
              <h4>الشبكات والهوية</h4>
              <p>الاتصال والوصول مصمّمان معا، بحيث لا يكون نموذج Zero Trust إضافة لاحقة.</p>
            </div>
          </li>
          <li>
            <span class="editorial-list__icon">
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M12,3 L19,6 L19,12 C19,16.5 16,19.5 12,21 C8,19.5 5,16.5 5,12 L5,6 Z" />
                <path d="M9,12 L11,14 L15.5,9" />
              </svg>
            </span>
            <div>
              <h4>الأمان والامتثال</h4>
              <p>التشفير والضوابط متوافقة مع SAMA وNCA ECC وPDPL منذ البداية.</p>
            </div>
          </li>
          <li>
            <span class="editorial-list__icon">
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <rect x="7" y="7" width="10" height="10" rx="1.5" />
                <path d="M9,3.5 L9,7 M12,3.5 L12,7 M15,3.5 L15,7" />
                <path d="M9,17 L9,20.5 M12,17 L12,20.5 M15,17 L15,20.5" />
                <path d="M3.5,9 L7,9 M3.5,12 L7,12 M3.5,15 L7,15" />
                <path d="M17,9 L20.5,9 M17,12 L20.5,12 M17,15 L20.5,15" />
              </svg>
            </span>
            <div>
              <h4>البيانات والحوسبة</h4>
              <p>المنصة التي ستعمل عليها أحمال عملك فعليا، بالحجم المناسب لبيئتك.</p>
            </div>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <div class="standardise-intro">
        <p class="eyebrow">الهندسة</p>
        <h2>مراحل محكومة، لا نقل مباشر.</h2>
        <p class="lede">
          يعمل مصنع الترحيل عبر كل النطاقات في آن واحد. يتحقق من الأمان قبل انتقال كل مرحلة، لا
          بعدها.
        </p>
      </div>

      <ul class="foundations-grid">
        <li>
          <span class="foundations-grid__icon">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <rect x="4" y="4" width="12" height="12" rx="2" />
              <rect x="8" y="8" width="12" height="12" rx="2" />
            </svg>
          </span>
          <h4>الحاويات والحوسبة</h4>
          <p>تدار عبر GKE، مع مسار واضح للأجهزة الافتراضية وCloud Run وFunctions</p>
        </li>
        <li>
          <span class="foundations-grid__icon">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <ellipse cx="12" cy="5" rx="7" ry="2.5" />
              <path d="M5,5 L5,19 C5,20.4 8.1,21.5 12,21.5 C15.9,21.5 19,20.4 19,19 L19,5" />
              <path d="M5,12 C5,13.4 8.1,14.5 12,14.5 C15.9,14.5 19,13.4 19,12" />
            </svg>
          </span>
          <h4>قواعد البيانات</h4>
          <p>ترحّل مع توفر عال مدمج، لا يضاف بعد التحول</p>
        </li>
        <li>
          <span class="foundations-grid__icon">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <circle cx="4" cy="12" r="2" />
              <circle cx="12" cy="12" r="2" />
              <circle cx="20" cy="12" r="2" />
              <path d="M6,12 L10,12" />
              <path d="M14,12 L18,12" />
            </svg>
          </span>
          <h4>البيانات والتكامل</h4>
          <p>مسارات بيانات تتحرك مع حمل العمل، لا تلحق به</p>
        </li>
        <li>
          <span class="foundations-grid__icon">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M2,12 C5,6 19,6 22,12 C19,18 5,18 2,12 Z" />
              <circle cx="12" cy="12" r="2.5" />
            </svg>
          </span>
          <h4>المراقبة والأمان</h4>
          <p>التسجيل والمراقبة وكشف التهديدات جاهزة قبل الإطلاق، لا تدقّق بعده</p>
        </li>
        <li>
          <span class="foundations-grid__icon">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M4,10 A8,8 0 1 1 6.2,16.2" />
              <path d="M4,10 L1.7,6.8 M4,10 L7.3,11.3" />
              <path d="M12,7 L12,12 L15.5,14" />
            </svg>
          </span>
          <h4>النسخ الاحتياطي والتعافي من الكوارث</h4>
          <p>التعافي مختبر قبل الحاجة إليه، لا لأول مرة في بيئة الإنتاج</p>
        </li>
        <li>
          <span class="foundations-grid__icon">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <circle cx="12" cy="5" r="2" />
              <circle cx="5" cy="18" r="2" />
              <circle cx="19" cy="18" r="2" />
              <path d="M12,7 L6.5,16.3" />
              <path d="M12,7 L17.5,16.3" />
            </svg>
          </span>
          <h4>الشبكات وواجهات البرمجة</h4>
          <p>اتصال محكوم بين الخدمات، ضمن المرحلة، لا بعدها</p>
        </li>
      </ul>

      <p class="pull-statement foundations-grid__statement">
        تجربة أولا. معايير دخول وخروج واضحة عند كل بوابة. البنية التحتية ككود منذ اليوم الأول،
        بتسريع من aSaaS (أساس)، أداة الأتمتة الخاصة بنا المتوفرة على Marketplace.
      </p>
    </div>
  </section>

  <section class="section-tight section-raised">
    <div class="container">
      <div class="belief-layout">
        <p class="eyebrow">التشغيل</p>
        <h2 class="belief-layout__heading">نسلّمك المفاتيح.</h2>
        <p class="lede belief-layout__primary">
          توثيق، ونقل معرفة، ودعم مكثف بعد الإطلاق، وانتقال مدار إلى الاستقرار، حتى يتمكن فريقك من
          تشغيل ما بنيناه دوننا.
        </p>
        <p class="belief-layout__closing">
          لا تملك قيادة أمنية داخلية؟ نستمر معك كخدمة CISO-as-a-Service، مبنية على عقدين من
          القيادة الأمنية في بنوك عالمية.
        </p>
      </div>
    </div>
  </section>

  <section class="section-tight section-raised">
    <div class="container">
      <div class="products-intro">
        <p class="eyebrow">منتجاتنا</p>
        <h2>منتجان ولدا من واقع التنفيذ، متاحان الآن بشكل مستقل.</h2>
        <p class="lede">
          نشأ كلاهما من مشاريع ترحيل وGDC حقيقية، ثم أصبحا قابلين للتكرار بما يكفي لتحويلهما إلى
          منتج. تسرّع aSaaS بالفعل مرحلة الهندسة أعلاه؛ وتعمل ANFAA بشكل مستقل عن أي تعاون مع
          C-9INE.
        </p>
      </div>

      <div class="products-grid">
        <article class="product-card product-card--anfaa">
          <div class="product-card__head">
            <span class="product-card__mark">ANFAA</span>
            <span class="product-card__tag mono-tag">إدارة مالية سحابية متعددة المزودين</span>
          </div>
          <p class="product-card__statement">يجب أن تخلق السحابة قيمة، لا أن تكون مجرد تكلفة.</p>
          <p class="product-card__desc">
            تحوّل إنفاق السحابة إلى انضباط تشغيلي مستمر لإدارة التكاليف: رؤية، وملكية، وتحسين،
            وتحكم، عبر كل مزوّد تعمل معه.
          </p>
          <ul class="product-card__outcomes">
            <li>رؤية أوضح للإنفاق عبر كل مزوّد</li>
            <li>مساءلة أوضح من المالية إلى الهندسة</li>
            <li>ميزانيات وضوابط مدمجة في القرارات اليومية</li>
          </ul>
          <div class="product-card__footer">
            <span class="product-card__badge mono-tag">متوفر على Google Cloud Marketplace</span>
            <a class="product-card__link" href="/ar/resources/anfaa">اعرف المزيد</a>
          </div>
        </article>

        <article class="product-card product-card--asaas">
          <div class="product-card__head">
            <span class="product-card__mark">aSaaS</span>
            <span class="product-card__tag mono-tag">مشغّل سحابي ذكي</span>
          </div>
          <p class="product-card__statement">لا ينبغي لأساسيات السحابة أن تبطئ الابتكار.</p>
          <p class="product-card__desc">
            تلتقط معايير السحابة المعتمدة مرة واحدة، ثم تحوّلها إلى تجربة تسليم موجهة وقابلة
            للتكرار (نفس الأتمتة التي تقف خلف مرحلة الهندسة أعلاه).
          </p>
          <ul class="product-card__outcomes">
            <li>قيمة أسرع مع كل بيئة جديدة</li>
            <li>أنماط معتمدة وثابتة تعاد استخدامها بين الفرق</li>
            <li>اعتماد أقل على متخصصي السحابة النادرين</li>
          </ul>
          <div class="product-card__footer">
            <span class="product-card__badge mono-tag">متوفر على Google Cloud Marketplace</span>
            <a class="product-card__link" href="/ar/resources/asaas">اعرف المزيد</a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <ProofPoint eyebrow="لا ارتباط بمزوّد واحد">
        يتم تسليم الكود والمخططات والأدلة والتوثيق إلى مستودعاتك الخاصة. وعند الانتهاء، يمكن
        لفريقك تشغيل ما بنيناه دون الاعتماد علينا لإبقائه يعمل.
      </ProofPoint>
      <div class="page-cta">
        <CTAButton href="/ar/contact">تواصل معنا بخصوص ترحيلك</CTAButton>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .intro-gap-fix {
    padding-top: clamp(1rem, 2vw, 1.5rem);
  }

  .page-cta {
    margin-top: 2.5rem;
  }

  .design-layout {
    display: grid;
    grid-template-columns: minmax(0, 21rem) 1fr;
    gap: clamp(2.5rem, 6vw, 5.5rem);
    align-items: start;
  }

  .design-layout__intro h2 {
    margin-top: 0.75rem;
    font-size: var(--step-2);
  }

  .design-layout__intro .lede {
    margin-top: 1rem;
  }

  .design-layout__intro .pull-statement {
    margin-top: 2.25rem;
  }

  .editorial-list {
    display: flex;
    flex-direction: column;
  }

  .editorial-list li {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--gunmetal-line);
  }

  .editorial-list li:first-child {
    padding-top: 0;
  }

  .editorial-list li:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .editorial-list__icon {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    margin-top: 0.1rem;
    border-radius: 8px;
    background: color-mix(in srgb, var(--aquamarine) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--aquamarine) 28%, transparent);
  }

  .editorial-list__icon svg {
    width: 1.1rem;
    height: 1.1rem;
    fill: none;
    stroke: var(--aquamarine);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .editorial-list h4 {
    font-size: var(--step-0);
    color: var(--white-smoke);
  }

  .editorial-list p {
    margin-top: 0.4rem;
    color: var(--silver);
    font-size: var(--step--1);
    line-height: 1.5;
  }

  @media (max-width: 850px) {
    .design-layout {
      grid-template-columns: 1fr;
    }
  }

  .pull-statement {
    padding-inline-start: 1.15rem;
    border-inline-start: 2px solid var(--aquamarine);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-1);
    line-height: 1.35;
    color: var(--white-smoke);
  }

  .standardise-intro {
    max-width: 36rem;
  }

  .standardise-intro h2 {
    margin-top: 0.75rem;
    font-size: var(--step-2);
  }

  .standardise-intro .lede {
    margin-top: 1rem;
  }

  .foundations-grid {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    background: var(--gunmetal-line);
    border: 1px solid var(--gunmetal-line);
    border-radius: var(--border-radius);
    overflow: hidden;
  }

  .foundations-grid li {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: clamp(1.5rem, 3vw, 1.85rem);
    background: var(--gunmetal);
  }

  .foundations-grid__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 8px;
    background: color-mix(in srgb, var(--aquamarine) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--aquamarine) 28%, transparent);
  }

  .foundations-grid__icon svg {
    width: 1.35rem;
    height: 1.35rem;
    fill: none;
    stroke: var(--aquamarine);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .foundations-grid h4 {
    font-size: var(--step-0);
    color: var(--white-smoke);
  }

  .foundations-grid p {
    color: var(--silver);
    font-size: var(--step--1);
    line-height: 1.5;
  }

  .foundations-grid__statement {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    max-width: 46rem;
  }

  @media (max-width: 900px) {
    .foundations-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .foundations-grid {
      grid-template-columns: 1fr;
    }
  }

  .belief-layout {
    max-width: 40rem;
    margin-inline: auto;
    text-align: center;
  }

  .belief-layout > .eyebrow {
    margin-inline: auto;
  }

  .belief-layout__heading {
    margin-top: 0.85rem;
    font-size: var(--step-4);
  }

  .belief-layout__primary {
    margin-top: 1.25rem;
    margin-inline: auto;
    max-width: 32rem;
  }

  .belief-layout__closing {
    margin-top: 2rem;
    margin-inline: auto;
    max-width: 28rem;
    padding-top: 2rem;
    border-top: 1px solid var(--gunmetal-line);
    color: var(--silver);
    font-size: var(--step--1);
    line-height: 1.6;
  }

  .products-intro {
    max-width: 40rem;
  }

  .products-intro h2 {
    margin-top: 0.75rem;
  }

  .products-intro .lede {
    margin-top: 1rem;
  }

  .products-grid {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 2rem);
  }

  .product-card {
    display: flex;
    flex-direction: column;
    padding: clamp(1.5rem, 3vw, 2rem);
    border-top: 2px solid var(--accent, var(--aquamarine));
    background: var(--gunmetal-raised);
  }

  .product-card--anfaa {
    --accent: var(--aquamarine);
  }

  .product-card--asaas {
    --accent: var(--vivid-sky-blue);
  }

  .product-card__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.75rem;
  }

  .product-card__mark {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-2);
    color: var(--white-smoke);
  }

  .product-card__tag {
    color: var(--accent, var(--aquamarine));
  }

  .product-card__statement {
    margin-top: 1.25rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-0);
    color: var(--white-smoke);
    line-height: 1.3;
  }

  .product-card__desc {
    margin-top: 0.75rem;
    color: var(--silver);
    font-size: var(--step--1);
    line-height: 1.5;
  }

  .product-card__outcomes {
    margin-top: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .product-card__outcomes li {
    padding-inline-start: 1.25rem;
    position: relative;
    color: var(--silver);
    font-size: var(--step--1);
    line-height: 1.4;
  }

  .product-card__outcomes li::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    top: 0.5em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent, var(--aquamarine));
  }

  .product-card__footer {
    margin-top: auto;
    padding-top: 1.25rem;
    border-top: 1px solid var(--gunmetal-line);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .product-card__badge {
    color: var(--silver);
  }

