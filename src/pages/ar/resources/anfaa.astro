---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageIntro from '../../../components/PageIntro.astro';
import ProductBrief from '../../../components/ProductBrief.astro';
import CTAButton from '../../../components/CTAButton.astro';

// Draft machine translation, for visual/design review only — pending a
// native-speaker pass. Mirrors src/pages/resources/anfaa.astro structure
// and styles exactly; only the copy and internal hrefs differ.
---

<BaseLayout
  title="ANFAA: إدارة مالية سحابية متعددة المزودين"
  description="تحوّل ANFAA إنفاق السحابة إلى انضباط تشغيلي مستمر لإدارة التكاليف: رؤية، وملكية، وتحسين، وتحكم، عبر كل مزوّد تعمل معه."
  locale="ar"
>
  <PageIntro eyebrow="الموارد · نبذة المنتج">
    <h1>يجب أن تخلق السحابة قيمة، لا أن تكون مجرد تكلفة.</h1>
    <p class="gdc-subhead">أنفق بذكاء. حافظ على السيطرة.</p>
    <p class="lede">
      تحوّل ANFAA (أنفع) إنفاق السحابة إلى انضباط تشغيلي مستمر لإدارة التكاليف: رؤية، وملكية،
      وتحسين، وتحكم، عبر كل مزوّد سحابي تعمل معه، وليس فقط Google Cloud.
    </p>
    <div class="page-intro__cta">
      <CTAButton href="/resources/anfaa-booklet.pdf" variant="outline">تنزيل الملف (PDF)</CTAButton>
      <CTAButton href="/ar/contact?intent=anfaa">تواصل معنا حول ANFAA</CTAButton>
    </div>
  </PageIntro>

  <ProductBrief
    accent="aquamarine"
    locale="ar"
    productTag="إدارة مالية سحابية متعددة المزودين"
    beliefHeading="يجب أن يكون لكل وحدة من إنفاق السحابة غرض واضح."
    beliefLede="تربط ANFAA بين الاستخدام والمساءلة والحوكمة والتحسين، بحيث تصبح إدارة التكاليف المالية جزءا من نموذج التشغيل السحابي، لا تمرينا ماليا لاحقا."
    plusItems={[
      { label: 'الرؤية', icon: ['M2,12 C5,6 19,6 22,12 C19,18 5,18 2,12 Z', 'M12,9.5 A2.5,2.5 0 1 1 12,14.5 A2.5,2.5 0 1 1 12,9.5 Z'] },
      { label: 'الملكية', icon: ['M12,4.5 A3.5,3.5 0 1 1 12,11.5 A3.5,3.5 0 1 1 12,4.5 Z', 'M5,20 C5,15.5 8,13 12,13 C16,13 19,15.5 19,20'] },
      { label: 'التحسين', icon: ['M4,16 A8,8 0 1 1 20,16', 'M12,16 L15.5,11'] },
      { label: 'التحكم', icon: ['M4,7 L20,7 M4,12 L15,12 M4,17 L18,17'] },
    ]}
    beliefStatement="يجب أن يكون تحسين التكلفة مستمرا، لا تنظيفا ربع سنوي."
    beliefClosing="تأتي قيمة FinOps من تحويل بيانات التكلفة إلى انضباط يومي مشترك بين المالية والهندسة وأصحاب الأعمال."
    loopHeading="من بيانات إنفاق السحابة إلى إجراءات FinOps محكومة."
    loopLede="مسار قابل للتكرار يحوّل بيانات الاستخدام والفوترة إلى ملكية وتحسين وحوكمة مالية."
    loopStages={[
      { label: 'الاكتشاف', desc: 'جمع بيانات تكلفة واستخدام السحابة المهمة.', icon: ['M10.5,4 A6.5,6.5 0 1 1 10.5,17 A6.5,6.5 0 1 1 10.5,4 Z', 'M15.3,15.3 L20,20'] },
      { label: 'التخصيص', desc: 'ربط الإنفاق بالفرق والمنتجات والبيئات والمسؤولين.', icon: ['M3,3 L10,3 L10,10 L3,10 Z', 'M13,3 L20,3 L20,10 L13,10 Z', 'M3,13 L10,13 L10,20 L3,20 Z', 'M13,13 L20,13 L20,20 L13,20 Z'] },
      { label: 'التحسين والتنسيق', desc: 'تحديد الهدر، وموازنة حجم الموارد المفرطة في التوفير، والاستفادة من وفورات السعة المحجوزة والفورية حيثما تناسب حمل العمل.', icon: ['M12,9 A3,3 0 1 1 12,15 A3,3 0 1 1 12,9 Z', 'M12,3 L12,6 M12,18 L12,21 M3,12 L6,12 M18,12 L21,12 M5.6,5.6 L7.8,7.8 M16.2,16.2 L18.4,18.4 M5.6,18.4 L7.8,16.2 M16.2,7.8 L18.4,5.6'] },
      { label: 'الحوكمة', desc: 'استخدام الميزانيات والضوابط وممارسات FinOps للحفاظ على التحكم.', icon: ['M12,3 L19,6 L19,12 C19,16.5 16,19.5 12,21 C8,19.5 5,16.5 5,12 L5,6 Z', 'M9,12 L11,14 L15.5,9'] },
    ]}
    loopStatement="شاهدها. امتلكها. حسّنها. احكمها."
    outcomesHeading="من فاتورة سحابية إلى قيمة سحابية."
    outcomesLede="الهدف ليس لوحة تحكم أخرى. الهدف هو طريقة قابلة للتكرار لإدارة اقتصاديات السحابة بملكية واضحة وإجراءات مستمرة."
    outcomes={[
      { label: 'رؤية أوضح للإنفاق', desc: 'فهم إلى أين تذهب تكلفة السحابة.', icon: ['M2,12 C5,6 19,6 22,12 C19,18 5,18 2,12 Z', 'M12,9.5 A2.5,2.5 0 1 1 12,14.5 A2.5,2.5 0 1 1 12,9.5 Z'] },
      { label: 'مساءلة أوضح', desc: 'ربط الإنفاق بالفرق والمسؤولين.', icon: ['M12,4.5 A3.5,3.5 0 1 1 12,11.5 A3.5,3.5 0 1 1 12,4.5 Z', 'M5,20 C5,15.5 8,13 12,13 C16,13 19,15.5 19,20'] },
      { label: 'تحسين وتنسيق أسرع', desc: 'التعامل مع الهدر والفرص بشكل أسرع.', icon: ['M12,9 A3,3 0 1 1 12,15 A3,3 0 1 1 12,9 Z', 'M12,3 L12,6 M12,18 L12,21 M3,12 L6,12 M18,12 L21,12 M5.6,5.6 L7.8,7.8 M16.2,16.2 L18.4,18.4 M5.6,18.4 L7.8,16.2 M16.2,7.8 L18.4,5.6'] },
      { label: 'ميزانية أقوى', desc: 'إدماج الضوابط في قرارات السحابة اليومية.', icon: ['M4,20 L4,11 M10,20 L10,5 M16,20 L16,14 M20,20 L20,8'] },
      { label: 'تحكم متعدد السحابات', desc: 'توسيع خيارات المزودين دون فقدان الانضباط المالي.', icon: ['M8,14 C5,14 5,9.5 8,9.5 C8.4,6.5 15.6,6.5 16,9.5 C19,9.5 19,14 16,14 Z'] },
      { label: 'يتكامل مع أدوات فريقك', desc: 'تصدير إلى PDF وCSV، وتنبيهات عبر Slack والبريد الإلكتروني، وتكامل عبر webhooks مع أدواتك الحالية.', icon: ['M9,15 L15,9', 'M7,17 C5,15 5,12 7,10 L9,8', 'M17,7 C19,9 19,12 17,14 L15,16'] },
    ]}
    outcomesClose="افهمها. حسّنها. احكمها."
    pdfHref="/resources/anfaa-booklet.pdf"
    pdfLabel="نبذة منتج ANFAA"
    contactIntent="anfaa"
  >
    <Fragment slot="before-cta">
      <section class="section-tight">
        <div class="container">
          <div class="flow-intro">
            <p class="eyebrow">كيف يتكامل</p>
            <h2>مدمج في الأدوات التي يستخدمها فريقك بالفعل.</h2>
            <p class="lede">
              تسحب ANFAA بيانات الاستخدام والفوترة من كل مزوّد تعمل معه، وتُخرج النتائج عبر
              القنوات التي يراقبها فريقك بالفعل.
            </p>
          </div>

          <div class="anfaa-flow">
            <div class="anfaa-flow__row">
              <div class="anfaa-flow__tile">
                <span class="anfaa-flow__icon">
                  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M8,14 C5,14 5,9.5 8,9.5 C8.4,6.5 15.6,6.5 16,9.5 C19,9.5 19,14 16,14 Z" />
                  </svg>
                </span>
                <span>AWS</span>
              </div>
              <div class="anfaa-flow__tile">
                <span class="anfaa-flow__icon">
                  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M8,14 C5,14 5,9.5 8,9.5 C8.4,6.5 15.6,6.5 16,9.5 C19,9.5 19,14 16,14 Z" />
                  </svg>
                </span>
                <span>Azure</span>
              </div>
              <div class="anfaa-flow__tile">
                <span class="anfaa-flow__icon">
                  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M8,14 C5,14 5,9.5 8,9.5 C8.4,6.5 15.6,6.5 16,9.5 C19,9.5 19,14 16,14 Z" />
                  </svg>
                </span>
                <span>Google Cloud</span>
              </div>
            </div>

            <div class="anfaa-flow__branch anfaa-flow__branch--top" aria-hidden="true">
              <span class="anfaa-flow__bus"></span>
              <span class="anfaa-flow__stem anfaa-flow__stem--left"></span>
              <span class="anfaa-flow__stem anfaa-flow__stem--center"></span>
              <span class="anfaa-flow__stem anfaa-flow__stem--right"></span>
            </div>

            <div class="anfaa-flow__hub">
              <span class="anfaa-flow__hub-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path d="M4,20 L4,11 M10,20 L10,5 M16,20 L16,14 M20,20 L20,8" />
                </svg>
              </span>
              <span>ANFAA</span>
            </div>

            <div class="anfaa-flow__branch anfaa-flow__branch--bottom" aria-hidden="true">
              <span class="anfaa-flow__bus"></span>
              <span class="anfaa-flow__stem anfaa-flow__stem--left"></span>
              <span class="anfaa-flow__stem anfaa-flow__stem--center"></span>
              <span class="anfaa-flow__stem anfaa-flow__stem--right"></span>
            </div>

            <div class="anfaa-flow__row">
              <div class="anfaa-flow__tile">
                <span class="anfaa-flow__icon">
                  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <rect x="6" y="3" width="12" height="18" rx="1.5" />
                    <path d="M9,9 L15,9 M9,12.5 L15,12.5 M9,16 L13,16" />
                  </svg>
                </span>
                <span>PDF / CSV</span>
              </div>
              <div class="anfaa-flow__tile">
                <span class="anfaa-flow__icon">
                  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <rect x="3" y="5" width="18" height="14" rx="1.5" />
                    <path d="M4,6 L12,13 L20,6" />
                  </svg>
                </span>
                <span>Slack والبريد الإلكتروني</span>
              </div>
              <div class="anfaa-flow__tile">
                <span class="anfaa-flow__icon">
                  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M9,15 L15,9" />
                    <path d="M7,17 C5,15 5,12 7,10 L9,8" />
                    <path d="M17,7 C19,9 19,12 17,14 L15,16" />
                  </svg>
                </span>
                <span>Webhooks</span>
              </div>
            </div>
          </div>
        </div>
      </section>
    </Fragment>
  </ProductBrief>
</BaseLayout>

<style>
  .gdc-subhead {
    margin-top: 1rem;
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 500;
    color: var(--white-smoke);
  }

  .page-intro__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .flow-intro {
    max-width: 36rem;
    margin-inline: auto;
    text-align: center;
  }

  .flow-intro > .eyebrow {
    margin-inline: auto;
  }

  .flow-intro h2 {
    margin-top: 0.75rem;
  }

  .flow-intro .lede {
    margin-top: 1rem;
    margin-inline: auto;
  }

  .anfaa-flow {
    --flow-gap: clamp(1.5rem, 3vw, 2.5rem);
    margin-top: clamp(3rem, 6vw, 4.5rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 50rem;
    margin-inline: auto;
  }

  .anfaa-flow__row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--flow-gap);
    width: 100%;
  }

  .anfaa-flow__tile {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    padding: 1.25rem 1.5rem;
    background: var(--gunmetal-raised);
    border: 1px solid var(--gunmetal-line);
    border-radius: var(--border-radius);
    text-align: center;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-0);
    color: var(--white-smoke);
  }

  .anfaa-flow__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 8px;
    background: color-mix(in srgb, var(--aquamarine) 8%, transparent);
    border: 1px solid color-mix(in srgb, var(--aquamarine) 30%, transparent);
  }

  .anfaa-flow__icon svg {
    width: 1.2rem;
    height: 1.2rem;
    fill: none;
    stroke: var(--aquamarine);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .anfaa-flow__branch {
    position: relative;
    width: 100%;
    height: clamp(2.5rem, 5vw, 3.5rem);
  }

  .anfaa-flow__bus {
    position: absolute;
    left: calc((100% - 2 * var(--flow-gap)) / 6);
    right: calc((100% - 2 * var(--flow-gap)) / 6);
    top: 50%;
    height: 1px;
    background: var(--gunmetal-line);
  }

  .anfaa-flow__stem {
    position: absolute;
    width: 1px;
    background: var(--gunmetal-line);
  }

  .anfaa-flow__stem--left {
    left: calc((100% - 2 * var(--flow-gap)) / 6);
  }

  .anfaa-flow__stem--center {
    left: 50%;
    top: 0;
    height: 100%;
  }

  .anfaa-flow__stem--right {
    right: calc((100% - 2 * var(--flow-gap)) / 6);
  }

  .anfaa-flow__branch--top .anfaa-flow__stem--left,
  .anfaa-flow__branch--top .anfaa-flow__stem--right {
    top: 0;
    height: 50%;
  }

  .anfaa-flow__branch--bottom .anfaa-flow__stem--left,
  .anfaa-flow__branch--bottom .anfaa-flow__stem--right {
    bottom: 0;
    height: 50%;
  }

  @media (max-width: 560px) {
    .anfaa-flow__bus,
    .anfaa-flow__stem--left,
    .anfaa-flow__stem--right {
      display: none;
    }
  }

  .anfaa-flow__hub {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 1.1rem clamp(1.5rem, 3vw, 2rem);
    border-radius: var(--border-radius);
    border: 2px solid var(--aquamarine);
    background: var(--gunmetal-raised);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-1);
    color: var(--white-smoke);
  }

  .anfaa-flow__hub-icon {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 8px;
    background: var(--gunmetal);
  }

  .anfaa-flow__hub-icon svg {
    width: 1.3rem;
    height: 1.3rem;
    fill: none;
    stroke: var(--aquamarine);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (max-width: 560px) {
    .anfaa-flow__row {
      grid-template-columns: 1fr;
    }
  }
</style>
