---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import LeadershipCard from '../../components/LeadershipCard.astro';
import ProofPoint from '../../components/ProofPoint.astro';

// Draft machine translation, for visual/design review only — pending a
// native-speaker pass. Mirrors src/pages/about.astro structure and
// styles exactly; only the copy and internal hrefs differ.

const leadership = [
  {
    name: 'Ali Aktar',
    role: 'الرئيس التنفيذي',
    bio: 'ستة وعشرون عاما في التقنية: التطوير، والهندسة، والبنية، والسحابة، والأجايل، وDevOps. بنى علي فرق هندسة البرمجيات والمنصات من الصفر، وتولى مناصب رئيس الهندسة والرئيس التقني في مؤسسات القطاعين الخاص والعام حول العالم، في الاتصالات، ومزودي خدمة الإنترنت، والنفط والغاز، والاتصالات الفضائية، والدفاع والجيش، والقطاع المصرفي، والخدمات الصحية الوطنية. وهو داعية لمنهجية الأجايل والسحابة وDevOps، ومساهم منذ زمن طويل في مشاريع مفتوحة المصدر.',
    photo: '/team/ali.jpg',
  },
  {
    name: 'Irfan A Ansari',
    role: 'الرئيس التقني',
    bio: 'خمسة وعشرون عاما في التقنية، بدأها مهندس برمجيات قبل أن ينتقل إلى السحابة، وهندسة المنصات، وDevSecOps. أمضى عرفان خمسة عشر عاما في بناء الأنظمة بلغتي Java وScala عبر قطاعات السفر الإلكتروني، والطيران، والتجزئة، والحكومة البريطانية. ثم قاد أعمال منصات السحابة في الاتصالات الفضائية، والقطاع المصرفي، وخصوصية البيانات. وقد قاد منذ ذلك الحين عمليات انتقال متعددة السحابات عبر GCP وAWS وAzure وOracle Cloud لعملاء من القطاع العام والمصرفي والتقنية المالية في المملكة العربية السعودية. صمم مناطق هبوط تتوافق مع ضوابط البنك المركزي السعودي (ساما)، ونشر السحابة الموزعة من جوجل في مراكز بيانات شديدة التنظيم. وهو "بطل GenAI" ضمن برنامج GenAI من Google Cloud، كما أنه حاصل على شهادتي Google Cloud المعتمدتين: مهندس سحابة محترف، ومهندس أمان سحابة محترف.',
    photo: '/team/irfan.jpg',
  },
  {
    name: 'Tahir Alam',
    role: 'الرئيس التشغيلي',
    bio: 'خمسة عشر عاما كمتخصص في إدارة المشاريع والبرامج، شملت مناصب مدير أول عبر الحكومة البريطانية: وزارة العدل، وهيئة الإيرادات والجمارك، ومكتب مجلس الوزراء ورئيس الوزراء. قاد طاهر فرقا كبيرة متعددة الوظائف لتنفيذ برامج بمليارات الجنيهات الإسترلينية، بخبرة عميقة في الاستراتيجية، والتحول، والتصميم المؤسسي، والحوكمة، والتواصل مع أصحاب المصلحة حتى المستوى الوزاري. يحمل درجة جامعية وماجستير من UCL، وهو متخصص معتمد في إدارة البرامج وممارس إدارة التغيير، ويحمل دبلوم CIPD من المستوى الخامس في إدارة الموارد البشرية.',
    photo: '/team/tahir.jpg',
  },
  {
    name: 'Paul Wagenaar',
    role: 'الرئيس التنفيذي لأمن المعلومات',
    bio: 'عقدان من الزمن في الأمن السيبراني، بمسيرة مهنية امتدت عبر أستراليا والمملكة المتحدة وجنوب أفريقيا والإمارات العربية المتحدة. تولى بول مناصب قيادية أمنية في بنوك عالمية وشركات كبرى، وبنى استراتيجيات وقدرات أمنية من الصفر في بعض أكثر البيئات تنظيما في العالم.',
    photo: '/team/paul.png',
  },
];

const events = [
  {
    eyebrow: 'Money20/20 · المملكة العربية السعودية',
    heading: 'نهندس السحابة السيادية، معا.',
    body: 'C-9INE مع فريق Google في Money20/20 السعودية. علاقة نمت بشكل كبير منذ 2023، مبنية على هندسة GDC وGoogle Cloud عميقة، لا مجرد إدراج كشريك عادي.',
    image: '/press/money2020.jpg',
    alt: 'فريق C-9INE مع Google Cloud في Money20/20 السعودية',
    imageWidth: 1447,
    imageHeight: 1087,
  },
  {
    eyebrow: 'قمة Google Cloud · المملكة العربية السعودية',
    heading: 'خمس جوائز GenAI، وبطلان من فريقنا.',
    body: 'فازت C-9INE بخمس جوائز GenAI في قمة Google Cloud بالمملكة العربية السعودية، وحصل كل من الرئيس التنفيذي لأمن المعلومات Paul Wagenaar والرئيس التقني Irfan Ansari على لقب بطل شراكة GenAI من Google Cloud بشكل فردي.',
    image: '/press/google-summit.jpg',
    alt: 'فريق C-9INE على المسرح في قمة Google Cloud بالمملكة العربية السعودية، كشريك معتمد في GenAI',
    imageWidth: 1600,
    imageHeight: 1200,
    gallery: [
      { src: '/press/google-summit-paul.jpg', alt: 'تكريم Paul Wagenaar بلقب بطل شراكة GenAI من Google Cloud', caption: 'Paul Wagenaar' },
      { src: '/press/google-summit-irfan.jpg', alt: 'تكريم Irfan Ansari بلقب بطل شراكة GenAI من Google Cloud', caption: 'Irfan Ansari' },
    ],
  },
];

const teamRoleGroups = [
  {
    label: 'الانتقال والتحول السحابي',
    roles: ['مهندس انتقال سحابي', 'مهندس معماري لمناطق الهبوط', 'مهندس موثوقية الأنظمة'],
  },
  {
    label: 'السحابة الموزعة من جوجل',
    roles: ['مهندس معماري لحلول GDC', 'مهندس Kubernetes وAnthos', 'مهندس شبكات وبنية تحتية'],
  },
  {
    label: 'عبر الوظائف والمنتجات',
    roles: ['مهندس أمان وامتثال', 'مهندس FinOps (أنفع)', 'مهندس DevOps وأتمتة (أساس)'],
  },
];
---

<BaseLayout
  title="من نحن"
  description="C-9INE شريك Google Cloud المتخصص، يقدّم خدماته للبنوك والجهات الحكومية ومؤسسات البنية التحتية الحيوية في المملكة العربية السعودية وخارجها."
  locale="ar"
>
  <PageIntro eyebrow="من نحن">
    <h1>بجانبك، وضمن فريقك.</h1>
    <p class="lede">
      C-9INE شريك Google Cloud المتخصص، يقدّم خدماته للبنوك والجهات الحكومية ومؤسسات البنية
      التحتية الحيوية في المملكة العربية السعودية وخارجها. نصمم، ونهندس، ونشغّل، وننضم إلى فريقك
      بدلا من تسليم عرض تقديمي والرحيل.
    </p>
    <p class="lede">
      تتمتع القيادة التنفيذية لشركة C-9INE ومهندسو التنفيذ الأساسيون بخبرة فريدة ومباشرة الصلة:
      فقد بنينا بنكين رقميين كاملين من الصفر في المملكة العربية السعودية.
    </p>
  </PageIntro>

  <section class="section-tight">
    <div class="container">
      <h2>الفعاليات</h2>
      <div class="events-list">
        {events.map((event) => (
          <div class="press-feature">
            <img
              src={event.image}
              alt={event.alt}
              class="press-feature__image"
              width={event.imageWidth}
              height={event.imageHeight}
            />
            <div class="press-feature__body">
              <p class="eyebrow">{event.eyebrow}</p>
              <h3>{event.heading}</h3>
              <p class="lede">{event.body}</p>
            </div>
            {event.gallery && (
              <div class="press-feature__gallery">
                {event.gallery.map((item) => (
                  <figure>
                    <img src={item.src} alt={item.alt} width="400" height="300" />
                    <figcaption>{item.caption}</figcaption>
                  </figure>
                ))}
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-raised">
    <div class="container">
      <h2>القيادة</h2>
      <div class="leadership-grid">
        {leadership.map((person) => (
          <LeadershipCard name={person.name} role={person.role} bio={person.bio} photo={person.photo} locale="ar" />
        ))}
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <h2>الفريق خلف الفريق</h2>
      <p class="lede team-roles__intro">
        تضم C-9INE أيضا فريقا من أفضل الخبراء، تم اختيارهم بعناية لعمق واتساع مهاراتهم ومعرفتهم
        وخبرتهم، وقد عملوا عبر قطاعات صناعية متعددة ومع علامات تجارية كبرى.
      </p>
      <div class="team-roles">
        {teamRoleGroups.map((group) => (
          <div class="team-roles__group">
            <p class="eyebrow">{group.label}</p>
            <ul class="team-roles__chips">
              {group.roles.map((role) => (
                <li>{role}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <ProofPoint eyebrow="لماذا C-9INE">
        نسلّمك المفاتيح. ينتهي كل تعاون، سواء كان انتقالا أو GDC، بفريقك قادرا تماما على تشغيل ما
        بنيناه، دون الاعتماد علينا لإبقائه يعمل. يعيش الكود والمخططات والأدلة والتوثيق في
        مستودعاتك، لا مستودعاتنا.
      </ProofPoint>
    </div>
  </section>
</BaseLayout>

<style>
  .events-list {
    margin-top: 2rem;
    display: flex;
    flex-direction: column;
    gap: clamp(3rem, 6vw, 4.5rem);
  }

  .press-feature {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 3.5rem);
    align-items: center;
  }

  .press-feature__image {
    width: 100%;
    height: auto;
    border-radius: var(--border-radius);
  }

  .press-feature__body h3 {
    margin-top: 0.75rem;
    font-size: var(--step-3);
  }

  .press-feature__body .lede {
    margin-top: 1rem;
  }

  .press-feature__gallery {
    grid-column: 1 / -1;
    margin-top: 0.5rem;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    max-width: 34rem;
  }

  .press-feature__gallery figure {
    margin: 0;
  }

  .press-feature__gallery img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--border-radius);
  }

  .press-feature__gallery figcaption {
    margin-top: 0.5rem;
    color: var(--silver);
    font-size: var(--step--1);
    text-align: center;
  }

  @media (max-width: 800px) {
    .press-feature {
      grid-template-columns: 1fr;
    }
  }

  .leadership-grid {
    margin-top: 2rem;
    display: flex;
    flex-direction: column;
  }

  .team-roles__intro {
    margin-top: 1rem;
    max-width: 58ch;
  }

  .team-roles {
    margin-top: 2.5rem;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.75rem, 3vw, 2.5rem);
  }

  .team-roles__group {
    padding-top: 1.1rem;
    border-top: 2px solid color-mix(in srgb, var(--aquamarine) 45%, transparent);
  }

  .team-roles__chips {
    margin-top: 1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .team-roles__chips li {
    padding: 0.5rem 0.9rem;
    border: 1px solid color-mix(in srgb, var(--aquamarine) 28%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--aquamarine) 7%, transparent);
    color: var(--white-smoke);
    font-size: var(--step--1);
  }

  @media (max-width: 800px) {
    .team-roles {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
