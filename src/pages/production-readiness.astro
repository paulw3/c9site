---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import CTAButton from '../components/CTAButton.astro';
---

<BaseLayout
  title="GCP Production Readiness & Assurance"
  description="Independent review and verification of Google Cloud environments for banks, fintechs, regulators and regulated organisations, with clear findings and remediation actions before production activation."
>
  <PageIntro eyebrow="GCP Production Readiness & Assurance">
    <h1>An independent second opinion before you go live.</h1>
    <p class="lede">
      We independently review and verify Google Cloud environments for banks, fintechs,
      regulators and regulated organisations: assessing architecture, security, compliance,
      resilience and operations, with clear findings and remediation actions before production
      activation.
    </p>
    <div class="page-intro__cta">
      <CTAButton href="/contact?intent=assurance" terminalHover>Talk to us about an assessment</CTAButton>
    </div>
  </PageIntro>

  <!-- 01 · Why Independent — text column + editorial list, same shape as the other two pillar pages -->
  <section class="section-tight section-raised intro-gap-fix">
    <div class="container">
      <div class="problem-layout">
        <div class="problem-layout__intro">
          <p class="eyebrow">Why Independent</p>
          <h2>The team that built it is the wrong team to sign it off.</h2>
          <p class="lede">
            Not because the work is bad, but because nobody can mark their own exam paper. An
            independent review catches what proximity to the build makes easy to miss.
          </p>
          <p class="pull-statement">
            A second opinion before go-live costs far less than finding out in production.
          </p>
        </div>

        <ol class="editorial-list">
          <li>
            <span class="editorial-list__num">01</span>
            <div>
              <h4>Built it or not</h4>
              <p>We review environments we delivered, and environments built by anyone else.</p>
            </div>
          </li>
          <li>
            <span class="editorial-list__num">02</span>
            <div>
              <h4>A regulator's expectation</h4>
              <p>Boards and regulators increasingly expect independent sign-off before go-live.</p>
            </div>
          </li>
          <li>
            <span class="editorial-list__num">03</span>
            <div>
              <h4>Fresh eyes, not fresh assumptions</h4>
              <p>Issues that stay invisible to a team that's been inside the build for months.</p>
            </div>
          </li>
          <li>
            <span class="editorial-list__num">04</span>
            <div>
              <h4>Evidence, not reassurance</h4>
              <p>A documented, defensible record for audit and governance, not a verbal all-clear.</p>
            </div>
          </li>
        </ol>
      </div>
    </div>
  </section>

  <!-- 02 · What We Assess — seamless icon grid, full width -->
  <section class="section-tight">
    <div class="container">
      <div class="standardise-intro">
        <p class="eyebrow">What We Assess</p>
        <h2>Six domains, one independent view.</h2>
        <p class="lede">
          Every assessment covers the same ground in depth, whichever domain turns out to
          matter most for your environment.
        </p>
      </div>

      <ul class="foundations-grid">
        <li>
          <span class="foundations-grid__icon">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <rect x="9" y="4" width="6" height="3" rx="1" />
              <rect x="6" y="10" width="12" height="3" rx="1" />
              <rect x="3" y="16" width="18" height="3" rx="1" />
            </svg>
          </span>
          <h4>Architecture</h4>
          <p>Is the design sound and fit for what it actually needs to carry</p>
        </li>
        <li>
          <span class="foundations-grid__icon">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M12,3 L19,6 L19,12 C19,16.5 16,19.5 12,21 C8,19.5 5,16.5 5,12 L5,6 Z" />
              <path d="M9,12 L11,14 L15.5,9" />
            </svg>
          </span>
          <h4>Security</h4>
          <p>Controls that are actually enforced, not just documented</p>
        </li>
        <li>
          <span class="foundations-grid__icon">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M6,3 L15,3 L19,7 L19,21 L6,21 Z" />
              <path d="M15,3 L15,7 L19,7" />
              <path d="M9,12 L16,12 M9,15.5 L16,15.5 M9,9 L12,9" />
            </svg>
          </span>
          <h4>Compliance</h4>
          <p>Mapped against SAMA, NCA ECC and the controls that apply to you</p>
        </li>
        <li>
          <span class="foundations-grid__icon">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M4,10 A8,8 0 1 1 6.2,16.2" />
              <path d="M4,10 L1.7,6.8 M4,10 L7.3,11.3" />
              <path d="M12,7 L12,12 L15.5,14" />
            </svg>
          </span>
          <h4>Resilience</h4>
          <p>Backup and failover tested, not assumed to work when needed</p>
        </li>
        <li>
          <span class="foundations-grid__icon">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <circle cx="12" cy="12" r="3" />
              <path d="M12,3 L12,6 M12,18 L12,21 M3,12 L6,12 M18,12 L21,12 M5.6,5.6 L7.8,7.8 M16.2,16.2 L18.4,18.4 M5.6,18.4 L7.8,16.2 M16.2,7.8 L18.4,5.6" />
            </svg>
          </span>
          <h4>Operations</h4>
          <p>Observability, runbooks and on-call readiness for day two</p>
        </li>
        <li>
          <span class="foundations-grid__icon">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M5,21 L5,3" />
              <path d="M5,4 L18,4 L15,8 L18,12 L5,12" />
            </svg>
          </span>
          <h4>Go-live readiness</h4>
          <p>A clear go or no-go call, not a vague "looks fine"</p>
        </li>
      </ul>

      <p class="pull-statement foundations-grid__statement">
        Same rigour whether we built the environment or someone else did.
      </p>
    </div>
  </section>

  <!-- 03 · How It Works — horizontal 3-step timeline -->
  <section class="section-tight section-raised">
    <div class="container">
      <div class="works-intro">
        <p class="eyebrow">How It Works</p>
        <h2>Three steps from review to resolved.</h2>
        <p class="lede">A standalone engagement with a clear start and end, not an open-ended audit.</p>
      </div>

      <div class="works-timeline">
        <div class="works-timeline__line" aria-hidden="true"></div>
        <ol class="works-timeline__steps works-timeline__steps--three">
          <li>
            <span class="works-timeline__node">01</span>
            <h4>Assess</h4>
            <p>Independent review against architecture, security, compliance, resilience and operations baselines.</p>
          </li>
          <li>
            <span class="works-timeline__node">02</span>
            <h4>Report</h4>
            <p>Clear, risk-rated findings, written for engineering and leadership alike.</p>
          </li>
          <li>
            <span class="works-timeline__node">03</span>
            <h4>Remediate</h4>
            <p>Concrete remediation actions, validated before production activation.</p>
          </li>
        </ol>
      </div>
    </div>
  </section>

  <!-- 04 · Who It's For — wide, centred, statement-led -->
  <section class="section-tight">
    <div class="container">
      <div class="belief-layout">
        <p class="eyebrow">Who It's For</p>
        <h2 class="belief-layout__heading">A second opinion, not a second vendor relationship.</h2>
        <p class="lede belief-layout__primary">
          Banks, fintechs, regulators and other regulated organisations running Google Cloud,
          whichever team built it. A standalone engagement, not an upsell on work already in
          progress.
        </p>
        <p class="belief-layout__closing">
          The same findings and remediation actions either way: an independent, defensible
          record for your board and your regulator before you go live.
        </p>
      </div>
    </div>
  </section>

  <!-- Closing CTA band -->
  <section class="cta-band">
    <div class="container cta-band__inner">
      <h2>Ready for an independent second opinion before go-live?</h2>
      <div class="cta-band__action">
        <CTAButton href="/contact?intent=assurance" variant="outline" terminalHover>Talk to us about an assessment</CTAButton>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .intro-gap-fix {
    padding-top: clamp(1rem, 2vw, 1.5rem);
  }

  .pull-statement {
    padding-left: 1.15rem;
    border-left: 2px solid var(--aquamarine);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-1);
    line-height: 1.35;
    color: var(--white-smoke);
  }

  /* ---- 01 · Why Independent --------------------------------------- */

  .problem-layout {
    display: grid;
    grid-template-columns: minmax(0, 21rem) 1fr;
    gap: clamp(2.5rem, 6vw, 5.5rem);
    align-items: start;
  }

  .problem-layout__intro h2 {
    margin-top: 0.75rem;
  }

  .problem-layout__intro .lede {
    margin-top: 1rem;
  }

  .problem-layout__intro .pull-statement {
    margin-top: 2.25rem;
  }

  .editorial-list {
    display: flex;
    flex-direction: column;
  }

  .editorial-list li {
    display: flex;
    gap: clamp(1.25rem, 3vw, 2rem);
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--gunmetal-line);
  }

  .editorial-list li:first-child {
    padding-top: 0;
  }

  .editorial-list li:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .editorial-list__num {
    flex-shrink: 0;
    width: 2.75rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-2);
    line-height: 1.15;
    color: color-mix(in srgb, var(--aquamarine) 55%, var(--gunmetal-line));
  }

  .editorial-list h4 {
    font-size: var(--step-0);
    color: var(--white-smoke);
  }

  .editorial-list p {
    margin-top: 0.4rem;
    color: var(--silver);
    font-size: var(--step--1);
    line-height: 1.5;
  }

  @media (max-width: 850px) {
    .problem-layout {
      grid-template-columns: 1fr;
    }
  }

  /* ---- 02 · What We Assess ------------------------------------------ */

  .standardise-intro {
    max-width: 36rem;
  }

  .standardise-intro h2 {
    margin-top: 0.75rem;
  }

  .standardise-intro .lede {
    margin-top: 1rem;
  }

  .foundations-grid {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    background: var(--gunmetal-line);
    border: 1px solid var(--gunmetal-line);
    border-radius: var(--border-radius);
    overflow: hidden;
  }

  .foundations-grid li {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: clamp(1.5rem, 3vw, 1.85rem);
    background: var(--gunmetal);
  }

  .foundations-grid__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 8px;
    background: color-mix(in srgb, var(--aquamarine) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--aquamarine) 28%, transparent);
  }

  .foundations-grid__icon svg {
    width: 1.35rem;
    height: 1.35rem;
    fill: none;
    stroke: var(--aquamarine);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .foundations-grid h4 {
    font-size: var(--step-0);
    color: var(--white-smoke);
  }

  .foundations-grid p {
    color: var(--silver);
    font-size: var(--step--1);
    line-height: 1.5;
  }

  .foundations-grid__statement {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    max-width: 46rem;
  }

  @media (max-width: 900px) {
    .foundations-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .foundations-grid {
      grid-template-columns: 1fr;
    }
  }

  /* ---- 03 · How It Works ------------------------------------------- */

  .works-intro {
    max-width: 36rem;
  }

  .works-intro h2 {
    margin-top: 0.75rem;
  }

  .works-intro .lede {
    margin-top: 1rem;
  }

  .works-timeline {
    position: relative;
    margin-top: clamp(3rem, 6vw, 4.5rem);
  }

  .works-timeline__line {
    position: absolute;
    top: 1.1rem;
    left: 1.1rem;
    right: 1.1rem;
    height: 1px;
    background: var(--gunmetal-line);
  }

  .works-timeline__steps {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  .works-timeline__steps--three {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .works-timeline__steps li {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .works-timeline__node {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--gunmetal-raised);
    border: 1px solid var(--aquamarine);
    color: var(--aquamarine);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step--1);
  }

  .works-timeline__steps h4 {
    color: var(--white-smoke);
    font-size: var(--step-0);
  }

  .works-timeline__steps p {
    color: var(--silver);
    font-size: var(--step--1);
    line-height: 1.45;
  }

  @media (max-width: 800px) {
    .works-timeline__line {
      display: none;
    }

    .works-timeline__steps,
    .works-timeline__steps--three {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  /* ---- 04 · Who It's For -------------------------------------------- */

  .belief-layout {
    max-width: 40rem;
    margin-inline: auto;
    text-align: center;
  }

  .belief-layout > .eyebrow {
    margin-inline: auto;
  }

  .belief-layout__heading {
    margin-top: 0.85rem;
    font-size: var(--step-4);
  }

  .belief-layout__primary {
    margin-top: 1.25rem;
    margin-inline: auto;
    max-width: 32rem;
  }

  .belief-layout__closing {
    margin-top: 2rem;
    margin-inline: auto;
    max-width: 28rem;
    padding-top: 2rem;
    border-top: 1px solid var(--gunmetal-line);
    color: var(--silver);
    font-size: var(--step--1);
    line-height: 1.6;
  }

  /* ---- Closing CTA band ---------------------------------------------- */

  .cta-band {
    background: var(--aquamarine);
    padding-block: clamp(1.5rem, 3.5vw, 2.5rem);
  }

  .cta-band__inner {
    text-align: center;
  }

  .cta-band h2 {
    max-width: 42rem;
    margin-inline: auto;
    font-size: var(--step-2);
    color: var(--gunmetal);
  }

  .cta-band__action {
    margin-top: clamp(1.1rem, 2.5vw, 1.5rem);
    display: flex;
    justify-content: center;
  }

  .cta-band__action :global(.btn) {
    border-color: var(--gunmetal);
    color: var(--gunmetal);
  }

  .cta-band__action :global(.btn:hover) {
    background: var(--gunmetal);
    color: var(--aquamarine);
    border-color: var(--gunmetal);
  }
</style>
