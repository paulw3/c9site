---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import CTAButton from '../../components/CTAButton.astro';
import ProofPoint from '../../components/ProofPoint.astro';

const prerequisites = [
  'A Google Cloud organisation with billing enabled',
  'Organization Administrator role (or equivalent) on your Google Cloud organisation',
  'A Google Cloud Marketplace account linked to an active billing account',
];

const stepSections = [
  {
    eyebrow: 'Step 1',
    title: 'Get access to aSaaS',
    intro: 'aSaaS is available through Google Cloud Marketplace via private offer.',
    bullets: [
      'Contact C-9INE: reach out to discuss your landing zone requirements.',
      'Receive a private offer: we send a customised offer through Google Cloud Marketplace.',
      'Accept the offer: review the pricing, select your billing account, and accept it.',
      'Your subscription activates immediately, and stays visible any time in your Marketplace Orders.',
    ],
  },
  {
    eyebrow: 'Step 2',
    title: 'Sign up and activate your account',
    intro: 'After subscribing, Google Cloud redirects you to the aSaaS sign-up page.',
    bullets: [
      'A secure token (JWT) verifies your identity automatically.',
      'Your aSaaS account is created and approved within seconds.',
      'You land on the aSaaS Marketplace Portal, showing your account status.',
    ],
  },
  {
    eyebrow: 'Step 3',
    title: 'Connect your Google Cloud organisation',
    intro: 'From the aSaaS Marketplace Portal:',
    bullets: [
      'Click "Connect Organization".',
      'Sign in with an account that has Organization Administrator permissions.',
      'Authorise aSaaS to manage landing zone resources in your organisation.',
      'Behind the scenes: a dedicated service account is created, scoped to Folder Admin, Organization Admin, Project Creator and Billing User. Every action stays scoped to landing zone resources only.',
    ],
  },
];

const reviewLoop = [
  { label: 'Review', desc: 'The assistant explains what will be created or modified.' },
  { label: 'Approve', desc: 'Click Approve to proceed, or ask the assistant for more detail.' },
  { label: 'Apply', desc: 'OpenTofu applies the infrastructure changes to your Google Cloud environment.' },
  { label: 'Verify', desc: 'The assistant confirms the changes were applied successfully.' },
];

const monitorItems = [
  'Stage progress: see which stages are complete, in progress, or pending.',
  'Resource details: view the specific Google Cloud resources being created.',
  'Architecture diagrams: auto-generated diagrams of your landing zone topology.',
];

const postDeployment = [
  'Organisation policies are enforced.',
  'Networking is configured with Shared VPC and proper segmentation.',
  'Security controls are active (Cloud Armor, Security Command Center, IAM).',
  'Environment folders and projects are provisioned.',
  'A GitOps pipeline is set up: all infrastructure is managed via a GitLab IaC repository with Cloud Build pipelines for ongoing management.',
];

const foundations = [
  {
    type: 'Proof of Concept',
    bestFor: 'Evaluating Google Cloud',
    included: 'Organisation + billing setup, basic IAM, minimal hierarchy',
  },
  {
    type: 'Production',
    bestFor: 'Production workloads',
    included: 'Full setup: networking, security, IAM, environments, monitoring',
  },
  {
    type: 'Enhanced Security',
    bestFor: 'Regulated industries',
    included: 'Everything in Production + Cloud KMS with Autokey encryption',
  },
];

const stages = [
  { stage: '0: Bootstrap', desc: 'Creates the seed project, enables APIs, sets up OpenTofu state storage' },
  { stage: '1: Organization', desc: 'Configures organisation policies, creates top-level folders' },
  { stage: '1: Services', desc: 'Enables required Google Cloud APIs across the organisation' },
  { stage: '2: Networking', desc: 'Sets up Shared VPC, subnets, Cloud NAT, firewall rules' },
  { stage: '3: Security', desc: 'Configures Security Command Center, Cloud Armor, IAM hardening' },
  { stage: '4: Environments', desc: 'Creates development, staging, and production environment folders' },
  { stage: '5: Projects', desc: 'Provisions projects within each environment with proper IAM' },
  { stage: '6: App Deployment', desc: 'Deploys workload infrastructure (Cloud Run, GKE, etc.)' },
];

const nextSteps = [
  "Customise the OpenTofu templates for your organisation's requirements.",
  'Extend the landing zone with more environments, projects or workloads through the AI assistant.',
  "Monitor landing zone health using Google Cloud's operations suite.",
];

const troubleshooting = [
  {
    issue: '"No Active Subscription" on the portal page',
    solution: 'Ensure you subscribed via Marketplace and are signed in with the same Google account.',
  },
  {
    issue: 'Organization connection fails',
    solution: 'Verify you have Organization Administrator permissions. Check that the organisation has billing enabled.',
  },
  {
    issue: 'A deployment stage fails',
    solution: 'The AI assistant provides error details and remediation steps. You can retry any failed stage.',
  },
  {
    issue: 'Need to re-run the signup flow',
    solution: 'Contact support: we can reset your account to re-trigger the Marketplace signup.',
  },
];
---

<BaseLayout
  title="Getting Started with aSaaS"
  description="Deploy secure, compliant Google Cloud landing zones in minutes with aSaaS, available directly through Google Cloud Marketplace."
>
  <PageIntro eyebrow="aSaaS · Getting Started">
    <h1>Getting started with aSaaS on Google Cloud Marketplace</h1>
    <p class="lede">
      Deploy secure, compliant Google Cloud landing zones in minutes, with AI-guided automation
      and human approval at every step. aSaaS is available directly through Google Cloud
      Marketplace. This guide walks through getting access, connecting your organisation, and
      deploying your first landing zone.
    </p>
    <div class="page-intro__cta">
      <CTAButton href="/resources/asaas" variant="outline">Back to the aSaaS brief</CTAButton>
      <CTAButton href="/contact?intent=asaas">Talk to us about aSaaS</CTAButton>
    </div>
  </PageIntro>

  <section class="section-tight">
    <div class="container">
      <p class="eyebrow">Prerequisites</p>
      <ul class="check-list">
        {prerequisites.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </div>
  </section>

  {stepSections.map((step, i) => (
    <section class={`section-tight ${i % 2 === 0 ? 'section-raised' : ''}`}>
      <div class="container narrow">
        <p class="eyebrow">{step.eyebrow}</p>
        <h2>{step.title}</h2>
        <p class="lede">{step.intro}</p>
        <ul class="icon-list">
          {step.bullets.map((bullet) => (
            <li>
              <svg class="icon-list__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
              <span>{bullet}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>
  ))}

  <section class="section-tight">
    <div class="container">
      <p class="eyebrow">Step 4</p>
      <h2>Choose your foundation type</h2>
      <div class="table-wrap">
        <table class="data-table">
          <thead>
            <tr>
              <th>Type</th>
              <th>Best for</th>
              <th>What's included</th>
            </tr>
          </thead>
          <tbody>
            {foundations.map((f) => (
              <tr>
                <td><strong>{f.type}</strong></td>
                <td>{f.bestFor}</td>
                <td>{f.included}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="lede foundation-note">
        The AI assistant adapts the deployment workflow to your choice: a Proof of Concept
        deploys faster with sensible defaults, while Production and Enhanced Security guide you
        through every configuration detail.
      </p>
    </div>
  </section>

  <section class="section-tight section-raised">
    <div class="container narrow">
      <p class="eyebrow">Step 5</p>
      <h2>Deploy your first landing zone</h2>
      <p class="lede">
        Once your organisation is connected and your foundation type selected, the aSaaS AI
        assistant guides you through the entire landing zone deployment.
      </p>
      <div class="substep">
        <p class="eyebrow">5.1 Open the Landing Zone Dashboard</p>
        <p>Navigate to the main aSaaS dashboard. The AI assistant is ready to start.</p>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <p class="eyebrow">5.2 Start the guided deployment</p>
      <h2>What the AI assistant deploys, stage by stage</h2>
      <div class="table-wrap">
        <table class="data-table">
          <thead>
            <tr>
              <th>Stage</th>
              <th>What it does</th>
            </tr>
          </thead>
          <tbody>
            {stages.map((stage) => (
              <tr>
                <td><strong>{stage.stage}</strong></td>
                <td>{stage.desc}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="lede foundation-note">
        Which stages you see depends on your foundation type: a Proof of Concept deploys a
        subset with sensible defaults, while Production and Enhanced Security include every
        stage.
      </p>
    </div>
  </section>

  <section class="section-tight section-raised">
    <div class="container narrow">
      <p class="eyebrow">5.3 Review and approve each step</p>
      <h2>You approve every change before it happens</h2>
      <p class="lede">At every critical step, the AI assistant pauses and asks for your approval before making changes:</p>
      <ol class="review-loop">
        {reviewLoop.map((item, i) => (
          <li>
            <span class="review-loop__num mono-tag">{String(i + 1).padStart(2, '0')}</span>
            <h4>{item.label}</h4>
            <p>{item.desc}</p>
          </li>
        ))}
      </ol>
      <ProofPoint eyebrow="Full control, throughout">
        No infrastructure changes are ever made without your explicit approval. You maintain
        full control throughout the process.
      </ProofPoint>
    </div>
  </section>

  <section class="section-tight">
    <div class="container narrow">
      <p class="eyebrow">5.4 Monitor progress</p>
      <h2>Track the deployment in real time</h2>
      <ul class="check-list">
        {monitorItems.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section-tight section-raised">
    <div class="container narrow">
      <p class="eyebrow">Step 6</p>
      <h2>Post-deployment</h2>
      <p class="lede">After all stages complete, your landing zone is ready:</p>
      <ul class="icon-list">
        {postDeployment.map((item) => (
          <li>
            <svg class="icon-list__icon icon-list__icon--check" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7" /></svg>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section-tight">
    <div class="container narrow">
      <p class="eyebrow">Next steps</p>
      <ul class="check-list">
        {nextSteps.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section-tight section-raised">
    <div class="container narrow">
      <p class="eyebrow">Managing your subscription</p>
      <ul class="check-list">
        <li>View subscription status in the aSaaS Portal.</li>
        <li>View offer and billing details in Google Cloud Marketplace Orders.</li>
        <li>
          To cancel, contact C-9INE or manage it through Marketplace Orders; your existing
          infrastructure stays in place.
        </li>
      </ul>
    </div>
  </section>

  <section class="section-tight">
    <div class="container narrow">
      <p class="eyebrow">Troubleshooting</p>
      <div class="table-wrap">
        <table class="data-table">
          <thead>
            <tr>
              <th>Issue</th>
              <th>Solution</th>
            </tr>
          </thead>
          <tbody>
            {troubleshooting.map((item) => (
              <tr>
                <td>{item.issue}</td>
                <td>{item.solution}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section-tight section-raised">
    <div class="container narrow support-block">
      <p class="eyebrow">Support</p>
      <h2>Need a hand?</h2>
      <p class="lede">
        Email <a href="mailto:support@c9ine.com">support@c9ine.com</a>, reach us through our
        contact page, or use the Support link on the aSaaS listing in Google Cloud Marketplace.
      </p>
      <div class="page-intro__cta">
        <CTAButton href="/contact?intent=asaas">Talk to us about aSaaS</CTAButton>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-intro__cta {
    margin-top: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .container.narrow {
    max-width: 46rem;
  }

  h2 {
    margin-top: 0.75rem;
  }

  .check-list {
    margin-top: 1.5rem;
    display: grid;
    gap: 0.75rem;
  }

  .check-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.85rem 1rem;
    border: 1px solid var(--gunmetal-line);
    border-radius: var(--border-radius);
    color: var(--silver);
    line-height: 1.5;
    max-width: none;
  }

  /* Flexbox row + a margin-top on the dot sized to the fixed
     line-height above, instead of an absolutely-positioned dot with a
     hand-guessed top offset that only matched one specific line-height
     — stays aligned to the first line regardless of how the text wraps. */
  .check-list li::before {
    content: '';
    flex: none;
    width: 6px;
    height: 6px;
    margin-top: 0.6rem;
    background: var(--aquamarine);
  }

  .icon-list {
    margin-top: 1.5rem;
    display: grid;
    gap: 0.85rem;
  }

  .icon-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    color: var(--silver);
    line-height: 1.5;
  }

  .icon-list__icon {
    flex: none;
    width: 1.15rem;
    height: 1.15rem;
    margin-top: 0.19rem;
    fill: none;
    stroke: var(--aquamarine);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .table-wrap {
    margin-top: 2rem;
    overflow-x: auto;
    border: 1px solid var(--gunmetal-line);
    border-radius: var(--border-radius);
  }

  .data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--step--1);
  }

  .data-table th,
  .data-table td {
    padding: 0.85rem 1.1rem;
    text-align: left;
    vertical-align: top;
    max-width: none;
  }

  .data-table thead th {
    background: var(--gunmetal-raised);
    color: var(--aquamarine);
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .data-table tbody tr {
    border-top: 1px solid var(--gunmetal-line);
  }

  .data-table tbody td {
    color: var(--silver);
  }

  .data-table tbody td strong {
    color: var(--white-smoke);
  }

  .substep {
    margin-top: 2rem;
    padding-left: 1.15rem;
    border-left: 2px solid var(--gunmetal-line);
  }

  .substep .eyebrow + p {
    margin-top: 0.4rem;
    color: var(--silver);
  }

  .foundation-note {
    margin-top: 1.5rem;
    color: var(--silver);
    max-width: 60ch;
  }

  .review-loop {
    margin-top: 2rem;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(1.25rem, 3vw, 1.75rem);
  }

  .review-loop li {
    padding-top: 1.1rem;
    border-top: 2px solid var(--aquamarine);
  }

  .review-loop__num {
    display: block;
    color: var(--aquamarine);
  }

  .review-loop h4 {
    margin-top: 0.5rem;
    font-size: var(--step-0);
    color: var(--white-smoke);
  }

  .review-loop p {
    margin-top: 0.4rem;
    color: var(--silver);
    font-size: var(--step--1);
    line-height: 1.4;
  }

  .support-block .lede {
    margin-top: 1rem;
  }

  .support-block a {
    color: var(--aquamarine);
  }

  @media (max-width: 700px) {
    .review-loop {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
