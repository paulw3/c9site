---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import StageSequence from '../components/StageSequence.astro';
import ProofPoint from '../components/ProofPoint.astro';
import CTAButton from '../components/CTAButton.astro';
---

<BaseLayout
  title="Google Distributed Cloud"
  description="C-9INE helps banks, government institutions and critical-infrastructure organisations turn Google Distributed Cloud into a secure, production-ready operating platform."
>
  <!--
    This hero wording was reworked from the line Ali signed off to ship identical
    across LinkedIn, proposals, sales decks and the site (the dash was removed).
    Confirm with Ali whether that divergence is fine, or update the other channels
    to match — see docs/content-brief.md §4 (Google Distributed Cloud) for the full note.
  -->
  <PageIntro eyebrow="Google Distributed Cloud">
    <h1>Control isn't a feature. It's the whole point.</h1>
    <p class="gdc-subhead">Sovereign cloud is not a location. It is an operating model.</p>
    <p class="lede">
      We design, build and run Google Distributed Cloud so your team ends up owning it, not
      renting our expertise forever. Banks, government and critical-infrastructure institutions
      across Saudi Arabia work with us because when we're done, we're not required.
    </p>
    <div class="page-intro__cta">
      <CTAButton href="/contact?intent=gdc-pilot">Book a GDC pilot scoping call</CTAButton>
    </div>
  </PageIntro>

  <section class="section-tight section-raised">
    <div class="container">
      <div class="belief">
        <h2>Most vendors want you dependent. We don't.</h2>
        <p class="lede">
          Software-only or the air-gapped appliance. Containers or VMs. Connected or fully
          isolated. Every choice on this page exists so the decision stays yours, not ours.
          That's not a compliance requirement. It's how we think a vendor should behave.
        </p>
      </div>
    </div>
  </section>

  <section class="section-tight section-raised">
    <div class="container">
      <div class="outcomes">
        <h2>From infrastructure estate to cloud operating model</h2>
        <p class="lede">
          The goal isn't another technology island to maintain. The goal is a simpler, governed
          way to run what you have today while you modernise what comes next.
        </p>

        <ol class="outcomes__list">
          <li data-reveal>
            <span class="outcomes__num mono-tag">01</span>
            <div>
              <h4>Reduce licensing pressure</h4>
              <p>Fewer duplicated platform layers to renew, bundle and justify at budget time.</p>
            </div>
          </li>
          <li data-reveal style="transition-delay:80ms">
            <span class="outcomes__num mono-tag">02</span>
            <div>
              <h4>Lower operational overhead</h4>
              <p>One operating model for VMs and containers, instead of a separate one for each.</p>
            </div>
          </li>
          <li data-reveal style="transition-delay:160ms">
            <span class="outcomes__num mono-tag">03</span>
            <div>
              <h4>Improve skills leverage</h4>
              <p>Common patterns across teams, so specialists aren't spread across five stacks.</p>
            </div>
          </li>
          <li data-reveal style="transition-delay:240ms">
            <span class="outcomes__num mono-tag">04</span>
            <div>
              <h4>Strengthen control</h4>
              <p>Policy, security and visibility built into the platform, not bolted on after.</p>
            </div>
          </li>
          <li data-reveal style="transition-delay:320ms">
            <span class="outcomes__num mono-tag">05</span>
            <div>
              <h4>Modernise safely</h4>
              <p>Run today's workloads with confidence while you build tomorrow's applications.</p>
            </div>
          </li>
        </ol>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <div class="gdc-explainer">
        <h2>One platform for legacy workloads and modern applications</h2>
        <p class="lede">
          Your data centre keeps running on hardware you already own. What changes is the
          operating model on top of it — the same one Google Cloud runs itself, giving every
          team one place to build, deploy, monitor and govern instead of five.
        </p>

        <div class="gdc-explainer__diagram">
          <div class="gdc-layer gdc-layer--outer" data-reveal>
            <span class="gdc-layer__label mono-tag">Your data centre</span>
            <p class="gdc-layer__desc">Supported x86 servers · your network, storage and security</p>
            <div class="gdc-layer gdc-layer--mid" data-reveal style="transition-delay:150ms">
              <span class="gdc-layer__label mono-tag">One cloud operating model, running on your hardware</span>
              <div class="gdc-icon-row">
                <div class="gdc-icon-item">
                  <svg class="gdc-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M4,12 A8,8 0 0 1 18.5,7" />
                    <path d="M18.5,7 L19.5,3.5 M18.5,7 L15,6.3" />
                    <path d="M20,12 A8,8 0 0 1 5.5,17" />
                    <path d="M5.5,17 L4.5,20.5 M5.5,17 L9,17.7" />
                  </svg>
                  <span>Consistent policy</span>
                </div>
                <div class="gdc-icon-item">
                  <svg class="gdc-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M12,3 L20,6 L20,12 C20,17 16.5,20.5 12,22 C7.5,20.5 4,17 4,12 L4,6 Z" />
                    <path d="M8.5,12 L11,14.5 L16,9" />
                  </svg>
                  <span>Governed access</span>
                </div>
                <div class="gdc-icon-item">
                  <svg class="gdc-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <circle cx="5" cy="6" r="2.2" />
                    <circle cx="19" cy="6" r="2.2" />
                    <circle cx="12" cy="13" r="2.2" />
                    <circle cx="5" cy="20" r="2.2" />
                    <circle cx="19" cy="20" r="2.2" />
                    <path d="M6.7,7.3 L10.4,11.5 M17.3,7.3 L13.6,11.5 M10.4,14.5 L6.7,18.7 M13.6,14.5 L17.3,18.7" />
                  </svg>
                  <span>Unified networking</span>
                </div>
                <div class="gdc-icon-item">
                  <svg class="gdc-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <rect x="3" y="4" width="7" height="7" rx="1.2" />
                    <rect x="14" y="4" width="7" height="7" rx="1.2" />
                    <rect x="3" y="15" width="7" height="7" rx="1.2" />
                    <rect x="14" y="15" width="7" height="7" rx="1.2" />
                  </svg>
                  <span>Fleet-wide visibility</span>
                </div>
              </div>
              <div class="gdc-layer gdc-layer--inner" data-reveal style="transition-delay:300ms">
                <span class="gdc-layer__label mono-tag">Workloads</span>
                <div class="gdc-icon-row gdc-icon-row--workloads">
                  <div class="gdc-icon-item">
                    <svg class="gdc-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                      <rect x="4" y="4" width="12" height="12" rx="2" />
                      <rect x="8" y="8" width="12" height="12" rx="2" />
                    </svg>
                    <span>Containers</span>
                  </div>
                  <div class="gdc-icon-item">
                    <svg class="gdc-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                      <rect x="3" y="4" width="18" height="12" rx="1.5" />
                      <path d="M12,16 L12,20" />
                      <path d="M9,20 L15,20" />
                    </svg>
                    <span>VM Runtime</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <p class="gdc-explainer__note">
          You keep control of the hardware and the data centre. Google Cloud's operating model
          runs on top of it.
        </p>
      </div>
    </div>
  </section>

  <section class="section-tight section-raised">
    <div class="container two-col">
      <div>
        <h2>The gap</h2>
        <p class="lede">
          Installing Google Distributed Cloud is not the hard part. Governing it, operating it,
          recovering it, and evolving it is. That's the gap between a platform being installed
          and an organisation being ready to govern, operate, recover and evolve it. It's the gap
          C-9INE occupies.
        </p>
      </div>
      <div>
        <h2>Why now</h2>
        <p class="lede">
          Broadcom's acquisition of VMware changed the calculus on every renewal. Most FSI
          estates we see are re-evaluating VMware, Nutanix, Hyper-V and Kubernetes side by side
          right now, not on some future roadmap. Your next hypervisor renewal doesn't have to
          mean renewing the same complexity — it can be the moment you standardise on one
          platform, one policy model, one fleet view, without forcing every workload to
          modernise on day one.
        </p>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <div class="verticals">
        <h2>If your workload is critical, local or regulated</h2>
        <p class="lede">
          Not theoretical. These are the institutions we build GDC for, in Saudi Arabia today.
        </p>

        <div class="verticals__grid">
          <div class="verticals__card">
            <h4>Banking &amp; finance</h4>
            <p>
              Sovereign core-adjacent platforms, fraud and AI workloads kept local, VM
              consolidation off ageing hypervisors.
            </p>
          </div>
          <div class="verticals__card">
            <h4>Government</h4>
            <p>
              Citizen services, national data custody, one secure platform standard instead of
              several.
            </p>
          </div>
          <div class="verticals__card">
            <h4>Healthcare</h4>
            <p>
              Patient records and private analytics that never have to leave the building,
              resilient local services.
            </p>
          </div>
          <div class="verticals__card">
            <h4>Critical infrastructure</h4>
            <p>
              Site autonomy, low latency, operational continuity even when connectivity isn't
              guaranteed.
            </p>
          </div>
        </div>

        <p class="verticals__close">
          If the workload is critical, local, regulated or latency-sensitive, it belongs in this
          conversation.
        </p>
      </div>
    </div>
  </section>

  <section class="section-tight section-raised">
    <div class="container">
      <div class="modes">
        <h2>Two delivery models. Your regulator chooses.</h2>
        <p class="lede">
          Both are genuine GDC, not a workaround. C-9INE delivers both, so the choice is driven
          by what your regulator requires.
        </p>

        <div class="modes__grid">
          <div class="modes__card">
            <svg class="modes__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M4,10 L4,20 L20,20 L20,10" />
              <path d="M2,10 L12,3 L22,10 Z" />
              <path d="M9,20 L9,14 L15,14 L15,20" />
            </svg>
            <h4>GDC software-only</h4>
            <p class="mono-tag modes__tag">Connected</p>
            <ul>
              <li>Runs on your own supported x86 servers, in your data centre</li>
              <li>A lightweight connect agent registers clusters to your fleet in Google Cloud</li>
              <li>Fastest path to production; reuses your existing hardware investment</li>
            </ul>
          </div>
          <div class="modes__card">
            <svg class="modes__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M12,3 L20,6 L20,12 C20,17 16.5,20.5 12,22 C7.5,20.5 4,17 4,12 L4,6 Z" />
              <rect x="9" y="11" width="6" height="5" rx="1" />
              <path d="M10.2,11 L10.2,9.2 A1.8,1.8 0 0 1 13.8,9.2 L13.8,11" />
            </svg>
            <h4>GDC air-gapped</h4>
            <p class="mono-tag modes__tag">Fully isolated</p>
            <ul>
              <li>Integrated Google hardware, delivered and installed at your premises</li>
              <li>No connection to Google Cloud or the public internet, by design, ever</li>
              <li>Built for classified and the most stringent sovereignty requirements</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-tight stage-section">
    <div class="container">
      <StageSequence stages={['Design', 'Engineer', 'Run']} eyebrow="How we work">
        <article class="stage-panel">
          <span class="stage-number">01</span>
          <h3>Design: Readiness</h3>
          <p>
            We assess the estate, map it against your regulatory requirements, and define the
            target operating model before any hardware is touched.
          </p>
        </article>

        <article class="stage-panel">
          <span class="stage-number">02</span>
          <h3>Engineer: Deployment and workload transformation</h3>
          <p>
            Software-only on your own supported servers, or the fully managed air-gapped
            appliance on Google-supplied hardware — whichever your regulator requires.
            Containers and VM workloads move in together, in governed waves, as real regulated
            workloads cut over onto the platform.
          </p>
        </article>

        <article class="stage-panel">
          <span class="stage-number">03</span>
          <h3>Run: Resilience, day-two operations, capability transfer</h3>
          <p>
            Recovery, continuity and failure testing designed in, not tested for the first time
            in production. Genuine day-two operations: running the platform, not just standing it
            up. And capability transfer: your team can operate it without us. That's the most
            commercially counter-intuitive thing we say, and the most credible.
          </p>
        </article>
      </StageSequence>
    </div>
  </section>

  <section class="section-tight section-raised">
    <div class="container">
      <div class="vm-runtime">
        <h2>Not a containers-only platform</h2>
        <p class="lede">
          No forced timeline. Applications that aren't ready to move stay exactly as they are —
          that's your call, not a deadline we impose. VM Runtime, part of GDC software-only,
          runs traditional VMs directly on the same Kubernetes-based platform as your
          containers, without forcing every legacy application through containerisation first.
        </p>

        <div class="vm-runtime__diagram" aria-hidden="true">
          <div class="vm-runtime__platform">
            <div class="vm-runtime__boxes">
              <div class="vm-runtime__col">
                <div class="vm-runtime__box" data-reveal>
                  <svg viewBox="0 0 24 24" class="vm-runtime__icon" focusable="false">
                    <rect x="4" y="4" width="12" height="12" rx="2" />
                    <rect x="8" y="8" width="12" height="12" rx="2" />
                  </svg>
                  <span>Containers</span>
                </div>
                <div class="vm-runtime__connector" data-reveal style="transition-delay:200ms"></div>
              </div>
              <div class="vm-runtime__col">
                <div class="vm-runtime__box" data-reveal style="transition-delay:80ms">
                  <svg viewBox="0 0 24 24" class="vm-runtime__icon" focusable="false">
                    <rect x="3" y="4" width="18" height="12" rx="1.5" />
                    <path d="M12,16 L12,20" />
                    <path d="M9,20 L15,20" />
                  </svg>
                  <span>VMs</span>
                </div>
                <div class="vm-runtime__connector" data-reveal style="transition-delay:280ms"></div>
              </div>
            </div>
            <div class="vm-runtime__base" data-reveal style="transition-delay:360ms">GDC / Kubernetes</div>
            <div class="vm-runtime__services" data-reveal style="transition-delay:440ms">
              <div class="vm-runtime__service">
                <svg class="vm-runtime__service-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <circle cx="12" cy="5" r="2" />
                  <circle cx="5" cy="18" r="2" />
                  <circle cx="19" cy="18" r="2" />
                  <path d="M12,7 L6.5,16.3" />
                  <path d="M12,7 L17.5,16.3" />
                </svg>
                <span>Networking</span>
              </div>
              <div class="vm-runtime__service">
                <svg class="vm-runtime__service-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <ellipse cx="12" cy="5" rx="7" ry="2.5" />
                  <path d="M5,5 L5,19 C5,20.4 8.1,21.5 12,21.5 C15.9,21.5 19,20.4 19,19 L19,5" />
                  <path d="M5,12 C5,13.4 8.1,14.5 12,14.5 C15.9,14.5 19,13.4 19,12" />
                </svg>
                <span>Storage</span>
              </div>
              <div class="vm-runtime__service">
                <svg class="vm-runtime__service-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path d="M2,12 C5,6 19,6 22,12 C19,18 5,18 2,12 Z" />
                  <circle cx="12" cy="12" r="2.5" />
                </svg>
                <span>Observability</span>
              </div>
            </div>
          </div>
        </div>

        <p class="vm-runtime__stat mono-tag">
          Live today, running real regulated workloads at a Saudi bank. Not a lab environment,
          not a roadmap item.
        </p>

        <div class="vm-runtime__lists">
          <div>
            <h4>What changes for your team</h4>
            <ul class="feature-list">
              <li>
                <svg class="feature-list__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <circle cx="12" cy="12" r="9" />
                  <path d="M12,7 L12,12 L16,14" />
                </svg>
                <div>
                  <p class="feature-list__label">No forced timeline</p>
                  <p class="feature-list__desc">Applications that aren't ready to move stay exactly as they are</p>
                </div>
              </li>
              <li>
                <svg class="feature-list__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path d="M2,12 C5,6 19,6 22,12 C19,18 5,18 2,12 Z" />
                  <circle cx="12" cy="12" r="2.5" />
                </svg>
                <div>
                  <p class="feature-list__label">One governance model</p>
                  <p class="feature-list__desc">The same policy and observability apply to VMs and containers alike</p>
                </div>
              </li>
              <li>
                <svg class="feature-list__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <circle cx="7" cy="7" r="3" />
                  <circle cx="17" cy="7" r="3" />
                  <path d="M7,10 C7,15 12,15 12,15 C12,15 17,15 17,10" />
                  <circle cx="12" cy="18" r="3" />
                </svg>
                <div>
                  <p class="feature-list__label">One skillset, not two</p>
                  <p class="feature-list__desc">Your team manages VMs the way it already manages containers</p>
                </div>
              </li>
            </ul>
          </div>
          <div>
            <h4>What it means for the business</h4>
            <ul class="feature-list">
              <li>
                <svg class="feature-list__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path d="M5,19 L19,5" />
                  <path d="M11,5 L19,5 L19,13" />
                </svg>
                <div>
                  <p class="feature-list__label">A real migration path</p>
                  <p class="feature-list__desc">Off legacy hypervisors, at the pace your workloads are actually ready for</p>
                </div>
              </li>
              <li>
                <svg class="feature-list__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <rect x="3" y="4" width="18" height="16" rx="2" />
                  <path d="M7,10 L10,13 L7,16" />
                  <path d="M12,16 L16,16" />
                </svg>
                <div>
                  <p class="feature-list__label">Lower operational overhead</p>
                  <p class="feature-list__desc">Fewer platforms to license, patch and produce compliance evidence for</p>
                </div>
              </li>
              <li>
                <svg class="feature-list__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path d="M12,3 L20,6 L20,12 C20,17 16.5,20.5 12,22 C7.5,20.5 4,17 4,12 L4,6 Z" />
                  <path d="M8.5,12 L11,14.5 L16,9" />
                </svg>
                <div>
                  <p class="feature-list__label">Modernise safely</p>
                  <p class="feature-list__desc">Run today's workloads with confidence while you build tomorrow's</p>
                </div>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-tight section-raised">
    <div class="container">
      <div class="vm-runtime">
        <h2>Sovereign AI, not just sovereign infrastructure</h2>
        <p class="lede">
          Frontier AI without handing over where your data goes. Gemini runs natively on GDC,
          including fully air-gapped, so model inference never has to leave your building
          either.
        </p>

        <div class="vm-runtime__diagram" aria-hidden="true">
          <div class="vm-runtime__platform">
            <div class="vm-runtime__boxes">
              <div class="vm-runtime__col">
                <div class="vm-runtime__box" data-reveal>
                  <svg viewBox="0 0 24 24" class="vm-runtime__icon" focusable="false">
                    <path d="M12,2 L14,10 L22,12 L14,14 L12,22 L10,14 L2,12 L10,10 Z" />
                  </svg>
                  <span>Gemini</span>
                </div>
                <div class="vm-runtime__connector" data-reveal style="transition-delay:200ms"></div>
              </div>
              <div class="vm-runtime__col">
                <div class="vm-runtime__box" data-reveal style="transition-delay:80ms">
                  <svg viewBox="0 0 24 24" class="vm-runtime__icon" focusable="false">
                    <circle cx="6" cy="6" r="2.2" />
                    <circle cx="18" cy="6" r="2.2" />
                    <circle cx="12" cy="18" r="2.2" />
                    <path d="M7.7,7.2 L10.7,16.2 M16.3,7.2 L13.3,16.2 M8,6 L16,6" />
                  </svg>
                  <span>Your models</span>
                </div>
                <div class="vm-runtime__connector" data-reveal style="transition-delay:280ms"></div>
              </div>
            </div>
            <div class="vm-runtime__base" data-reveal style="transition-delay:360ms">AI Gateway</div>
            <div class="vm-runtime__services" data-reveal style="transition-delay:440ms">
              <div class="vm-runtime__service">
                <svg class="vm-runtime__service-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <rect x="6" y="6" width="12" height="12" rx="1.5" />
                  <rect x="10" y="10" width="4" height="4" />
                  <path d="M9,2 L9,6 M15,2 L15,6 M9,18 L9,22 M15,18 L15,22 M2,9 L6,9 M2,15 L6,15 M18,9 L22,9 M18,15 L22,15" />
                </svg>
                <span>GPU acceleration</span>
              </div>
              <div class="vm-runtime__service">
                <svg class="vm-runtime__service-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path d="M4,17 A8,8 0 0 1 20,17" />
                  <path d="M12,17 L16,10" />
                  <circle cx="12" cy="17" r="1.3" />
                </svg>
                <span>Quota management</span>
              </div>
              <div class="vm-runtime__service">
                <svg class="vm-runtime__service-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path d="M6,3 L15,3 L19,7 L19,21 L6,21 Z" />
                  <path d="M15,3 L15,7 L19,7" />
                  <path d="M9,12 L16,12 M9,15.5 L16,15.5 M9,9 L12,9" />
                </svg>
                <span>Compliance logging</span>
              </div>
            </div>
          </div>
        </div>

        <p class="vm-runtime__stat mono-tag">
          Deployed today, on GDC connected and fully air-gapped alike — not a future roadmap
          promise.
        </p>

        <div class="vm-runtime__lists">
          <div>
            <h4>What changes for your team</h4>
            <ul class="feature-list">
              <li>
                <svg class="feature-list__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path d="M12,2 L14,10 L22,12 L14,14 L12,22 L10,14 L2,12 L10,10 Z" />
                </svg>
                <div>
                  <p class="feature-list__label">Frontier AI inside your perimeter</p>
                  <p class="feature-list__desc">Gemini runs where your data already lives, not as a cloud API call leaving the building</p>
