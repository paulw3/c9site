---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import ProofPoint from '../components/ProofPoint.astro';
import CTAButton from '../components/CTAButton.astro';
---

<BaseLayout
  title="Google Distributed Cloud"
  description="C-9INE helps banks, government institutions and critical-infrastructure organisations turn Google Distributed Cloud into a secure, production-ready operating platform."
>
  <!--
    This page follows the C-9INE GDC Executive Booklet (v1.0) page for
    page, in order: Problem, Belief, How It Works, What We Standardise,
    Customer Outcomes. Proof is the one section added beyond the
    booklet itself. Each section has its own layout rather than
    repeating one narrow centred-column template five times — an
    editorial list, a wide statement, a horizontal timeline, a
    seamless icon grid, a stat grid — so the page reads as a designed
    whole rather than a stamped-out sequence.
  -->
  <PageIntro eyebrow="Google Distributed Cloud">
    <h1>One platform. Less chaos.</h1>
    <p class="gdc-subhead">Run VMs and containers on your infrastructure with a cloud operating model.</p>
    <p class="lede">
      Your infrastructure. Cloud operating model. Sovereign control. C-9INE helps banks,
      government and critical-infrastructure organisations turn Google Distributed Cloud into a
      secure, production-ready operating platform — covering everything from readiness to
      capability transfer.
    </p>
    <div class="page-intro__cta">
      <CTAButton href="/contact?intent=gdc-pilot">Book a GDC pilot scoping call</CTAButton>
    </div>
  </PageIntro>

  <!-- 01 · The Problem — text column + editorial list, left-aligned -->
  <section class="section-tight section-raised">
    <div class="container">
      <div class="problem-layout">
        <div class="problem-layout__intro">
          <p class="eyebrow">The Problem</p>
          <h2>Your data centre was not meant to become this complicated.</h2>
          <p class="lede">
            VMware, Nutanix, Hyper-V, Kubernetes and cloud projects often grow into separate
            platforms, each with its own skills and operating model.
          </p>
          <p class="pull-statement">
            More platforms did not create simplicity. They created another operating problem.
          </p>
        </div>

        <ol class="editorial-list">
          <li>
            <span class="editorial-list__num">01</span>
            <div>
              <h4>Licensing pressure</h4>
              <p>Renewals, bundles and platform overlap make budgeting harder.</p>
            </div>
          </li>
          <li>
            <span class="editorial-list__num">02</span>
            <div>
              <h4>Platform sprawl</h4>
              <p>Different stacks create different tools, teams and runbooks.</p>
            </div>
          </li>
          <li>
            <span class="editorial-list__num">03</span>
            <div>
              <h4>Skills fragmentation</h4>
              <p>Specialists are spread across too many operating models.</p>
            </div>
          </li>
          <li>
            <span class="editorial-list__num">04</span>
            <div>
              <h4>Operational overhead</h4>
              <p>Security, compliance and lifecycle controls are repeated in each stack.</p>
            </div>
          </li>
        </ol>
      </div>
    </div>
  </section>

  <!-- 02 · The Solution — wide, centred, statement-led -->
  <section class="section-tight">
    <div class="container">
      <div class="belief-layout">
        <p class="eyebrow">The Solution</p>
        <h2 class="belief-layout__heading">
          Modernisation should reduce complexity, not move it somewhere else.
        </h2>
        <p class="lede">
          Google Distributed Cloud brings a cloud operating model to infrastructure you
          control, so VMs and containers can move in one strategic direction.
        </p>

        <div class="plus-row">
          <span class="plus-row__item">VMs</span>
          <span class="plus-row__sign">+</span>
          <span class="plus-row__item">Containers</span>
          <span class="plus-row__sign">+</span>
          <span class="plus-row__item">Policy</span>
          <span class="plus-row__sign">+</span>
          <span class="plus-row__item">Operations</span>
        </div>

        <p class="belief-layout__statement">
          One platform for legacy workloads and modern applications.
        </p>

        <p class="lede belief-layout__closing">
          The platform experience matters because customers need a controlled path from
          today's estate to tomorrow's cloud model.
        </p>
      </div>
    </div>
  </section>

  <!-- 03 · How It Works — horizontal timeline spanning the full width -->
  <section class="section-tight section-raised">
    <div class="container">
      <div class="works-intro">
        <p class="eyebrow">How It Works</p>
        <h2>From fragmented estates to a single operating model.</h2>
        <p class="lede">
          A practical path that translates today's infrastructure into repeatable GDC
          architecture, governance and operations.
        </p>
      </div>

      <div class="works-timeline">
        <div class="works-timeline__line" aria-hidden="true"></div>
        <ol class="works-timeline__steps">
          <li>
            <span class="works-timeline__node">01</span>
            <h4>Assess</h4>
            <p>Inventory platforms, renewal timing, dependencies and workload fit.</p>
          </li>
          <li>
            <span class="works-timeline__node">02</span>
            <h4>Consolidate</h4>
            <p>Converge VMs and containers closer to one platform direction.</p>
          </li>
          <li>
            <span class="works-timeline__node">03</span>
            <h4>Govern</h4>
            <p>Apply consistent policy, security, IAM and lifecycle controls.</p>
          </li>
          <li>
            <span class="works-timeline__node">04</span>
            <h4>Operate</h4>
            <p>Standardise observability, automation and handover practices.</p>
          </li>
        </ol>
      </div>

      <p class="pull-statement works-timeline__statement">
        Assess the estate. Consolidate the platform. Govern consistently. Operate with
        confidence.
      </p>
    </div>
  </section>

  <!-- 04 · What We Standardise — seamless icon grid, full width -->
  <section class="section-tight">
    <div class="container">
      <div class="standardise-intro">
        <p class="eyebrow">What We Standardise</p>
        <h2>The foundations every GDC programme depends on.</h2>
        <p class="lede">
          C-9INE helps industrialise the patterns that are too important to rebuild manually,
          platform by platform.
        </p>
      </div>

      <ul class="foundations-grid">
        <li>
          <span class="foundations-grid__icon">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <rect x="3" y="4" width="18" height="12" rx="1.5" />
              <path d="M12,16 L12,20" />
              <path d="M9,20 L15,20" />
            </svg>
          </span>
          <h4>VM runtime</h4>
          <p>Run existing virtual machines under a cloud operating model</p>
        </li>
        <li>
          <span class="foundations-grid__icon">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <rect x="4" y="4" width="12" height="12" rx="2" />
              <rect x="8" y="8" width="12" height="12" rx="2" />
            </svg>
          </span>
          <h4>Kubernetes</h4>
          <p>Standardise container platform operations</p>
        </li>
        <li>
          <span class="foundations-grid__icon">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <circle cx="12" cy="5" r="2" />
              <circle cx="5" cy="18" r="2" />
              <circle cx="19" cy="18" r="2" />
              <path d="M12,7 L6.5,16.3" />
              <path d="M12,7 L17.5,16.3" />
            </svg>
          </span>
          <h4>Networking</h4>
          <p>Repeatable connectivity and segmentation patterns</p>
        </li>
        <li>
          <span class="foundations-grid__icon">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M12,3 L20,6 L20,12 C20,17 16.5,20.5 12,22 C7.5,20.5 4,17 4,12 L4,6 Z" />
              <path d="M8.5,12 L11,14.5 L16,9" />
            </svg>
          </span>
          <h4>IAM &amp; access</h4>
          <p>Clear roles, permissions and boundaries</p>
        </li>
        <li>
          <span class="foundations-grid__icon">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M2,12 C5,6 19,6 22,12 C19,18 5,18 2,12 Z" />
              <circle cx="12" cy="12" r="2.5" />
            </svg>
          </span>
          <h4>Observability</h4>
          <p>Logging, monitoring and operational visibility</p>
        </li>
        <li>
          <span class="foundations-grid__icon">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M6,3 L15,3 L19,7 L19,21 L6,21 Z" />
              <path d="M15,3 L15,7 L19,7" />
              <path d="M9,12 L16,12 M9,15.5 L16,15.5 M9,9 L12,9" />
            </svg>
          </span>
          <h4>Security &amp; compliance</h4>
          <p>Consistent guardrails and control evidence</p>
        </li>
      </ul>

      <p class="pull-statement foundations-grid__statement">
        Standardisation is what turns infrastructure into a platform.
      </p>
    </div>
  </section>

  <!-- 05 · Customer Outcomes — stat grid, full width -->
  <section class="section-tight section-raised">
    <div class="container">
      <div class="outcomes-intro">
        <p class="eyebrow">Customer Outcomes</p>
        <h2>From infrastructure estate to cloud operating model.</h2>
        <p class="lede">
          The goal is not another technology island. The goal is a simpler, governed way to
          run today's workloads while modernising.
        </p>
      </div>

      <ol class="stat-grid">
        <li>
          <span class="stat-grid__num">01</span>
          <h4>Reduce licensing pressure</h4>
          <p>Fewer duplicated platform layers.</p>
        </li>
        <li>
          <span class="stat-grid__num">02</span>
          <h4>Lower operational overhead</h4>
          <p>One model for VMs and containers.</p>
        </li>
        <li>
          <span class="stat-grid__num">03</span>
          <h4>Improve skills leverage</h4>
          <p>Common patterns across teams.</p>
        </li>
        <li>
          <span class="stat-grid__num">04</span>
          <h4>Strengthen control</h4>
          <p>Policy, security and visibility built in.</p>
        </li>
        <li>
          <span class="stat-grid__num">05</span>
          <h4>Modernise safely</h4>
          <p>Run today's workloads while building tomorrow's apps.</p>
        </li>
      </ol>

      <p class="outcomes-close">One platform. Less chaos.</p>
    </div>
  </section>

  <!-- Proof — the one section beyond the booklet -->
  <section class="section-tight">
    <div class="container">
      <div class="proof">
        <ProofPoint eyebrow="Proof">
          Live Saudi GDC delivery, not theoretical: a national regulator, a tier-one commercial
          bank, and a large-scale production rollout.
        </ProofPoint>
        <p class="lede proof__context">
          Delivered in the region's strictest regulatory environment, alongside Google Cloud's
          own Dammam region (me-central2) and the Class C licence CST granted it there.
        </p>

        <div class="proof__grid">
          <div class="proof__card">
            <p class="proof__card-tag mono-tag">Regulatory baseline</p>
            <p class="proof__card-desc">
              GDC software-only validated against sovereign data, operational compliance and
              security expectations, for a national financial regulator.
            </p>
          </div>
          <div class="proof__card">
            <p class="proof__card-tag mono-tag">Tier-one commercial bank</p>
            <p class="proof__card-desc">
              Mission-critical legacy applications and microservices coexisting on
              customer-owned infrastructure, in production.
            </p>
          </div>
          <div class="proof__card">
            <p class="proof__card-tag mono-tag">Large-scale production rollout</p>
            <p class="proof__card-desc">
              Anthos-to-GDC migration path and multi-cluster architecture readiness, delivered
              at scale.
            </p>
          </div>
          <div class="proof__card">
            <p class="proof__card-tag mono-tag">VM Runtime, in production</p>
            <p class="proof__card-desc">
              Live at a Saudi bank today — VMs and containers governed under one operating
              model, not a lab environment.
            </p>
          </div>
          <div class="proof__card">
            <p class="proof__card-tag mono-tag">Sovereign AI, natively</p>
            <p class="proof__card-desc">
              Gemini runs inside the platform, including fully air-gapped, so model inference
              never has to leave the building.
            </p>
          </div>
        </div>

        <div class="proof__assets">
          <span class="proof__assets-label mono-tag">Reusable assets</span>
          <div class="proof__tags">
            <span class="proof__tag mono-tag">HLD/LLD baselines</span>
            <span class="proof__tag mono-tag">VM Runtime validation</span>
            <span class="proof__tag mono-tag">Multi-DC bare-metal design</span>
            <span class="proof__tag mono-tag">Migration factory runbooks</span>
            <span class="proof__tag mono-tag">Operational handover model</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Closing CTA — the one bold, high-contrast moment on the page -->
  <section class="cta-band">
    <div class="container cta-band__inner">
      <h2>Ready to turn Google Distributed Cloud into a production-ready platform?</h2>
      <div class="cta-band__action">
        <CTAButton href="/contact?intent=gdc-pilot" variant="outline">Book a GDC pilot scoping call</CTAButton>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .gdc-subhead {
    margin-top: 1rem;
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 500;
    color: var(--white-smoke);
  }

  /* Shared "quoted highlight" line reused by three sections (Problem,
     How It Works, What We Standardise) for the booklet's own closing
     statement on that page — a left rule and larger type, not a
     boxed callout, so it reads as an idea being emphasised rather
     than a repeated card component. */
  .pull-statement {
    padding-left: 1.15rem;
    border-left: 2px solid var(--aquamarine);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-1);
    line-height: 1.35;
    color: var(--white-smoke);
  }

  /* ---- 01 · The Problem --------------------------------------- */

  .problem-layout {
    display: grid;
    grid-template-columns: minmax(0, 21rem) 1fr;
    gap: clamp(2.5rem, 6vw, 5.5rem);
    align-items: start;
  }

  .problem-layout__intro h2 {
    margin-top: 0.75rem;
  }

  .problem-layout__intro .lede {
    margin-top: 1rem;
  }

  .problem-layout__intro .pull-statement {
    margin-top: 2.25rem;
  }

  .editorial-list {
    display: flex;
    flex-direction: column;
  }

  .editorial-list li {
    display: flex;
    gap: clamp(1.25rem, 3vw, 2rem);
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--gunmetal-line);
  }

  .editorial-list li:first-child {
    padding-top: 0;
  }

  .editorial-list li:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .editorial-list__num {
    flex-shrink: 0;
    width: 2.75rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-2);
    line-height: 1.15;
    color: color-mix(in srgb, var(--aquamarine) 55%, var(--gunmetal-line));
  }

  .editorial-list h4 {
    font-size: var(--step-0);
    color: var(--white-smoke);
  }

  .editorial-list p {
    margin-top: 0.4rem;
    color: var(--silver);
    font-size: var(--step--1);
    line-height: 1.5;
  }

  @media (max-width: 850px) {
    .problem-layout {
      grid-template-columns: 1fr;
    }
  }

  /* ---- 02 · The Solution ------------------------------------------ */

  .belief-layout {
    max-width: 46rem;
    margin-inline: auto;
    text-align: center;
  }

  /* The global `p { max-width: 38rem }` reset (see base type rules)
     caps every plain paragraph's own box at 38rem with no auto
     margins, so inside a centered container it was shrinking to that
     width and sitting flush against the left edge — text-align:
     center then centered the words within that mis-positioned box,
     not within the section. Every plain <p> in this centered layout
     (the eyebrow and the statement; .lede already sets this itself)
     needs its own margin-inline: auto to actually center the box. */
  .belief-layout > .eyebrow {
    margin-inline: auto;
  }

  .belief-layout__heading {
    margin-top: 0.85rem;
    font-size: var(--step-4);
  }

  .belief-layout .lede {
    margin-top: 1.25rem;
    margin-inline: auto;
  }

  /* One bordered card holding all four items — the container itself
     is the "one platform" the heading below names, rather than four
     independent pills that only look related because of the + signs
     between them. */
  .plus-row {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    margin-inline: auto;
    max-width: fit-content;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.75rem;
    padding: 1.35rem clamp(1.5rem, 4vw, 2.5rem);
    border: 1px solid color-mix(in srgb, var(--aquamarine) 35%, transparent);
    border-radius: var(--border-radius);
    background: color-mix(in srgb, var(--aquamarine) 5%, transparent);
  }

  .plus-row__item {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-0);
    color: var(--white-smoke);
  }

  .plus-row__sign {
    color: var(--aquamarine);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-1);
  }

  /* Flex-wrap leaves an orphaned "+ Operations" stranded alone on its
     own line once the row can no longer fit all four items — stacking
     vertically instead keeps every pill/sign pairing intact regardless
     of item count. */
  @media (max-width: 640px) {
    .plus-row {
      flex-direction: column;
      gap: 0.5rem;
      max-width: 100%;
      width: 100%;
    }
  }

  .belief-layout__statement {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    margin-inline: auto;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-3);
    line-height: 1.2;
    color: var(--aquamarine);
  }

  .belief-layout__closing {
    margin-top: 1.75rem;
    color: var(--silver);
  }

  /* ---- 03 · How It Works ----------------------------------------- */

  .works-intro {
    max-width: 36rem;
  }

  .works-intro h2 {
    margin-top: 0.75rem;
  }

  .works-intro .lede {
    margin-top: 1rem;
  }

  .works-timeline {
    position: relative;
    margin-top: clamp(3rem, 6vw, 4.5rem);
  }

  .works-timeline__line {
    position: absolute;
    top: 1.1rem;
    left: 1.1rem;
    right: 1.1rem;
    height: 1px;
    background: var(--gunmetal-line);
  }

  .works-timeline__steps {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  .works-timeline__steps li {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .works-timeline__node {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--gunmetal-raised);
    border: 1px solid var(--aquamarine);
    color: var(--aquamarine);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step--1);
  }

  .works-timeline__steps h4 {
    color: var(--white-smoke);
    font-size: var(--step-0);
  }

  .works-timeline__steps p {
    color: var(--silver);
    font-size: var(--step--1);
    line-height: 1.45;
  }

  .works-timeline__statement {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    max-width: 46rem;
  }

  @media (max-width: 800px) {
    .works-timeline__line {
      display: none;
    }

    .works-timeline__steps {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  /* ---- 04 · What We Standardise ----------------------------------- */

  .standardise-intro {
    max-width: 36rem;
  }

  .standardise-intro h2 {
    margin-top: 0.75rem;
  }

  .standardise-intro .lede {
    margin-top: 1rem;
  }

  /* A seamless grid — 1px hairlines via the container's own
     background showing through, rather than six individually
     bordered boxes with gaps between them. */
  .foundations-grid {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    background: var(--gunmetal-line);
    border: 1px solid var(--gunmetal-line);
    border-radius: var(--border-radius);
    overflow: hidden;
  }

  .foundations-grid li {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: clamp(1.5rem, 3vw, 1.85rem);
    background: var(--gunmetal);
  }

  .foundations-grid__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 8px;
    background: color-mix(in srgb, var(--aquamarine) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--aquamarine) 28%, transparent);
  }

  .foundations-grid__icon svg {
    width: 1.35rem;
    height: 1.35rem;
    fill: none;
    stroke: var(--aquamarine);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .foundations-grid h4 {
    font-size: var(--step-0);
    color: var(--white-smoke);
  }

  .foundations-grid p {
    color: var(--silver);
    font-size: var(--step--1);
    line-height: 1.5;
  }

  .foundations-grid__statement {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    max-width: 46rem;
  }

  @media (max-width: 900px) {
    .foundations-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .foundations-grid {
      grid-template-columns: 1fr;
    }
  }

  /* ---- 05 · Customer Outcomes -------------------------------------- */

  .outcomes-intro {
    max-width: 36rem;
    margin-inline: auto;
    text-align: center;
  }

  .outcomes-intro > .eyebrow {
    margin-inline: auto;
  }

  .outcomes-intro h2 {
    margin-top: 0.75rem;
  }

  .outcomes-intro .lede {
    margin-top: 1rem;
    margin-inline: auto;
  }

  .stat-grid {
    margin-top: clamp(3rem, 6vw, 4.5rem);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: clamp(1.75rem, 3vw, 2.5rem);
  }

  .stat-grid li {
    padding-top: 1.35rem;
    border-top: 2px solid color-mix(in srgb, var(--aquamarine) 45%, transparent);
  }

  .stat-grid__num {
    display: block;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-2);
    color: var(--aquamarine);
  }

  .stat-grid h4 {
    margin-top: 0.6rem;
    font-size: var(--step-0);
    color: var(--white-smoke);
    line-height: 1.25;
  }

  .stat-grid p {
    margin-top: 0.5rem;
    color: var(--silver);
