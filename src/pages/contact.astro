---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import ContactForm from '../components/ContactForm.astro';
import CTAButton from '../components/CTAButton.astro';

const params = Astro.url.searchParams;
const defaultIntent = params.get('intent') === 'gdc-pilot' ? 'gdc-pilot' : undefined;
---

<BaseLayout
  title="Contact"
  description="Whether you're planning a migration or starting your Google Distributed Cloud journey, tell us where you are and we'll take it from there."
>
  <PageIntro eyebrow="Contact">
    <h1>Talk to us.</h1>
    <p class="lede">
      Whether you're planning a migration or starting your Google Distributed Cloud journey,
      tell us where you are and we'll take it from there.
    </p>
  </PageIntro>

  <section class="section section-ge4">
    <div class="container contact-grid">
      <ContactForm defaultIntent={defaultIntent} />

      <div class="contact-sidebar">
        <div class="contact-details">
          <h2>Book a call</h2>
          <p class="contact-details__copy">Prefer to talk it through? Grab a slot directly on our calendar.</p>
          <CTAButton
            href="https://calendly.com/azaki-c9ine/30min"
            variant="outline"
            external
            icon={['M4,5 L20,5 L20,20 L4,20 Z', 'M4,9.5 L20,9.5', 'M8,3 L8,7', 'M16,3 L16,7']}
          >
            Schedule a call
          </CTAButton>
        </div>

        <div class="contact-details">
          <h2>Visit us</h2>
          <address>
            Sahaba Tissa (Cloud 9)<br />
            7586 King Fahad Road, Ar Rahmaniyah<br />
            Riyadh 12341, Saudi Arabia
            <!-- TODO: confirm current company registration number (two conflicting numbers on file) and add it here -->
          </address>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 20rem;
    gap: clamp(2.5rem, 6vw, 5rem);
  }

  .contact-details h2 {
    font-size: var(--step-1);
  }

  .contact-sidebar .contact-details + .contact-details {
    margin-top: 2.5rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--gunmetal-line);
  }

  .contact-details__copy {
    margin-top: 1rem;
    color: var(--silver);
    line-height: 1.7;
  }

  .contact-details :global(.btn) {
    margin-top: 1.25rem;
  }

  .contact-details address {
    margin-top: 1rem;
    font-style: normal;
    color: var(--silver);
    line-height: 1.7;
  }

  @media (max-width: 860px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
