---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import LeadershipCard from '../components/LeadershipCard.astro';
import ProofPoint from '../components/ProofPoint.astro';

const leadership = [
  {
    name: 'Ali Aktar',
    role: 'CEO',
    bio: "Twenty-six years in technology: development, engineering, architecture, cloud, agile and DevOps. Ali has built software and platform engineering teams from scratch, holding Head of Engineering and CTO roles across private and public sector organisations worldwide, in telecoms, ISPs, oil and gas, satellite, military and defence, banking and national health services. He's an Agile, cloud and DevOps evangelist, and a long-standing contributor to open-source projects.",
    photo: '/team/ali.jpg',
  },
  {
    name: 'Irfan A Ansari',
    role: 'CTO',
    // Name confirmed; bio and photo still not on file. LeadershipCard shows
    // a "Bio to follow" placeholder and initials until they're supplied.
    bio: undefined,
  },
  {
    name: 'Tahir Alam',
    role: 'COO',
    bio: 'Fifteen years as a project and programme management specialist, including senior Director roles across UK government: the Ministry of Justice, HM Revenue & Customs, and the Cabinet and Prime Minister’s Office. Tahir has led large, multifunctional teams delivering multi-billion-pound programmes, with deep expertise in strategy, transformation, organisational design, governance and stakeholder engagement up to ministerial level. He holds a degree and master’s from UCL, is a certified programme specialist and change management practitioner, and holds a Level 5 CIPD Diploma in HR Management.',
    photo: '/team/tahir.jpg',
  },
  {
    name: 'Paul Wagenaar',
    role: 'CISO',
    bio: 'Two decades in cybersecurity, with a career spanning Australia, the UK, South Africa and the UAE. Paul has held security leadership positions at global banks and major corporations, building security strategy and capability from the ground up in some of the most regulated environments in the world.',
    photo: '/team/paul.png',
  },
];

// Draft role titles aligned to the two pillars — not confirmed against the
// actual team roster, needs a final pass from Ali/Tahir before publishing.
const teamRoles = [
  'Head of Cloud Migration & Landing Zone Engineering',
  'Head of Google Distributed Cloud',
  'Head of Security & Compliance',
  'Head of Data & Platform Engineering',
  'Head of DevOps & Automation (aSaaS)',
];
---

<BaseLayout
  title="About"
  description="C-9INE is a Google Cloud specialist delivering to banks, government institutions and critical-infrastructure organisations across Saudi Arabia and beyond."
>
  <PageIntro eyebrow="About">
    <h1>On your side, in your team.</h1>
    <p class="lede">
      C-9INE is a Google Cloud specialist delivering to banks, government institutions and
      critical-infrastructure organisations across Saudi Arabia and beyond. We design, we
      engineer, and we run, embedding with your team rather than handing over a deck and leaving.
    </p>
    <p class="lede">
      C-9INE's executive leadership and core delivery architects have a unique and directly
      relevant experience set: we've built two full-scale digital banks from the ground up in
      Saudi Arabia.
    </p>
  </PageIntro>

  <section class="section-tight">
    <div class="container press-feature">
      <img
        src="/press/money2020.jpg"
        alt="The C-9INE team with Google Cloud at Money20/20 KSA"
        class="press-feature__image"
        width="1447"
        height="1087"
      />
      <div class="press-feature__body">
        <p class="eyebrow">C-9INE × Google Cloud</p>
        <h2>Engineering sovereign cloud, together.</h2>
        <p class="lede">
          C-9INE with the Google team at Money20/20 KSA. A relationship that's grown
          significantly since 2023, built on deep GDC and Google Cloud engineering rather than a
          standard partner listing.
        </p>
      </div>
    </div>
  </section>

  <section class="section section-raised">
    <div class="container">
      <h2>Leadership</h2>
      <div class="leadership-grid">
        {leadership.map((person) => (
          <LeadershipCard name={person.name} role={person.role} bio={person.bio} photo={person.photo} />
        ))}
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <h2>The team behind the team</h2>
      <p class="lede team-roles__intro">
        C-9INE also includes our top talent team of experts, specially chosen and hand-picked
        for their breadth and depth of skills, knowledge and experience, having worked across
        multiple industry sectors and big brand names.
      </p>
      <!-- Draft titles only — needs Ali/Tahir confirmation against the real roster. -->
      <ul class="team-roles">
        {teamRoles.map((role) => (
          <li class="mono-tag">{role}</li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <ProofPoint eyebrow="Why C-9INE">
        We hand you the keys. Every engagement, migration or GDC, ends with your team fully able
        to operate what we built, without depending on us to keep it running. Code, diagrams,
        evidence and documentation live in your repositories, not ours.
      </ProofPoint>
    </div>
  </section>
</BaseLayout>

<style>
  .press-feature {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 3.5rem);
    align-items: center;
  }

  .press-feature__image {
    width: 100%;
    height: auto;
    border-radius: var(--border-radius);
  }

  .press-feature__body h2 {
    margin-top: 0.75rem;
    font-size: var(--step-3);
  }

  .press-feature__body .lede {
    margin-top: 1rem;
  }

  @media (max-width: 800px) {
    .press-feature {
      grid-template-columns: 1fr;
    }
  }

  .leadership-grid {
    margin-top: 2rem;
    display: flex;
    flex-direction: column;
  }

  .team-roles__intro {
    margin-top: 1rem;
    max-width: 58ch;
  }

  .team-roles {
    margin-top: 2rem;
    display: grid;
    gap: 0.75rem;
  }

  .team-roles li {
    padding: 0.85rem 1rem;
    border: 1px solid var(--gunmetal-line);
    border-radius: var(--border-radius);
    color: var(--silver);
  }
</style>
