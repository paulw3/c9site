---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import LeadershipCard from '../components/LeadershipCard.astro';
import ProofPoint from '../components/ProofPoint.astro';

const leadership = [
  {
    name: 'Ali Aktar',
    role: 'CEO',
    bio: "Twenty-six years in technology: development, engineering, architecture, cloud, agile and DevOps. Ali has built software and platform engineering teams from scratch, holding Head of Engineering and CTO roles across private and public sector organisations worldwide, in telecoms, ISPs, oil and gas, satellite, military and defence, banking and national health services. He's an Agile, cloud and DevOps evangelist, and a long-standing contributor to open-source projects.",
    photo: '/team/ali.jpg',
  },
  {
    name: 'Irfan A Ansari',
    role: 'CTO',
    bio: 'Twenty-five years in technology, starting as a software engineer and moving into cloud, platform engineering and DevSecOps. Irfan spent fifteen years building systems in Java and Scala across online travel, aviation, retail and UK government. He then led cloud platform work in satellite communications, banking and data privacy. He has since led multi-cloud migrations across GCP, AWS, Azure and Oracle Cloud for public sector, banking and fintech clients in Saudi Arabia. He has designed landing zones that meet Saudi Central Bank (SAMA) rules and deployed Google Distributed Cloud in tightly regulated data centres. He is a GenAI Champion in Google Cloud\'s GenAI programme. He is also a certified Google Cloud Professional Cloud Architect and Professional Cloud Security Engineer.',
    photo: '/team/irfan.jpg',
  },
  {
    name: 'Tahir Alam',
    role: 'COO',
    bio: 'Fifteen years as a project and programme management specialist, including senior Director roles across UK government: the Ministry of Justice, HM Revenue & Customs, and the Cabinet and Prime Minister’s Office. Tahir has led large, multifunctional teams delivering multi-billion-pound programmes, with deep expertise in strategy, transformation, organisational design, governance and stakeholder engagement up to ministerial level. He holds a degree and master’s from UCL, is a certified programme specialist and change management practitioner, and holds a Level 5 CIPD Diploma in HR Management.',
    photo: '/team/tahir.jpg',
  },
  {
    name: 'Paul Wagenaar',
    role: 'CISO',
    bio: 'Two decades in cybersecurity, with a career spanning Australia, the UK, South Africa and the UAE. Paul has held security leadership positions at global banks and major corporations, building security strategy and capability from the ground up in some of the most regulated environments in the world.',
    photo: '/team/paul.png',
  },
];

const events = [
  {
    eyebrow: 'Money20/20 · Saudi Arabia',
    heading: 'Engineering sovereign cloud, together.',
    body: "C-9INE with the Google team at Money20/20 KSA. A relationship that's grown significantly since 2023, built on deep GDC and Google Cloud engineering rather than a standard partner listing.",
    image: '/press/money2020.jpg',
    alt: 'The C-9INE team with Google Cloud at Money20/20 KSA',
    imageWidth: 1447,
    imageHeight: 1087,
  },
  {
    eyebrow: 'Google Cloud Summit · Saudi Arabia',
    heading: 'Five GenAI awards, two Partner Champions.',
    body: 'C-9INE won five GenAI awards at the Google Cloud Summit in Saudi Arabia, with CISO Paul Wagenaar and CTO Irfan Ansari individually recognised as Google Cloud Gen AI Partner Champions.',
    image: '/press/google-summit.jpg',
    alt: 'The C-9INE team on stage at Google Cloud Summit Saudi Arabia, recognised as a Gen AI partner',
    imageWidth: 1600,
    imageHeight: 1200,
    gallery: [
      { src: '/press/google-summit-paul.jpg', alt: 'Paul Wagenaar recognised as a Google Cloud Gen AI Partner Champion', caption: 'Paul Wagenaar' },
      { src: '/press/google-summit-irfan.jpg', alt: 'Irfan Ansari recognised as a Google Cloud Gen AI Partner Champion', caption: 'Irfan Ansari' },
    ],
  },
];

// Draft role titles aligned to the two pillars — not confirmed against the
// actual team roster, needs a final pass from Ali/Tahir before publishing.
const teamRoleGroups = [
  {
    label: 'Cloud Migration & Transformation',
    roles: ['Cloud Migration Engineer', 'Landing Zone Architect', 'Site Reliability Engineer'],
  },
  {
    label: 'Google Distributed Cloud',
    roles: ['GDC Solutions Architect', 'Kubernetes & Anthos Engineer', 'Network & Infrastructure Engineer'],
  },
  {
    label: 'Cross-Functional & Products',
    roles: ['Security & Compliance Engineer', 'FinOps Engineer (ANFAA · أنفع)', 'DevOps & Automation Engineer (aSaaS · أساس)'],
  },
];
---

<BaseLayout
  title="About"
  description="C-9INE is a Google Cloud specialist partner delivering to banks, government institutions and critical-infrastructure organisations across Saudi Arabia and beyond."
>
  <PageIntro eyebrow="About">
    <h1>On your side, in your team.</h1>
    <p class="lede">
      C-9INE is a Google Cloud specialist partner delivering to banks, government institutions and
      critical-infrastructure organisations across Saudi Arabia and beyond. We design, we
      engineer, and we run, embedding with your team rather than handing over a deck and leaving.
    </p>
    <p class="lede">
      C-9INE's executive leadership and core delivery architects have a unique and directly
      relevant experience set: we've built two full-scale digital banks from the ground up in
      Saudi Arabia.
    </p>
  </PageIntro>

  <section class="section-tight">
    <div class="container">
      <h2>Events</h2>
      <div class="events-list">
        {events.map((event) => (
          <div class="press-feature">
            <img
              src={event.image}
              alt={event.alt}
              class="press-feature__image"
              width={event.imageWidth}
              height={event.imageHeight}
            />
            <div class="press-feature__body">
              <p class="eyebrow">{event.eyebrow}</p>
              <h3>{event.heading}</h3>
              <p class="lede">{event.body}</p>
            </div>
            {event.gallery && (
              <div class="press-feature__gallery">
                {event.gallery.map((item) => (
                  <figure>
                    <img src={item.src} alt={item.alt} width="400" height="300" />
                    <figcaption>{item.caption}</figcaption>
                  </figure>
                ))}
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-raised">
    <div class="container">
      <h2>Leadership</h2>
      <div class="leadership-grid">
        {leadership.map((person) => (
          <LeadershipCard name={person.name} role={person.role} bio={person.bio} photo={person.photo} />
        ))}
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <h2>The team behind the team</h2>
      <p class="lede team-roles__intro">
        C-9INE also includes our top talent team of experts, specially chosen and hand-picked
        for their breadth and depth of skills, knowledge and experience, having worked across
        multiple industry sectors and big brand names.
      </p>
      <!-- Draft titles only — needs Ali/Tahir confirmation against the real roster. -->
      <div class="team-roles">
        {teamRoleGroups.map((group) => (
          <div class="team-roles__group">
            <p class="eyebrow">{group.label}</p>
            <ul class="team-roles__chips">
              {group.roles.map((role) => (
                <li>{role}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <ProofPoint eyebrow="Why C-9INE">
        We hand you the keys. Every engagement, migration or GDC, ends with your team fully able
        to operate what we built, without depending on us to keep it running. Code, diagrams,
        evidence and documentation live in your repositories, not ours.
      </ProofPoint>
    </div>
  </section>
</BaseLayout>

<style>
  .events-list {
    margin-top: 2rem;
    display: flex;
    flex-direction: column;
    gap: clamp(3rem, 6vw, 4.5rem);
  }

  .press-feature {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 3.5rem);
    align-items: center;
  }

  .press-feature__image {
    width: 100%;
    height: auto;
    border-radius: var(--border-radius);
  }

  .press-feature__body h3 {
    margin-top: 0.75rem;
    font-size: var(--step-3);
  }

  .press-feature__body .lede {
    margin-top: 1rem;
  }

  .press-feature__gallery {
    grid-column: 1 / -1;
    margin-top: 0.5rem;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    max-width: 34rem;
  }

  .press-feature__gallery figure {
    margin: 0;
  }

  .press-feature__gallery img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--border-radius);
  }

  .press-feature__gallery figcaption {
    margin-top: 0.5rem;
    color: var(--silver);
    font-size: var(--step--1);
    text-align: center;
  }

  @media (max-width: 800px) {
    .press-feature {
      grid-template-columns: 1fr;
    }
  }

  .leadership-grid {
    margin-top: 2rem;
    display: flex;
    flex-direction: column;
  }

  .team-roles__intro {
    margin-top: 1rem;
    max-width: 58ch;
  }

  .team-roles {
    margin-top: 2.5rem;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.75rem, 3vw, 2.5rem);
  }

  .team-roles__group {
    padding-top: 1.1rem;
    border-top: 2px solid color-mix(in srgb, var(--aquamarine) 45%, transparent);
  }

  .team-roles__chips {
    margin-top: 1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .team-roles__chips li {
    padding: 0.5rem 0.9rem;
    border: 1px solid color-mix(in srgb, var(--aquamarine) 28%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--aquamarine) 7%, transparent);
    color: var(--white-smoke);
    font-size: var(--step--1);
  }

  @media (max-width: 800px) {
    .team-roles {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
