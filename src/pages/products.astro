---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
---

<BaseLayout
  title="Products"
  description="Product briefs for ANFAA (أنفع) and aSaaS (أساس), C-9INE's multi-cloud FinOps and intelligent cloud operator products."
>
  <PageIntro eyebrow="Products">
    <h1>Two products. Built from real delivery.</h1>
    <p class="lede">
      Product briefs for ANFAA (أنفع) and aSaaS (أساس), our multi-cloud FinOps and intelligent
      cloud operator products.
    </p>
  </PageIntro>

  <section class="section-tight section-raised">
    <div class="container">
      <h2>Our Products</h2>

      <div class="resource-grid">
        <a class="resource-card resource-card--anfaa" href="/products/anfaa">
          <span class="resource-card__mark">ANFAA (أنفع)</span>
          <span class="resource-card__tag">Multi-cloud FinOps</span>
          <p class="resource-card__desc">
            Cloud should create value, not just cost: a continuous FinOps operating discipline
            across every provider you run.
          </p>
          <span class="resource-card__link">Explore ANFAA (أنفع)</span>
        </a>

        <a class="resource-card resource-card--asaas" href="/products/asaas">
          <span class="resource-card__mark">aSaaS (أساس)</span>
          <span class="resource-card__tag">Intelligent Cloud Operator</span>
          <p class="resource-card__desc">
            Cloud foundations shouldn't slow innovation down: approved standards, captured
            once, delivered as a guided, repeatable experience.
          </p>
          <span class="resource-card__link">Explore aSaaS (أساس)</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .resource-grid {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 2rem);
  }

  .resource-card {
    display: flex;
    flex-direction: column;
    padding: clamp(1.5rem, 3vw, 2rem);
    border-top: 2px solid var(--accent, var(--aquamarine));
    background: var(--gunmetal-raised);
    text-decoration: none;
    color: inherit;
    transition: background-color 160ms ease;
  }

  .resource-card:hover {
    background: color-mix(in srgb, var(--gunmetal-raised) 80%, var(--accent, var(--aquamarine)) 8%);
  }

  .resource-card--anfaa {
    --accent: var(--aquamarine);
  }

  .resource-card--asaas {
    --accent: var(--vivid-sky-blue);
  }

  .resource-card__mark {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-2);
    color: var(--white-smoke);
  }

  .resource-card__tag {
    margin-top: 0.25rem;
    display: block;
    color: var(--silver);
    font-size: var(--step--1);
  }

  .resource-card__desc {
    margin-top: 1rem;
    color: var(--silver);
    font-size: var(--step--1);
    line-height: 1.5;
  }

  .resource-card__link {
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--gunmetal-line);
    color: var(--accent, var(--aquamarine));
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step--1);
  }

  @media (max-width: 700px) {
    .resource-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
